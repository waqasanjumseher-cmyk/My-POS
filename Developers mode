function AddClientModal({ onClose, onCreated, prefill }) {
  const [shopName, setShopName] = useState((prefill && prefill.shopName) || "");
  const [phone, setPhone] = useState("");
  const [businessType, setBusinessType] = useState((prefill && prefill.businessType) || "mobile_shop");
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState(() => randomPassword());
  const [tier, setTier] = useState((prefill && prefill.tier) || "free");
  const [duration, setDuration] = useState("30d");
  const [saving, setSaving] = useState(false);
  const [result, setResult] = useState(null);
  const [copiedField, setCopiedField] = useState("");

  useEffect(() => { if (shopName && !username) setUsername(suggestUsername(shopName)); }, [shopName]); // eslint-disable-line
  const normalizedUsername = normalizeShopUsername(username);

  function copyText(field, text) {
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).catch(() => {});
    setCopiedField(field);
    setTimeout(() => setCopiedField(""), 1500);
  }

  async function submit() {
    const name = shopName.trim();
    const user = normalizeShopUsername(username) || normalizeShopUsername(suggestUsername(name));
    if (!name || !user || !password) return;
    setSaving(true);
    let expiresAt = null;
    let licenseKey = "";
    if (tier !== "free") {
      const opt = DURATION_OPTIONS.find(o => o.id === duration) || DURATION_OPTIONS[1];
      expiresAt = opt.days == null ? null : new Date(Date.now() + opt.days * 86400000).toISOString();
      licenseKey = generateLicenseKey(opt.days);
      cloudPushGeneratedKey(licenseKey, opt.days, name + " (issued at client creation)");
    }
    const passwordHash = await sha256Hex(password);
    const bizId = await cloudCreateClient({ bizId: prefill && prefill.bizId, shopName: name, phone, businessType, username: user, passwordHash, tier, expiresAt, licenseKey });
    setSaving(false);
    if (!bizId) { alert("Couldn't create the client — check the connection notice above."); return; }
    setResult({ shopName: name, username: user, password, licenseKey });
  }

  function finish() { onCreated(); onClose(); }

  return (
    <Modal title={prefill ? "Add as Managed Client" : "Add New Client"} onClose={result ? finish : onClose} wide>
      {result ? (
        <div className="bg-emerald-950/40 border border-emerald-800 rounded-lg p-3 text-xs space-y-1.5">
          <div className="text-emerald-300 font-medium mb-1">{result.shopName} was created</div>
          <div className="flex items-center justify-between gap-3"><span className="text-slate-300">Username: <span className="font-mono text-emerald-200">{result.username}</span></span><button onClick={() => copyText("u", result.username)} className="px-2 py-1 rounded bg-emerald-800 hover:bg-emerald-700 text-emerald-100">{copiedField === "u" ? "Copied!" : "Copy"}</button></div>
          <div className="flex items-center justify-between gap-3"><span className="text-slate-300">Password: <span className="font-mono text-emerald-200">{result.password}</span></span><button onClick={() => copyText("p", result.password)} className="px-2 py-1 rounded bg-emerald-800 hover:bg-emerald-700 text-emerald-100">{copiedField === "p" ? "Copied!" : "Copy"}</button></div>
          {result.licenseKey && <div className="flex items-center justify-between gap-3"><span className="text-slate-300">License Key: <span className="font-mono text-emerald-200">{result.licenseKey}</span></span><button onClick={() => copyText("k", result.licenseKey)} className="px-2 py-1 rounded bg-emerald-800 hover:bg-emerald-700 text-emerald-100">{copiedField === "k" ? "Copied!" : "Copy"}</button></div>}
          <div className="text-emerald-500/80 pt-1">Shown once \u2014 only the password's hash is stored. Save these before closing.</div>
          <button onClick={finish} className="mt-2 w-full bg-emerald-700 hover:bg-emerald-600 text-emerald-50 text-sm font-semibold px-4 py-2 rounded-lg">Done</button>
        </div>
      ) : (
        <div>
          <div className="grid sm:grid-cols-2 gap-x-4">
            <Field label="Shop / Client Name"><TextInput value={shopName} onChange={e => setShopName(e.target.value)} placeholder="e.g. Ali Traders, Lahore" /></Field>
            <Field label="Contact / Phone"><TextInput value={phone} onChange={e => setPhone(e.target.value)} placeholder="03xx-xxxxxxx" /></Field>
            <Field label="Business Type (locked at creation)">
              <select value={businessType} onChange={e => setBusinessType(e.target.value)} className={inputCls}>
                {BUSINESS_TYPES_DEV.map(t => <option key={t.id} value={t.id}>{t.label}</option>)}
              </select>
            </Field>
            <Field label="Owner Username">
              <TextInput value={username} onChange={e => setUsername(e.target.value)} placeholder="auto-suggested from shop name" />
              <div className="text-[11px] text-slate-500 mt-1">{normalizedUsername ? <span>Will be saved as <span className="font-mono text-slate-300">{normalizedUsername}</span> \u2014 this is what the shop owner must type to log in.</span> : <span className="text-rose-400">Enter at least one letter or number.</span>}</div>
            </Field>
            <Field label="Password">
              <div className="flex gap-2">
                <TextInput value={password} onChange={e => setPassword(e.target.value)} />
                <button type="button" onClick={() => setPassword(randomPassword())} className="text-xs px-3 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 whitespace-nowrap">Regenerate</button>
              </div>
            </Field>
            <Field label="Initial License Tier">
              <div className="flex flex-wrap gap-2">
                {TIER_OPTIONS.map(o => (
                  <button key={o.id} type="button" onClick={() => setTier(o.id)} className={"text-xs font-medium px-3 py-2 rounded-lg border " + (tier === o.id ? "bg-amber-500 border-amber-500 text-slate-900" : "border-slate-700 text-slate-300 hover:bg-slate-800")}>{o.label}</button>
                ))}
              </div>
            </Field>
          </div>
          {tier !== "free" && (
            <Field label="Expiry Duration">
              <div className="flex flex-wrap gap-2">
                {DURATION_OPTIONS.map(o => (
                  <button key={o.id} type="button" onClick={() => setDuration(o.id)} className={"text-xs font-medium px-3 py-2 rounded-lg border " + (duration === o.id ? "bg-amber-500 border-amber-500 text-slate-900" : "border-slate-700 text-slate-300 hover:bg-slate-800")}>{o.label}</button>

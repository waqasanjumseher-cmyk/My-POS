          )}
          <button disabled={saving || !shopName.trim() || !normalizedUsername || !password} onClick={submit} className="mt-2 bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-slate-900 text-sm font-semibold px-4 py-2.5 rounded-lg">{saving ? "Creating\u2026" : "Create Client"}</button>
        </div>
      )}
    </Modal>
  );

                            onboarded ? (
                              <>
                                <button disabled={busyRequestId === req.id} onClick={() => resolveRequest(req, true)} className="text-[11px] px-2.5 py-1.5 rounded bg-emerald-800 hover:bg-emerald-700 text-emerald-100 disabled:opacity-50">Approve</button>

                <h3 className="text-sm font-semibold text-white mb-1">Unregistered Activations</h3>
                <p className="text-[11px] text-slate-500 mb-3">Shops that activated a generated key on their own, without being added as a managed Client here. Adopt one to give it credentials and full plan control.</p>
                <div className="overflow-x-auto">
                  <table className="w-full text-xs">
                    <thead className="text-slate-500 uppercase"><tr><th className="text-left py-1.5 pr-3">Shop</th><th className="text-left py-1.5 pr-3">Business Type</th><th className="text-left py-1.5 pr-3">Plan</th><th className="text-left py-1.5 pr-3">Actions</th></tr></thead>
                    <tbody>
                      {unregistered.map(row => (
                        <tr key={row.id} className="border-t border-slate-800">
                          <td className="py-2 pr-3 text-slate-200">{row.bizName || row.bizId}</td>
                          <td className="py-2 pr-3 text-slate-400">{businessTypeLabel(row.businessType)}</td>
                          <td className="py-2 pr-3 text-slate-400">{row.isPremium ? "Premium" : "Free"}</td>
                          <td className="py-2 pr-3"><button onClick={() => openAdopt(row)} className="text-[11px] px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300">Add as Client</button></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        )}

        {tab === "requests" && (
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <div className="flex items-center justify-between mb-1">
              <h3 className="text-sm font-semibold text-white">Plan Requests</h3>
              {CLOUD_ENABLED && <button onClick={refreshPlanRequests} disabled={loadingRequests} className="text-xs px-3 py-1.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-50">{loadingRequests ? "Refreshing\u2026" : "Refresh"}</button>}
            </div>
            <p className="text-[11px] text-slate-500 mb-4">Plans shops have requested from their own app's Settings \u2192 License &amp; Subscription screen. Approving grants the plan immediately, the same as editing a client directly.</p>
            {planRequests.length === 0 ? (
              <div className="text-xs text-slate-500">{loadingRequests ? "Loading\u2026" : "No plan requests yet."}</div>
            ) : (
              <div className="space-y-2">
                {planRequests.map(req => {
                  const onboarded = clientBizIds.has(req.bizId);
                  const durationLabel = (DURATION_OPTIONS.find(o => o.id === req.requestedDuration) || {}).label || req.requestedDuration;
                  return (
                    <div key={req.id} className="bg-slate-800/50 border border-slate-800 rounded-lg px-3 py-2.5">
                      <div className="flex items-center justify-between flex-wrap gap-2">
                        <div>
                          <div className="text-sm text-slate-200 font-medium">{req.bizName || req.bizId}</div>
                          <div className="text-[11px] text-slate-500">

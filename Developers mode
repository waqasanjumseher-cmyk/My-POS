/* ============================ PASSWORD GATE ============================
   CHANGING THE PASSWORD: open a browser console anywhere, run
     crypto.subtle.digest("SHA-256", new TextEncoder().encode("yourNewPassword"))
       .then(b => console.log(Array.from(new Uint8Array(b)).map(x => x.toString(16).padStart(2,"0")).join("")))
   and paste the printed hex string in as DEFAULT_PASSWORD_HASH below. The plaintext password is
   never written anywhere in this file. */
const PASSWORD_HASH_KEY = "zmDevDashboard_passwordHash";
// SHA-256 of the password "Kwaqas5533$".
const DEFAULT_PASSWORD_HASH = "aeece52420ac5684c16cf3a4a8894bd95e9b61a7c1ec2c070d3528e7ec4365f5";
const SESSION_KEY = "zmDevDashboard_unlocked";
function loadPasswordHash() { try { return localStorage.getItem(PASSWORD_HASH_KEY) || DEFAULT_PASSWORD_HASH; } catch (e) { return DEFAULT_PASSWORD_HASH; } }
async function sha256Hex(text) {
  const bytes = new TextEncoder().encode(text || "");
  const digest = await crypto.subtle.digest("SHA-256", bytes);
  return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, "0")).join("");
}
async function verifyPassword(raw) {
  try { return (await sha256Hex(raw)) === loadPasswordHash(); } catch (e) { return false; }
}

                              <>
                                <span className="text-[11px] text-amber-400">Not yet a Client</span>
                                <button onClick={() => openAdopt({ bizId: req.bizId, bizName: req.bizName, businessType: "mobile_shop", isPremium: false })} className="text-[11px] px-2.5 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300">Add as Client</button>
                                <button disabled={busyRequestId === req.id} onClick={() => resolveRequest(req, false)} className="text-[11px] px-2.5 py-1.5 rounded border border-slate-700 text-slate-400 hover:bg-slate-800 disabled:opacity-50">Decline</button>
                              </>
                            )
                          ) : (
                            <span className={"text-[11px] font-semibold px-2 py-1 rounded-full " + (req.status === "approved" ? "bg-emerald-900/60 text-emerald-300" : "bg-rose-900/60 text-rose-300")}>{capitalize(req.status)}</span>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        )}

        {tab === "features" && (
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <div className="flex items-center justify-between mb-1">
              <h3 className="text-sm font-semibold text-white">Feature Control \u2014 Free vs Paid</h3>
              {CLOUD_ENABLED && <button onClick={refreshFeatureFlags} disabled={loadingFeatures} className="text-xs px-3 py-1.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-50">{loadingFeatures ? "Refreshing\u2026" : "Refresh"}</button>}
            </div>
            <p className="text-[11px] text-slate-500 mb-4">Check which features are on for Free users and which are on for Paid users \u2014 no fixed list. This is the global default; override any single feature for one shop from that shop's Edit modal in Clients & Shops.</p>
            {!CLOUD_ENABLED && <div className="mb-4 text-[11px] text-amber-400">Cloud Sync isn't reachable right now \u2014 showing your last-saved values from this browser; Save will retry once it's back.</div>}
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead className="text-slate-500 uppercase text-[11px]"><tr><th className="text-left py-2 pr-3">Feature</th><th className="text-center py-2 px-3">Free</th><th className="text-center py-2 px-3">Paid</th></tr></thead>
                <tbody>
                  {FEATURE_DEFS.map(f => (
                    <tr key={f.id} className="border-t border-slate-800">
                      <td className="py-2 pr-3 text-slate-200">{f.label}</td>
                      <td className="py-2 px-3 text-center"><Checkbox checked={!!featureFlags[f.id] && !!featureFlags[f.id].free} onChange={() => toggleFeature(f.id, "free")} /></td>
                      <td className="py-2 px-3 text-center"><Checkbox checked={!!featureFlags[f.id] && !!featureFlags[f.id].paid} onChange={() => toggleFeature(f.id, "paid")} /></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div className="flex items-center gap-3 mt-4">
              <button disabled={savingFeatures || !featuresDirty} onClick={doSaveFeatureFlags} className="bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-slate-900 text-sm font-semibold px-4 py-2.5 rounded-lg">{savingFeatures ? "Saving\u2026" : "Save Changes"}</button>
              {featuresSaved && <span className="text-xs text-emerald-400">Saved \u2713</span>}
              {featuresDirty && !savingFeatures && <span className="text-xs text-amber-400">Unsaved changes</span>}
            </div>
          </div>
        )}

        {tab === "keys" && (
          <div className="space-y-5">
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <h3 className="text-sm font-semibold text-white mb-3">Generate a License Key</h3>
              <p className="text-[11px] text-slate-500 mb-3">For a shop with Cloud Sync disabled entirely, or a reseller \u2014 they activate it themselves under Settings &rarr; License &amp; Subscription. For a managed Client, add/edit their plan from the Clients &amp; Shops tab instead so it reaches them automatically.</p>
              <div className="flex flex-wrap gap-2 mb-3">
                {VALIDITY_OPTIONS.map(o => (
                  <button key={o.id} onClick={() => setValidity(o.id)} className={"text-xs font-medium px-3 py-2 rounded-lg border " + (validity === o.id ? "bg-amber-500 border-amber-500 text-slate-900" : "border-slate-700 text-slate-300 hover:bg-slate-800")}>{o.label}</button>
                ))}
              </div>
              <div className="max-w-sm mb-3">
                <Field label="Note (optional — e.g. client name, for your own reference)"><TextInput value={note} onChange={e => setNote(e.target.value)} placeholder="e.g. Ali Traders, Lahore" /></Field>
              </div>
              <button onClick={doGenerate} className="bg-amber-500 hover:bg-amber-400 text-slate-900 text-sm font-semibold px-4 py-2.5 rounded-lg">Generate Key</button>

              {justGenerated && (
                <div className="mt-4 bg-emerald-950/40 border border-emerald-800 rounded-lg p-3 flex items-center justify-between gap-3 flex-wrap">
                  <div>
                    <div className="font-mono text-emerald-300 text-sm">{justGenerated.key}</div>
                    <div className="text-[11px] text-emerald-500/80">{justGenerated.label}{justGenerated.note ? " \u00b7 " + justGenerated.note : ""}</div>
                  </div>
                  <button onClick={() => copyKey(justGenerated.key)} className="text-xs px-3 py-1.5 rounded-lg bg-emerald-800 hover:bg-emerald-700 text-emerald-100">{copiedKey === justGenerated.key ? "Copied!" : "Copy"}</button>
                </div>
              )}
            </div>

            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <h3 className="text-sm font-semibold text-white mb-3">Keys Generated From This Browser</h3>
              {keysLog.length === 0 ? (
                <div className="text-xs text-slate-500">No keys generated yet.</div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-xs">
                    <thead className="text-slate-500 uppercase"><tr><th className="text-left py-1.5 pr-3">Key</th><th className="text-left py-1.5 pr-3">Validity</th><th className="text-left py-1.5 pr-3">Note</th><th className="text-left py-1.5 pr-3">Generated</th><th></th></tr></thead>
                    <tbody>
                      {keysLog.map(k => (
                        <tr key={k.key} className="border-t border-slate-800">
                          <td className="py-1.5 pr-3 font-mono text-slate-200">{k.key}</td>
                          <td className="py-1.5 pr-3 text-slate-400">{k.label}</td>
                          <td className="py-1.5 pr-3 text-slate-400">{k.note || "-"}</td>
                          <td className="py-1.5 pr-3 text-slate-500">{new Date(k.generatedAt).toLocaleDateString()}</td>
                          <td className="py-1.5"><button onClick={() => copyKey(k.key)} className="text-[11px] px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300">{copiedKey === k.key ? "Copied!" : "Copy"}</button></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}

        {tab === "logs" && (
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <div className="flex items-center justify-between mb-1">
              <h3 className="text-sm font-semibold text-white">Activity Log</h3>
              {CLOUD_ENABLED && <button onClick={refreshAuditLog} disabled={loadingLog} className="text-xs px-3 py-1.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-50">{loadingLog ? "Refreshing\u2026" : "Refresh"}</button>}
            </div>
            <p className="text-[11px] text-slate-500 mb-4">Recent actions taken from this dashboard \u2014 key generation, client changes, suspensions, and more. Kept for your own audit trail.</p>
            {auditLog.length === 0 ? (
              <div className="text-xs text-slate-500">{loadingLog ? "Loading\u2026" : "No activity recorded yet."}</div>
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead className="text-slate-500 uppercase"><tr><th className="text-left py-1.5 pr-3">When</th><th className="text-left py-1.5 pr-3">Action</th><th className="text-left py-1.5 pr-3">Shop</th><th className="text-left py-1.5 pr-3">Detail</th></tr></thead>
                  <tbody>
                    {auditLog.map(l => (
                      <tr key={l.id} className="border-t border-slate-800">
                        <td className="py-1.5 pr-3 text-slate-500 whitespace-nowrap">{new Date(l.timestamp).toLocaleString()}</td>
                        <td className="py-1.5 pr-3 text-slate-200">{l.action}</td>
                        <td className="py-1.5 pr-3 text-slate-400">{l.shopName || "\u2014"}</td>
                        <td className="py-1.5 pr-3 text-slate-500">{l.detail || "\u2014"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        )}
      </div>

      {showAddModal && <AddClientModal prefill={addPrefill} onClose={() => setShowAddModal(false)} onCreated={refreshClients} />}
      {editRow && <EditClientModal row={editRow} featureFlags={featureFlags} onClose={() => setEditRow(null)} onSaved={refreshClients} />}
      {showChangePassword && <ChangePasswordModal onClose={() => setShowChangePassword(false)} />}
    </div>
  );
}

function App() {
  const [unlocked, setUnlocked] = useState(() => isUnlocked());
  if (!unlocked) return <PasswordGate onUnlock={() => setUnlocked(true)} />;
  return <Dashboard onLock={() => setUnlocked(false)} />;
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>

/* Repairs a client whose stored "username" doesn't match what the shop's login screen would
   normalize the same text to (e.g. it was saved before normalizeShopUsername was applied here,
   or someone typed it with capitals/spaces). Doesn't touch "activations" \u2014 that mirror never
   carried the username in the first place, so there's nothing to fix there. */
async function cloudUpdateUsername(bizId, shopName, username) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return false;
  try {
    await clientsCollection().doc(bizId).set({ username, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    writeAuditLog("Username updated", shopName, username);
    return true;
  } catch (err) { console.warn("Username update failed:", err.code); return false; }
}
async function cloudDeleteClient(bizId, shopName) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return false;
  try {
    await clientsCollection().doc(bizId).delete();
    await licenseActivationsCollection().doc(bizId).delete().catch(() => {});
    writeAuditLog("Client deleted", shopName, "");
    return true;
  } catch (err) { console.warn("Client delete failed:", err.code); return false; }
}
async function cloudSetFeatureOverrides(bizId, shopName, overrides) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return false;
  try {
    await clientsCollection().doc(bizId).set({ featureOverrides: overrides, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    await mirrorToActivation(bizId, { featureOverrides: overrides });
    writeAuditLog("Feature overrides updated", shopName, Object.keys(overrides).length + " override(s)");
    return true;
  } catch (err) { console.warn("Feature override update failed:", err.code); return false; }
}
/* ---- Manual payment recording. There's no payment gateway connected here \u2014 this just adds
   to a running Rs total on the client's record, for your own bookkeeping. Doesn't touch
   "activations" since the shop's own app has no use for its own revenue history. ---- */
async function cloudRecordPayment(bizId, shopName, amount) {
  if (!CLOUD_ENABLED || !fbDb || !bizId || !(Number(amount) > 0)) return false;
  try {
    await clientsCollection().doc(bizId).set({
      totalRevenue: firebase.firestore.FieldValue.increment(Number(amount)), updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true });
    writeAuditLog("Payment recorded", shopName, "Rs " + Number(amount).toLocaleString());
    return true;
  } catch (err) { console.warn("Payment record failed:", err.code); return false; }
}

/* ============================ DYNAMIC FEATURE CONTROL (Free vs Paid, global default) ============
   A single config document any client build can read: system/feature_flags -> { features:
   { <id>: { free: bool, paid: bool } } }. Per-client Feature Overrides (in the Edit Client modal)
   layer on top of this global default for one specific shop, without changing it for everyone
   else. Cached to localStorage so the panel still shows your last-saved state offline.

   IDs below are kept in exact 1:1 sync with the PREMIUM_FEATURES registry in shop-erp-cloud.html
   — same ids, so a value written here lines up with the right gate if/when the client is wired
   to actually read featureOverrides (see the IMPORTANT SCOPE NOTE at the top of this file: as of
   this writing the client only checks the single account-wide license.isPremium flag — it does
   NOT yet look at per-feature overrides or this global doc, so toggles below don't take effect on
   their own yet). "inventoryLimit" (the 50-item Free cap) isn't listed here because it isn't a
   PremiumGate'd feature client-side — it's just a hardcoded FREE_PLAN_LIMITS number, not something
   a per-shop on/off override could apply to. */
const FEATURE_DEFS = [
  { id: "installments",         label: "Installment Management" },
  { id: "advancedReports",      label: "Advanced PDF/Excel Reports" },
  { id: "whatsappImageReceipts",label: "WhatsApp Image Receipts" },
  { id: "multiAccountProfitLoss", label: "Multi-Account Profit/Loss" },
  { id: "cloudSync",            label: "Cloud Sync" },
  { id: "backupRestore",        label: "Backup & Restore" },
  { id: "importMerge",          label: "Import & Merge" },
  { id: "businessSettings",     label: "Business Settings (POS, Users, Custom Items, Display, Advanced)" },
];
function defaultFeatureFlags() {
  const out = {};
  FEATURE_DEFS.forEach(f => { out[f.id] = { free: false, paid: true }; });
  return out;
}
const FEATURE_FLAGS_CACHE_KEY = "zmDevDashboard_featureFlagsCache";
function loadCachedFeatureFlags() { return loadJSON(FEATURE_FLAGS_CACHE_KEY, null); }
function saveCachedFeatureFlags(flags) { saveJSON(FEATURE_FLAGS_CACHE_KEY, flags); }
function featureFlagsDoc() { return fbDb.collection("system").doc("feature_flags"); }
async function cloudFetchFeatureFlags() {
  if (!CLOUD_ENABLED || !fbDb) return loadCachedFeatureFlags();
  try {
    const snap = await featureFlagsDoc().get();
    const data = snap.exists ? snap.data().features : null;
    if (data) saveCachedFeatureFlags(data);
    return data || loadCachedFeatureFlags();
  } catch (err) { console.warn("Failed to load feature flags:", err.code); return loadCachedFeatureFlags(); }
}
async function cloudSaveFeatureFlags(flags) {
  saveCachedFeatureFlags(flags);
  if (!CLOUD_ENABLED || !fbDb) return false;
  try {
    await featureFlagsDoc().set({ features: flags, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    writeAuditLog("Global feature flags updated", "", "");
    return true;
  } catch (err) { console.warn("Failed to save feature flags:", err.code); return false; }
}


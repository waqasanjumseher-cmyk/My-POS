/* ============================ EDIT CLIENT MODAL ============================ */
function EditClientModal({ row, onClose, onSaved, featureFlags }) {
  const [businessType, setBusinessType] = useState(row.businessType || "mobile_shop");
  const [bizTypeUnlocked, setBizTypeUnlocked] = useState(false);
  const [tier, setTier] = useState(row.tier || "free");
  const [duration, setDuration] = useState("30d");
  const [saving, setSaving] = useState(false);
  const [resetPw, setResetPw] = useState(null);
  const [resettingPw, setResettingPw] = useState(false);
  const [overrides, setOverrides] = useState(row.featureOverrides || {});
  const [username, setUsername] = useState(row.username || "");
  const [savingUsername, setSavingUsername] = useState(false);
  const [usernameNotice, setUsernameNotice] = useState("");
  const normalizedUsername = normalizeShopUsername(username);
  const usernameMismatch = row.username && row.username !== normalizeShopUsername(row.username);

  async function doSaveUsername() {
    if (!normalizedUsername) return;
    setSavingUsername(true);
    const ok = await cloudUpdateUsername(row.bizId, row.shopName, normalizedUsername);
    setSavingUsername(false);
    if (ok) { setUsername(normalizedUsername); setUsernameNotice("Saved \u2014 the shop can now log in with this exact username."); onSaved(); }
  }
  const [paymentAmount, setPaymentAmount] = useState("");
  const [recordingPayment, setRecordingPayment] = useState(false);
  const [recordedTotal, setRecordedTotal] = useState(Number(row.totalRevenue) || 0);
  const [paymentNotice, setPaymentNotice] = useState("");

  async function doRecordPayment() {
    setRecordingPayment(true);
    const ok = await cloudRecordPayment(row.bizId, row.shopName, paymentAmount);
    setRecordingPayment(false);
    if (ok) {
      setRecordedTotal(prev => prev + (Number(paymentAmount) || 0));
      setPaymentAmount("");
      setPaymentNotice("Payment recorded.");
      onSaved();
    }
  }

  function overrideValue(id) { return overrides[id] === true ? "on" : overrides[id] === false ? "off" : "default"; }
  function setOverride(id, val) {
    setOverrides(prev => {
      const next = { ...prev };
      if (val === "default") delete next[id]; else next[id] = val === "on";
      return next;
    });
  }

  async function doResetPassword() {
    if (!confirm("Generate a new password for " + row.shopName + "? The old one stops working immediately.")) return;
    const pw = randomPassword();
    setResettingPw(true);
    const ok = await cloudResetClientPassword(row.bizId, row.shopName, await sha256Hex(pw));
    setResettingPw(false);
    if (ok) setResetPw(pw);
  }

  async function save() {
    setSaving(true);
    if (businessType !== row.businessType) await cloudUpdateBusinessType(row.bizId, row.shopName, businessType);
    let expiresAt = row.expiresAt || null;
    if (tier !== row.tier) {
      if (tier === "free") { expiresAt = null; }
      else { const opt = DURATION_OPTIONS.find(o => o.id === duration) || DURATION_OPTIONS[1]; expiresAt = opt.days == null ? null : new Date(Date.now() + opt.days * 86400000).toISOString(); }
      await cloudUpdateClientPlan(row.bizId, row.shopName, tier, expiresAt);
    }
    if (JSON.stringify(overrides) !== JSON.stringify(row.featureOverrides || {})) await cloudSetFeatureOverrides(row.bizId, row.shopName, overrides);
    setSaving(false);
    onSaved();
    onClose();
  }

  return (
    <Modal title={"Edit \u2014 " + (row.shopName || row.bizId)} onClose={onClose} wide>
      <div className="space-y-5">
        <div>
          <div className="text-xs font-medium text-slate-400 mb-1">Owner Username <span className="text-slate-600 font-normal">(what the shop types on their login screen)</span></div>
          {usernameMismatch && !usernameNotice && (
            <div className="text-[11px] text-amber-400 bg-amber-950/40 border border-amber-800 rounded-lg px-2.5 py-1.5 mb-1.5">This client's saved username won't match what their login screen searches for \u2014 login will fail with "No shop account found" until you save the corrected version below.</div>
          )}
          <div className="flex gap-2">
            <TextInput value={username} onChange={e => { setUsername(e.target.value); setUsernameNotice(""); }} className="flex-1" />
            <button type="button" disabled={savingUsername || !normalizedUsername || normalizedUsername === row.username} onClick={doSaveUsername} className="text-xs px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-50 whitespace-nowrap">{savingUsername ? "Saving\u2026" : "Save"}</button>
          </div>
          {usernameNotice ? (
            <div className="text-[11px] text-emerald-400 mt-1">{usernameNotice}</div>
          ) : (
            <div className="text-[11px] text-slate-500 mt-1">Will be saved as <span className="font-mono text-slate-300">{normalizedUsername || "\u2014"}</span>.</div>
          )}
        </div>

        <div>
          <div className="text-xs font-medium text-slate-400 mb-1">Business Type</div>
          <div className="flex items-center gap-2">
            <select value={businessType} disabled={!bizTypeUnlocked} onChange={e => setBusinessType(e.target.value)} className={inputCls + " disabled:opacity-50"}>
              {BUSINESS_TYPES_DEV.map(t => <option key={t.id} value={t.id}>{t.label}</option>)}
            </select>
            <button type="button" onClick={() => { if (bizTypeUnlocked || confirm("Unlock Business Type for editing? Lock it again once you're done.")) setBizTypeUnlocked(v => !v); }} title={bizTypeUnlocked ? "Unlocked \u2014 click to lock" : "Locked \u2014 click to unlock"} className={"text-xs px-2.5 py-2 rounded-lg border whitespace-nowrap " + (bizTypeUnlocked ? "border-slate-700 text-slate-400 hover:bg-slate-800" : "border-amber-700 text-amber-400 bg-amber-950/40")}>
              {bizTypeUnlocked ? "\u{1F513} Unlocked" : "\u{1F512} Locked"}
            </button>
          </div>
        </div>

        <div>
          <div className="text-xs font-medium text-slate-400 mb-1">License Tier</div>
          <div className="flex flex-wrap gap-2 mb-2">
            {TIER_OPTIONS.map(o => (
              <button key={o.id} type="button" onClick={() => setTier(o.id)} className={"text-xs font-medium px-3 py-2 rounded-lg border " + (tier === o.id ? "bg-amber-500 border-amber-500 text-slate-900" : "border-slate-700 text-slate-300 hover:bg-slate-800")}>{o.label}</button>
            ))}
          </div>
          {tier !== "free" && tier !== row.tier && (
            <div className="flex flex-wrap gap-2">
              {DURATION_OPTIONS.map(o => (
                <button key={o.id} type="button" onClick={() => setDuration(o.id)} className={"text-xs font-medium px-3 py-2 rounded-lg border " + (duration === o.id ? "bg-amber-500 border-amber-500 text-slate-900" : "border-slate-700 text-slate-300 hover:bg-slate-800")}>{o.label}</button>
              ))}
            </div>
          )}
          {tier !== "free" && tier === row.tier && <div className="text-[11px] text-slate-500">Current expiry: {formatDate(row.expiresAt)} {"\u2014"} change tier away and back to reset the duration.</div>}
        </div>

        <div>
          <div className="text-xs font-medium text-slate-400 mb-1">Password</div>
          {resetPw ? (
            <div className="bg-emerald-950/40 border border-emerald-800 rounded-lg p-2.5 text-xs flex items-center justify-between gap-3">
              <span className="text-slate-300">New password: <span className="font-mono text-emerald-200">{resetPw}</span></span>
              <span className="text-emerald-500/80">Shown once</span>
            </div>
          ) : (
            <button type="button" disabled={resettingPw} onClick={doResetPassword} className="text-xs px-3 py-2 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-50">{resettingPw ? "Resetting\u2026" : "Reset Password"}</button>
          )}
        </div>

        <div>
          <div className="text-xs font-medium text-slate-400 mb-1">Record a Payment</div>
          <p className="text-[11px] text-slate-500 mb-2">Total recorded so far: Rs {recordedTotal.toLocaleString()}. Manual \u2014 there's no payment gateway connected.</p>
          {paymentNotice && <div className="text-[11px] text-emerald-400 mb-2">{paymentNotice}</div>}
          <div className="flex gap-2">
            <TextInput type="number" min="0" value={paymentAmount} onChange={e => { setPaymentAmount(e.target.value); setPaymentNotice(""); }} placeholder="Amount (Rs)" className="flex-1" />
            <button type="button" disabled={recordingPayment || !(Number(paymentAmount) > 0)} onClick={doRecordPayment} className="text-xs px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-50 whitespace-nowrap">{recordingPayment ? "Saving\u2026" : "Record"}</button>
          </div>
        </div>

        <div>
          <div className="text-xs font-medium text-slate-400 mb-2">Feature Overrides <span className="text-slate-600 font-normal">(for this shop only \u2014 otherwise follows the global Feature Control setting)</span></div>
          <div className="max-h-56 overflow-y-auto pr-1 space-y-1.5">
            {FEATURE_DEFS.map(f => (
              <div key={f.id} className="flex items-center justify-between text-xs bg-slate-800/50 rounded-lg px-3 py-2">
                <span className="text-slate-300">{f.label}</span>
                <select value={overrideValue(f.id)} onChange={e => setOverride(f.id, e.target.value)} className="text-[11px] border border-slate-700 bg-slate-900 text-slate-200 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-amber-500/50">
                  <option value="default">Default ({featureFlags[f.id] && featureFlags[f.id][row.tier === "free" ? "free" : "paid"] ? "On" : "Off"})</option>
                  <option value="on">Force On</option>
                  <option value="off">Force Off</option>
                </select>
              </div>
            ))}
          </div>
        </div>

        <button disabled={saving} onClick={save} className="w-full bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-slate-900 text-sm font-semibold px-4 py-2.5 rounded-lg">{saving ? "Saving\u2026" : "Save Changes"}</button>
      </div>
    </Modal>
  );
}

/* ============================ DASHBOARD ============================ */
function Dashboard({ onLock }) {
  const [tab, setTab] = useState("overview"); // overview | clients | features | keys | logs

  /* ---- Clients (master roster) + Unregistered Activations ---- */
  const [clients, setClients] = useState([]);
  const [activations, setActivations] = useState([]);
  const [loadingClients, setLoadingClients] = useState(false);
  const [busyBizId, setBusyBizId] = useState("");
  const [showAddModal, setShowAddModal] = useState(false);
  const [addPrefill, setAddPrefill] = useState(null);
  const [editRow, setEditRow] = useState(null);
  const [showChangePassword, setShowChangePassword] = useState(false);

  async function refreshClients() {
    setLoadingClients(true);
    const [c, a] = await Promise.all([cloudFetchClients(), cloudFetchActivations()]);
    setClients(c);
    setActivations(a);
    setLoadingClients(false);
  }
  useEffect(() => { if (CLOUD_ENABLED && (tab === "overview" || tab === "clients")) refreshClients(); }, [tab]);

  const clientBizIds = new Set(clients.map(c => c.bizId));
  const unregistered = activations.filter(a => a.bizId && !clientBizIds.has(a.bizId));

  async function suspendToggle(row) {
    const next = !row.blocked;
    if (next && !confirm("Suspend " + (row.shopName || row.bizId) + "? Their shop app will lose access.")) return;
    setBusyBizId(row.bizId);
    await cloudSetBlocked(row.bizId, row.shopName, next);
    await refreshClients();
    setBusyBizId("");
  }
  async function deleteRow(row) {
    if (!confirm("Delete the client record for " + (row.shopName || row.bizId) + "? This removes their login credentials and plan info. This can't be undone.")) return;
    setBusyBizId(row.bizId);
    await cloudDeleteClient(row.bizId, row.shopName);
    await refreshClients();
    setBusyBizId("");
  }
  function openAdd() { setAddPrefill(null); setShowAddModal(true); }
  function openAdopt(row) { setAddPrefill({ bizId: row.bizId, shopName: row.bizName, businessType: row.businessType, tier: row.isPremium ? "premium" : "free" }); setShowAddModal(true); }

  /* ---- Dynamic Feature Control (global Free vs Paid) ---- */
  const [featureFlags, setFeatureFlags] = useState(() => loadCachedFeatureFlags() || defaultFeatureFlags());
  const [loadingFeatures, setLoadingFeatures] = useState(false);
  const [savingFeatures, setSavingFeatures] = useState(false);
  const [featuresSaved, setFeaturesSaved] = useState(false);
  const [featuresDirty, setFeaturesDirty] = useState(false);
  async function refreshFeatureFlags() {
    setLoadingFeatures(true);
    const flags = await cloudFetchFeatureFlags();
    setFeatureFlags({ ...defaultFeatureFlags(), ...(flags || {}) });
    setLoadingFeatures(false);
    setFeaturesDirty(false);
  }
  useEffect(() => { if (tab === "features") refreshFeatureFlags(); }, [tab]);
  function toggleFeature(id, plan) {
    setFeatureFlags(prev => ({ ...prev, [id]: { ...prev[id], [plan]: !prev[id][plan] } }));
    setFeaturesDirty(true);
    setFeaturesSaved(false);
  }
  async function doSaveFeatureFlags() {
    setSavingFeatures(true);
    const ok = await cloudSaveFeatureFlags(featureFlags);
    setSavingFeatures(false);
    setFeaturesDirty(false);
    setFeaturesSaved(ok);
    if (ok) setTimeout(() => setFeaturesSaved(false), 2000);
  }

  /* ---- Generate License Keys (still useful standalone, e.g. for Cloud-Sync-disabled shops) ---- */
  const VALIDITY_OPTIONS = [
    { id: "30d", label: "30 Days", days: 30 },
    { id: "1y", label: "1 Year", days: 365 },
    { id: "lifetime", label: "Lifetime", days: null },
  ];
  const [validity, setValidity] = useState("lifetime");
  const [note, setNote] = useState("");
  const [justGenerated, setJustGenerated] = useState(null);
  const [keysLog, setKeysLog] = useState(() => loadLocalKeysLog());
  const [copiedKey, setCopiedKey] = useState("");
  function doGenerate() {
    const opt = VALIDITY_OPTIONS.find(o => o.id === validity) || VALIDITY_OPTIONS[2];
    const key = generateLicenseKey(opt.days);
    const entry = { key, days: opt.days, label: opt.label, note: note.trim(), generatedAt: new Date().toISOString() };
    appendLocalKeysLog(entry);
    setKeysLog(loadLocalKeysLog());
    setJustGenerated(entry);
    cloudPushGeneratedKey(key, opt.days, note.trim());
    writeAuditLog("License key generated", note.trim(), opt.label);
    setNote("");
  }
  function copyKey(key) {
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(key).catch(() => {});
    setCopiedKey(key);
    setTimeout(() => setCopiedKey(""), 1500);
  }

  /* ---- Activity Log ---- */
  const [auditLog, setAuditLog] = useState(() => loadJSON(AUDIT_LOG_CACHE_KEY, []));
  const [loadingLog, setLoadingLog] = useState(false);
  async function refreshAuditLog() {
    setLoadingLog(true);
    setAuditLog(await cloudFetchAuditLog());
    setLoadingLog(false);
  }
  useEffect(() => { if (tab === "logs") refreshAuditLog(); }, [tab]);

  /* ---- Plan Requests (shops asking for Trial/Premium) ---- */
  const [planRequests, setPlanRequests] = useState([]);
  const [loadingRequests, setLoadingRequests] = useState(false);
  const [busyRequestId, setBusyRequestId] = useState("");
  async function refreshPlanRequests() {
    setLoadingRequests(true);
    setPlanRequests(await cloudFetchPlanRequests());
    setLoadingRequests(false);
  }
  useEffect(() => { if (CLOUD_ENABLED && (tab === "overview" || tab === "requests")) refreshPlanRequests(); }, [tab]);
  const pendingRequests = planRequests.filter(r => r.status === "pending");
  async function resolveRequest(req, approve) {
    if (approve && !confirm("Approve " + capitalize(req.requestedTier) + " for " + (req.bizName || req.bizId) + "?")) return;
    if (!approve && !confirm("Decline this request from " + (req.bizName || req.bizId) + "?")) return;
    setBusyRequestId(req.id);
    const ok = await cloudResolvePlanRequest(req, approve, "");
    setBusyRequestId("");
    if (ok) { refreshPlanRequests(); if (approve) refreshClients(); }
  }

  /* ---- Overview stats ---- */
  const allShops = [
    ...clients,
    ...unregistered.map(a => ({ bizId: a.bizId, shopName: a.bizName || a.bizId, tier: a.isPremium ? "premium" : "free", blocked: !!a.blocked, expiresAt: a.expiresAt || null })),
  ];
  const totalShops = allShops.length;
  const blockedCount = allShops.filter(r => r.blocked).length;
  const premiumCount = allShops.filter(r => r.tier && r.tier !== "free" && !isExpired(r.expiresAt)).length;
  const freeCount = totalShops - premiumCount;
  const [revenuePrice, setRevenuePrice] = useState(() => loadRevenuePrice());
  function updateRevenuePrice(v) { const n = Number(v) || 0; setRevenuePrice(n); saveRevenuePrice(n); }
  const recordedRevenue = clients.reduce((s, c) => s + (Number(c.totalRevenue) || 0), 0);

  const TABS_DEV = [
    { id: "overview", label: "Overview", icon: "\u{1F4CA}" },
    { id: "clients", label: "Clients & Shops", icon: "\u{1F3EA}" },
    { id: "requests", label: "Plan Requests", icon: "\u{1F4E5}" },
    { id: "features", label: "Feature Control", icon: "\u{1F39B}\uFE0F" },
    { id: "keys", label: "Generate Keys", icon: "\u{1F511}" },
    { id: "logs", label: "Activity Log", icon: "\u{1F4DC}" },
  ];

  return (
    <div className="min-h-screen bg-slate-950 text-slate-200">
      <div className="border-b border-slate-800 bg-slate-900/60 px-4 md:px-8 py-4 flex items-center justify-between flex-wrap gap-3">
        <div className="flex items-center gap-3">
          <div className="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-lg">{"\u{1F6E0}\uFE0F"}</div>
          <div>
            <div className="text-sm font-bold text-white leading-tight">Anjum Webs POS</div>
            <div className="text-[11px] text-slate-400">Master Developer Dashboard</div>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <button onClick={() => setShowChangePassword(true)} className="text-xs px-3 py-1.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800">Change Password</button>
          <button onClick={() => { lockSession(); onLock(); }} className="text-xs px-3 py-1.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800">Lock</button>
        </div>
      </div>

      <div className="px-4 md:px-8 pt-4 flex gap-2 border-b border-slate-800 overflow-x-auto">
        {TABS_DEV.map(t => (
          <button key={t.id} onClick={() => setTab(t.id)} className={"flex items-center gap-1.5 text-xs font-medium px-3 py-2 rounded-t-lg whitespace-nowrap " + (tab === t.id ? "bg-slate-900 text-white border border-slate-800 border-b-slate-900" : "text-slate-400 hover:text-slate-200")}>
            <span>{t.icon}</span>{t.label}
            {t.id === "requests" && pendingRequests.length > 0 && <span className="text-[10px] bg-amber-500 text-slate-900 font-bold rounded-full px-1.5 leading-4">{pendingRequests.length}</span>}
          </button>
        ))}
      </div>

      <div className="p-4 md:p-8 max-w-6xl">
        {!CLOUD_ENABLED && (
          <div className="mb-5 bg-amber-950/40 border border-amber-800 rounded-xl p-4 text-xs text-amber-300">
            Cloud Sync isn't reachable from this browser right now (Firebase failed to load or is blocked). Keys generated below still work — clients validate them purely offline — but Clients, Overview stats, remote plan/status control, and the Activity Log need a working connection to the shared project.
          </div>
        )}

        {tab === "overview" && (
          <div className="space-y-5">
            <div className="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
              <StatCard label="Total Shops" value={totalShops} sub={blockedCount ? blockedCount + " blocked" : "all active"} />
              <StatCard label="Free vs Premium" value={freeCount + " / " + premiumCount} sub="free / premium+trial (non-expired)" />
              <StatCard label="Active Licenses" value={premiumCount} sub="paid plans currently valid" />
              <StatCard label="Total Revenue" value={"Rs " + recordedRevenue.toLocaleString()} sub="manually recorded via Edit \u2192 Record a Payment" />
              <StatCard label="Estimated Revenue" value={"Rs " + (revenuePrice * premiumCount).toLocaleString()} sub="not real payment data \u2014 a calculator">
                <div className="mt-2 flex items-center gap-1.5">
                  <span className="text-[11px] text-slate-500">Price / paid client:</span>
                  <input type="number" min="0" value={revenuePrice} onChange={e => updateRevenuePrice(e.target.value)} className="w-20 text-xs border border-slate-700 bg-slate-950 text-slate-200 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-amber-500/50" />
                </div>
              </StatCard>
            </div>
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <h3 className="text-sm font-semibold text-white mb-3">Quick Actions</h3>
              <div className="flex flex-wrap gap-2">
                <button onClick={openAdd} className="text-xs px-3 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold">+ Add New Client</button>
                <button onClick={() => setTab("clients")} className="text-xs px-3 py-2 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800">View All Clients</button>
                <button onClick={() => setTab("logs")} className="text-xs px-3 py-2 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800">View Activity Log</button>
              </div>
            </div>
            {!CLOUD_ENABLED ? null : loadingClients ? (
              <div className="text-xs text-slate-500">Loading\u2026</div>
            ) : (
              <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
                <h3 className="text-sm font-semibold text-white mb-3">Recent Activity</h3>
                {auditLog.length === 0 ? <div className="text-xs text-slate-500">No activity recorded yet \u2014 check the Activity Log tab.</div> : (
                  <div className="space-y-2">
                    {auditLog.slice(0, 5).map(l => (
                      <div key={l.id} className="text-xs flex items-center justify-between gap-3 border-t border-slate-800 pt-2 first:border-t-0 first:pt-0">
                        <span className="text-slate-300">{l.action}{l.shopName ? " \u2014 " + l.shopName : ""}</span>
                        <span className="text-slate-500 whitespace-nowrap">{new Date(l.timestamp).toLocaleString()}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </div>
        )}

        {tab === "clients" && (
          <div className="space-y-5">
            <div className="flex items-center justify-between flex-wrap gap-2">
              <div>
                <h3 className="text-sm font-semibold text-white">Clients & Shops</h3>
                <p className="text-[11px] text-slate-500">All registered client shops \u2014 edit their plan, suspend access, or remove them.</p>
              </div>
              <div className="flex gap-2">
                {CLOUD_ENABLED && <button onClick={refreshClients} disabled={loadingClients} className="text-xs px-3 py-1.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-50">{loadingClients ? "Refreshing\u2026" : "Refresh"}</button>}
                <button onClick={openAdd} className="text-xs px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold">+ Add Client</button>
              </div>
            </div>

            {!CLOUD_ENABLED ? (
              <div className="text-xs text-slate-400">Cloud Sync isn't reachable from this browser right now \u2014 see the notice above.</div>
            ) : (
              <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
                {clients.length === 0 ? (
                  <div className="text-xs text-slate-500">{loadingClients ? "Loading\u2026" : "No clients yet \u2014 use \u201c+ Add Client\u201d to onboard your first shop."}</div>
                ) : (
                  <div className="overflow-x-auto">
                    <table className="w-full text-xs">
                      <thead className="text-slate-500 uppercase"><tr><th className="text-left py-1.5 pr-3">Shop Name</th><th className="text-left py-1.5 pr-3">Owner Username</th><th className="text-left py-1.5 pr-3">Business Type</th><th className="text-left py-1.5 pr-3">Tier</th><th className="text-left py-1.5 pr-3">Status</th><th className="text-left py-1.5 pr-3">Expiry</th><th className="text-left py-1.5 pr-3">Actions</th></tr></thead>
                      <tbody>
                        {clients.map(row => {
                          const tb = tierBadge(row);
                          const sb = statusBadge(row);
                          const busy = busyBizId === row.bizId;
                          return (
                            <tr key={row.id} className="border-t border-slate-800">
                              <td className="py-2 pr-3 text-slate-200">{row.shopName || row.bizId}</td>
                              <td className="py-2 pr-3 font-mono text-slate-400">{row.username}{row.username && row.username !== normalizeShopUsername(row.username) && <span title="Saved username won't match what the login screen searches for — open Edit to fix it." className="ml-1.5 text-amber-400 cursor-help">{"\u26A0\uFE0F"}</span>}</td>
                              <td className="py-2 pr-3 text-slate-400">{businessTypeLabel(row.businessType)}</td>
                              <td className="py-2 pr-3"><span className={"px-2 py-0.5 rounded-full font-medium " + tb.cls}>{tb.label}</span></td>
                              <td className="py-2 pr-3"><span className={"px-2 py-0.5 rounded-full font-medium " + sb.cls}>{sb.label}</span></td>
                              <td className="py-2 pr-3 text-slate-500">{formatDate(row.expiresAt)}</td>
                              <td className="py-2 pr-3">
                                <div className="flex flex-wrap gap-1.5">
                                  <button disabled={busy} onClick={() => setEditRow(row)} className="text-[11px] px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 disabled:opacity-50">Edit</button>
                                  <button disabled={busy} onClick={() => suspendToggle(row)} className={"text-[11px] px-2 py-1 rounded disabled:opacity-50 " + (row.blocked ? "bg-emerald-800 hover:bg-emerald-700 text-emerald-100" : "border border-slate-700 text-amber-400 hover:bg-slate-800")}>{row.blocked ? "Activate" : "Suspend"}</button>
                                  <button disabled={busy} onClick={() => deleteRow(row)} className="text-[11px] px-2 py-1 rounded border border-slate-700 text-rose-400 hover:bg-slate-800 disabled:opacity-50">Delete</button>
                                </div>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            )}

            {CLOUD_ENABLED && unregistered.length > 0 && (

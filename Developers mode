/* ============================ LICENSE KEY FORMAT ============================
   Identical format/checksum to what shop-erp-cloud.html validates, so any key generated here
   activates correctly in a client's Settings -> License & Subscription screen.
   ZM-XXXX-XXXX-CCCC, where the first group also self-encodes validity ("P"+3-char base36 day
   count, or "LIF" for Lifetime) and CCCC is a checksum of the two preceding groups. */
function licenseChecksumSegment(body) {
  let sum = 0;
  for (let i = 0; i < body.length; i++) sum += body.charCodeAt(i) * (i + 1);
  return sum.toString(36).toUpperCase().padStart(4, "0").slice(-4);
}
function encodeDurationCode(days) {
  if (days == null) return "LIF";
  return Math.max(0, Math.min(46655, Math.round(days))).toString(36).toUpperCase().padStart(3, "0");
}
function generateLicenseKey(days) {
  const g1 = "P" + encodeDurationCode(days);
  let g2 = "";
  while (g2.length < 4) g2 += Math.floor(Math.random() * 36).toString(36);
  g2 = g2.toUpperCase().slice(0, 4);
  const g3 = licenseChecksumSegment(g1 + g2);
  return "ZM-" + g1 + "-" + g2 + "-" + g3;
}

function uid(prefix) { return (prefix || "id") + "_" + Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4); }
function loadJSON(key, fallback) { try { const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : fallback; } catch (e) { return fallback; } }
function saveJSON(key, value) { try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { console.error(e); } }
function formatDate(iso) { return iso ? new Date(iso).toLocaleDateString() : "\u2014"; }
function isExpired(expiresAt) { return !!expiresAt && new Date(expiresAt).getTime() <= Date.now(); }
function capitalize(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }

/* ---- Local log of keys generated from this browser (works even if Firestore is briefly
   unreachable; the cloud registry below is the cross-device source of truth once it syncs). ---- */
const LOCAL_KEYS_LOG_KEY = "zmDevDashboard_keysLog";
function loadLocalKeysLog() { return loadJSON(LOCAL_KEYS_LOG_KEY, []); }
function appendLocalKeysLog(entry) { const log = loadLocalKeysLog(); saveJSON(LOCAL_KEYS_LOG_KEY, [entry, ...log].slice(0, 500)); }

function cloudPushGeneratedKey(key, durationDays, note) {
  if (!CLOUD_ENABLED || !fbDb) return;
  licenseKeysCollection().doc(key).set({
    key, durationDays: durationDays == null ? null : durationDays, note: note || "",
    generatedAt: firebase.firestore.FieldValue.serverTimestamp(), redeemed: false,
  }, { merge: true }).catch(err => console.warn("License key registry push failed:", err.code));
}
async function cloudFetchActivations() {
  if (!CLOUD_ENABLED || !fbDb) return [];
  try {
    const snap = await licenseActivationsCollection().orderBy("updatedAt", "desc").limit(300).get();
    return snap.docs.map(d => ({ id: d.id, ...d.data() }));
  } catch (err) { console.warn("Failed to load activations:", err.code); return []; }
}

/* ---- Same 10 Business Types shop-erp-cloud.html's CUSTOM_BUSINESS_TYPES defines (ids must match
   exactly — the client keys its Inventory categories/fields off these ids). Kept as a plain id+label
   list here since this dashboard doesn't need the full category/field config, only the id to assign. */
const BUSINESS_TYPES_DEV = [
  { id: "mobile_shop",       label: "Mobile Shop" },
  { id: "pharmacy",          label: "Medicine / Pharmacy Store" },
  { id: "crockery",          label: "Crockery Shop" },
  { id: "grocery",           label: "Grocery Store" },
  { id: "general_store",     label: "General Store" },
  { id: "tiles_ceramics",    label: "Tiles & Ceramics" },
  { id: "ceiling_paneling",  label: "Ceiling & Paneling" },
  { id: "hotel",             label: "Hotel" },
  { id: "fast_food",         label: "Fast Food Chain" },
  { id: "school_academy",    label: "School / Academy Management" },
  { id: "other",             label: "Other / General Business" },
];
function businessTypeLabel(id) { const t = BUSINESS_TYPES_DEV.find(b => b.id === id); return t ? t.label : "Mobile Shop (default)"; }

const TIER_OPTIONS = [
  { id: "free",    label: "Free" },
  { id: "trial",   label: "Trial" },
  { id: "premium", label: "Premium" },
];
const DURATION_OPTIONS = [
  { id: "7d",  label: "7 Days", days: 7 },
  { id: "30d", label: "30 Days", days: 30 },
  { id: "1y",  label: "1 Year", days: 365 },
  { id: "lifetime", label: "Lifetime", days: null },
];
function tierBadge(row) {
  if (!row.tier || row.tier === "free") return { label: "Free", cls: "bg-slate-800 text-slate-400" };
  if (isExpired(row.expiresAt)) return { label: capitalize(row.tier) + " (Expired)", cls: "bg-rose-900/60 text-rose-300" };
  return { label: capitalize(row.tier), cls: row.tier === "premium" ? "bg-emerald-900/60 text-emerald-300" : "bg-sky-900/60 text-sky-300" };
}
function statusBadge(row) {
  return row.blocked ? { label: "Blocked", cls: "bg-rose-900/60 text-rose-300" } : { label: "Active", cls: "bg-emerald-900/60 text-emerald-300" };
}

function randomPassword(length) {
  const chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789";
  let out = "";
  for (let i = 0; i < (length || 10); i++) out += chars[Math.floor(Math.random() * chars.length)];
  return out;
}
function slugify(text) {
  return (text || "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "").slice(0, 12) || "shop";
}
function suggestUsername(shopName) {
  return slugify(shopName) + Math.floor(100 + Math.random() * 900);
}
/* Must stay byte-for-byte identical to normalizeShopUsername() in shop-erp-cloud.html — that's
   how the client's login screen normalizes what the shop owner types before querying Firestore
   for a matching "username" field. Applying the exact same normalization here, right before we
   ever save a username, guarantees the two always agree. Without this, a username saved with a
   capital letter, a space, or any character outside [a-z0-9_.-] would be stored one way here and
   searched for a different way there, and login would fail with "No shop account found" even
   though the account exists. */
function normalizeShopUsername(u) { return (u || "").trim().toLowerCase().replace(/[^a-z0-9_.-]/g, ""); }

/* ============================ AUDIT LOG ============================
   Fire-and-forget writes (like cloudPushGeneratedKey above) so a flaky connection never blocks
   the action that triggered the log entry. Each entry gets a client-generated id used as both
   the local optimistic-cache key and the Firestore doc id, so a later refresh never duplicates it. */
const AUDIT_LOG_CACHE_KEY = "zmDevDashboard_auditLogCache";
function writeAuditLog(action, shopName, detail) {
  const entry = { id: uid("log"), action, shopName: shopName || "", detail: detail || "", actor: "Developer", timestamp: new Date().toISOString() };
  saveJSON(AUDIT_LOG_CACHE_KEY, [entry, ...loadJSON(AUDIT_LOG_CACHE_KEY, [])].slice(0, 200));
  if (CLOUD_ENABLED && fbDb) {
    auditLogCollection().doc(entry.id).set({
      action: entry.action, shopName: entry.shopName, detail: entry.detail, actor: entry.actor,
      timestamp: firebase.firestore.FieldValue.serverTimestamp(),
    }).catch(err => console.warn("Audit log write failed:", err.code));
  }
  return entry;
}
async function cloudFetchAuditLog() {
  if (!CLOUD_ENABLED || !fbDb) return loadJSON(AUDIT_LOG_CACHE_KEY, []);
  try {
    const snap = await auditLogCollection().orderBy("timestamp", "desc").limit(100).get();
    const rows = snap.docs.map(d => {
      const data = d.data();
      const ts = data.timestamp && data.timestamp.toDate ? data.timestamp.toDate().toISOString() : (data.timestamp || new Date().toISOString());
      return { id: d.id, ...data, timestamp: ts };
    });
    if (rows.length) saveJSON(AUDIT_LOG_CACHE_KEY, rows);
    return rows.length ? rows : loadJSON(AUDIT_LOG_CACHE_KEY, []);
  } catch (err) { console.warn("Failed to load audit log:", err.code); return loadJSON(AUDIT_LOG_CACHE_KEY, []); }
}

/* ============================ CLIENT MASTER RECORD ============================
   Every write below updates the "clients" doc (the record you manage here) and mirrors the
   subset of fields the shop's own app cares about into the matching "activations" doc — see the
   file-level comment at the top for the exact contract. bizId is stable for a shop's whole
   lifetime; pass an existing bizId (e.g. when adopting an Unregistered Activation) to attach a
   managed record to a shop that already exists in "activations". */
async function mirrorToActivation(bizId, patch) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return;
  try {
    await licenseActivationsCollection().doc(bizId).set({ bizId, updatedAt: firebase.firestore.FieldValue.serverTimestamp(), ...patch }, { merge: true });
  } catch (err) { console.warn("Activation mirror failed:", err.code); }
}
async function cloudFetchClients() {
  if (!CLOUD_ENABLED || !fbDb) return [];
  try {
    const snap = await clientsCollection().orderBy("createdAt", "desc").limit(500).get();
    return snap.docs.map(d => ({ id: d.id, ...d.data() }));
  } catch (err) { console.warn("Failed to load clients:", err.code); return []; }
}
async function cloudCreateClient({ bizId, shopName, phone, businessType, username, passwordHash, tier, expiresAt, licenseKey }) {
  if (!CLOUD_ENABLED || !fbDb) return null;
  const id = bizId || uid("biz");
  try {
    await clientsCollection().doc(id).set({
      bizId: id, shopName: shopName || "", phone: phone || "", businessType, businessTypeLocked: true,
      username, passwordHash, tier, blocked: false, expiresAt: expiresAt || null, licenseKey: licenseKey || "",
      featureOverrides: {}, totalRevenue: 0, createdAt: firebase.firestore.FieldValue.serverTimestamp(), updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true });
    await mirrorToActivation(id, { bizName: shopName || "", businessType, businessTypeLocked: true, isPremium: tier !== "free", blocked: false, expiresAt: expiresAt || null });
    writeAuditLog("Client created", shopName, businessTypeLabel(businessType) + " \u00b7 " + capitalize(tier));
    return id;
  } catch (err) { console.warn("Client creation failed:", err.code); return null; }
}
async function cloudUpdateClientPlan(bizId, shopName, tier, expiresAt) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return false;
  try {
    await clientsCollection().doc(bizId).set({ tier, expiresAt: expiresAt || null, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    await mirrorToActivation(bizId, { isPremium: tier !== "free", expiresAt: expiresAt || null });
    writeAuditLog("Plan changed", shopName, capitalize(tier) + (expiresAt ? " until " + new Date(expiresAt).toLocaleDateString() : (tier === "free" ? "" : " (lifetime)")));
    return true;
  } catch (err) { console.warn("Plan update failed:", err.code); return false; }
}
/* ============================ PLAN REQUESTS (shop asks, you approve) ============================
   A shop's own app (shop-erp-cloud.html, Settings -> License & Subscription -> Request a Plan) can
   write a doc here instead of the shop needing a key handed to them first. Approving one here grants
   the plan through the exact same cloudUpdateClientPlan path Grant/Revoke already uses, then marks
   the request resolved so the shop's app (which listens to that one doc) shows the outcome. */
async function cloudFetchPlanRequests() {
  if (!CLOUD_ENABLED || !fbDb) return [];
  try {
    const snap = await planRequestsCollection().orderBy("requestedAt", "desc").limit(100).get();
    return snap.docs.map(d => {
      const data = d.data();
      const ts = data.requestedAt && data.requestedAt.toDate ? data.requestedAt.toDate().toISOString() : (data.requestedAt || new Date().toISOString());
      return { id: d.id, ...data, requestedAt: ts };
    });
  } catch (err) { console.warn("Failed to load plan requests:", err.code); return []; }
}
async function cloudResolvePlanRequest(req, approve, resolvedNote) {
  if (!CLOUD_ENABLED || !fbDb || !req.id) return false;
  try {
    if (approve) {
      const opt = DURATION_OPTIONS.find(o => o.id === req.requestedDuration);
      const expiresAt = opt && opt.days != null ? new Date(Date.now() + opt.days * 86400000).toISOString() : null;
      await cloudUpdateClientPlan(req.bizId, req.bizName, req.requestedTier, expiresAt);
    }
    await planRequestsCollection().doc(req.id).set({
      status: approve ? "approved" : "declined", resolvedNote: resolvedNote || "",
      resolvedAt: firebase.firestore.FieldValue.serverTimestamp(),
    }, { merge: true });
    writeAuditLog(approve ? "Plan request approved" : "Plan request declined", req.bizName, capitalize(req.requestedTier) + (req.requestedDuration ? " \u00b7 " + req.requestedDuration : ""));
    return true;
  } catch (err) { console.warn("Plan request resolution failed:", err.code); return false; }
}
async function cloudUpdateBusinessType(bizId, shopName, businessType) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return false;
  try {
    await clientsCollection().doc(bizId).set({ businessType, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    await mirrorToActivation(bizId, { businessType });
    writeAuditLog("Business Type changed", shopName, businessTypeLabel(businessType));
    return true;
  } catch (err) { console.warn("Business Type update failed:", err.code); return false; }
}
async function cloudSetBusinessTypeLock(bizId, shopName, locked) {

/* ============================ CHANGE PASSWORD MODAL ============================
   Saves the new hash to localStorage (PASSWORD_HASH_KEY), which loadPasswordHash() already
   prefers over DEFAULT_PASSWORD_HASH — so this is the in-app equivalent of the manual
   console+file-edit method described in the header comment above, no code editing needed. */
function ChangePasswordModal({ onClose }) {
  const [current, setCurrent] = useState("");
  const [next, setNext] = useState("");
  const [confirmNext, setConfirmNext] = useState("");
  const [error, setError] = useState("");
  const [saving, setSaving] = useState(false);
  const [done, setDone] = useState(false);
  async function submit() {
    setError("");
    if (!(await verifyPassword(current))) { setError("Current password is incorrect."); return; }
    if (next.length < 8) { setError("New password must be at least 8 characters."); return; }
    if (next !== confirmNext) { setError("New password and confirmation don't match."); return; }
    setSaving(true);
    const hash = await sha256Hex(next);
    try { localStorage.setItem(PASSWORD_HASH_KEY, hash); } catch (e) {}
    setSaving(false);
    setDone(true);
  }
  return (
    <Modal title="Change Password" onClose={onClose}>
      {done ? (
        <div className="space-y-3">
          <div className="text-sm text-emerald-400">Password updated. Use it next time you unlock this dashboard.</div>
          <button onClick={onClose} className="w-full bg-amber-500 hover:bg-amber-400 text-slate-900 text-sm font-semibold px-4 py-2.5 rounded-lg">Done</button>
        </div>
      ) : (
        <div className="space-y-3">
          <Field label="Current Password"><TextInput type="password" autoFocus value={current} onChange={e => { setCurrent(e.target.value); setError(""); }} /></Field>
          <Field label="New Password"><TextInput type="password" value={next} onChange={e => { setNext(e.target.value); setError(""); }} /></Field>
          <Field label="Confirm New Password"><TextInput type="password" value={confirmNext} onChange={e => { setConfirmNext(e.target.value); setError(""); }} /></Field>
          {error && <div className="text-xs text-rose-400">{error}</div>}
          <button disabled={saving || !current || !next || !confirmNext} onClick={submit} className="w-full bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-slate-900 text-sm font-semibold px-4 py-2.5 rounded-lg">{saving ? "Saving\u2026" : "Save New Password"}</button>
        </div>
      )}
    </Modal>
  );
}

/* ============================ LOGIN GATE ============================ */
function PasswordGate({ onUnlock }) {
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [checking, setChecking] = useState(false);
  const [googleBusy, setGoogleBusy] = useState(false);
  async function submit(e) {
    e.preventDefault();
    setChecking(true);
    const ok = await verifyPassword(password);
    setChecking(false);
    if (!ok) { setError("Incorrect password."); return; }
    unlockSession();
    onUnlock();
  }
  async function submitGoogle() {
    setError("");
    setGoogleBusy(true);
    const result = await attemptGoogleSignIn();
    setGoogleBusy(false);
    if (!result.ok) { if (result.error) setError(result.error); return; }
    unlockSession();
    onUnlock();
  }
  return (
    <div className="min-h-screen flex items-center justify-center bg-slate-950 px-4">
      <form onSubmit={submit} className="w-full max-w-sm bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div className="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-xl mb-3">{"\u{1F6E0}\uFE0F"}</div>
        <h1 className="text-white font-bold text-lg mb-1">Anjum Webs POS</h1>
        <p className="text-slate-400 text-sm mb-4">Developer Dashboard — enter your password to continue.</p>
        <TextInput type="password" autoFocus placeholder="Password" value={password} onChange={e => { setPassword(e.target.value); setError(""); }} />
        {error && <div className="text-xs text-rose-400 mt-2">{error}</div>}
        <button type="submit" disabled={checking || !password} className="w-full mt-4 bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-slate-900 text-sm font-semibold px-4 py-2.5 rounded-lg transition">{checking ? "Checking\u2026" : "Unlock"}</button>
        {GOOGLE_AUTH_ENABLED && (
          <>
            <div className="flex items-center gap-2 my-4"><div className="flex-1 h-px bg-slate-800" /><span className="text-[11px] text-slate-500">OR</span><div className="flex-1 h-px bg-slate-800" /></div>
            <button type="button" disabled={googleBusy} onClick={submitGoogle} className="w-full flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 text-slate-200 text-sm font-medium px-4 py-2.5 rounded-lg transition">
              <span>{"\u{1F510}"}</span>{googleBusy ? "Signing in\u2026" : "Sign in with Google"}
            </button>
          </>
        )}
      </form>
    </div>
  );
}


const GOOGLE_AUTH_ENABLED = CLOUD_ENABLED && !!(window.firebase && firebase.auth) && AUTHORIZED_DEV_EMAILS.length > 0;
async function attemptGoogleSignIn() {
  if (!GOOGLE_AUTH_ENABLED) return { ok: false, error: "Google sign-in isn't set up yet for this dashboard." };
  try {
    const provider = new firebase.auth.GoogleAuthProvider();

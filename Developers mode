  try {
    await clientsCollection().doc(bizId).set({ businessTypeLocked: locked, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    await mirrorToActivation(bizId, { businessTypeLocked: locked });
    writeAuditLog(locked ? "Business Type locked" : "Business Type unlocked", shopName, "");
    return true;
  } catch (err) { console.warn("Lock toggle failed:", err.code); return false; }
}
async function cloudSetBlocked(bizId, shopName, blocked) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return false;
  try {
    await clientsCollection().doc(bizId).set({ blocked, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    await mirrorToActivation(bizId, { blocked });
    writeAuditLog(blocked ? "Shop suspended" : "Shop activated", shopName, "");
    return true;
  } catch (err) { console.warn("Suspend/activate failed:", err.code); return false; }
}
async function cloudResetClientPassword(bizId, shopName, passwordHash) {
  if (!CLOUD_ENABLED || !fbDb || !bizId) return false;
  try {
    await clientsCollection().doc(bizId).set({ passwordHash, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
    writeAuditLog("Password reset", shopName, "");

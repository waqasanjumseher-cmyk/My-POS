/* Groups a list of inventory items into an item-wise / variant-wise breakdown: items are grouped
   by category, then within each category by the combination of item name + brand + model + specs
   + color — so "iPhone 13" in Midnight and Blue count separately, and a "43-inch" LCD (typed into
   the item name or the appliance Specs field) is distinguished from a "32-inch" one of the same
   brand, without needing a dedicated "size" field on every category. */
function stockVariantKey(i) {
  return [i.category, i.itemName, i.brand, i.model, i.specs, i.color].map(v => (v || "").trim().toLowerCase()).join("\u241F");
}
function buildStockSummary(items) {
  const groups = {};
  items.forEach(i => {
    const key = stockVariantKey(i);
    if (!groups[key]) {
      groups[key] = { category: i.category || "Other", itemName: i.itemName || "(unnamed)", brand: i.brand || "", model: i.model || "", specs: i.specs || "", color: i.color || "", count: 0, purchaseValue: 0, retailValue: 0 };
    }
    const qty = Number(i.quantity) || 1;
    groups[key].count += qty;
    groups[key].purchaseValue += (Number(i.purchasePrice) || 0) * qty;
    groups[key].retailValue += (Number(i.retailPrice) || 0) * qty;
  });
  const rows = Object.values(groups);
  const byCategory = {};
  rows.forEach(r => { (byCategory[r.category] = byCategory[r.category] || []).push(r); });
  Object.keys(byCategory).forEach(cat => byCategory[cat].sort((a, b) => b.count - a.count || a.itemName.localeCompare(b.itemName)));
  const categoryOrder = Object.keys(byCategory).sort((a, b) => {
    const totalA = byCategory[a].reduce((s, r) => s + r.count, 0);
    const totalB = byCategory[b].reduce((s, r) => s + r.count, 0);
    return totalB - totalA;
  });
  return { byCategory, categoryOrder };
}

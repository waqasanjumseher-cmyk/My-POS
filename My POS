function blankDealer() { return { name: "", contactPerson: "", phone: "", city: "" }; }
function dealerBalance(data, dealerId) {
  const purch = data.purchases.filter(p => p.dealerId === dealerId).reduce((s, p) => s + (Number(p.totalAmount) || 0) - (Number(p.cashPaid) || 0) - (Number(p.onlinePaid) || 0), 0);
  const pay = data.dealerPayments.filter(p => p.dealerId === dealerId).reduce((s, p) => s + (Number(p.amount) || 0), 0);
  return purch - pay;
}
function DealersTab({ data, setData, role, can }) {
  const canAdd = can("add"), canEdit = can("edit"), canDelete = can("delete");
  const [showForm, setShowForm] = useState(false);
  const [editing, setEditing] = useState(null);
  const [dealer, setDealer] = useState(blankDealer());
  const [ledgerDealer, setLedgerDealer] = useState(null);
  const [deleting, setDeleting] = useState(null);
  const [payAmount, setPayAmount] = useState("");
  const [payAccount, setPayAccount] = useState((data.accounts[0] && data.accounts[0].id) || "");
  const [payRef, setPayRef] = useState("");
  const [payNote, setPayNote] = useState("");

  function openAdd() { setDealer(blankDealer()); setEditing(null); setShowForm(true); }
  function openEdit(d) { setDealer(d); setEditing(d.id); setShowForm(true); }
  function submit() {
    if (!dealer.name.trim()) { alert("Dealer name required"); return; }
    if (editing) setData({ ...data, dealers: data.dealers.map(d => d.id === editing ? { ...dealer, id: editing } : d) });
    else setData({ ...data, dealers: [...data.dealers, { ...dealer, id: uid("dealer") }] });
    setShowForm(false);
  }
  function doDelete() { setData({ ...data, dealers: data.dealers.filter(d => d.id !== deleting.id) }); setDeleting(null); }
  function recordPayment() {
    if (!payAmount || Number(payAmount) <= 0) { alert("Enter a valid amount"); return; }
    const acc = data.accounts.find(a => a.id === payAccount);
    const entry = { id: uid("pay"), dealerId: ledgerDealer.id, amount: Number(payAmount), method: acc ? acc.type : "Cash", accountId: payAccount, bankRef: payRef, note: payNote, date: todayISO() };
    setData({ ...data, dealerPayments: [...data.dealerPayments, entry] });
    setPayAmount(""); setPayNote(""); setPayRef("");
  }
  const [deletingPay, setDeletingPay] = useState(null);
  function doDeletePay() { setData({ ...data, dealerPayments: data.dealerPayments.filter(p => p.id !== deletingPay.id) }); setDeletingPay(null); }
  const ledgerRows = useMemo(() => {
    if (!ledgerDealer) return [];
    const purch = data.purchases.filter(p => p.dealerId === ledgerDealer.id).map(p => ({ kind: "purchase", type: "Purchase", date: p.date, ref: p.invoiceNumber, debit: Number(p.totalAmount) || 0, credit: (Number(p.cashPaid) || 0) + (Number(p.onlinePaid) || 0) }));
    const pays = data.dealerPayments.filter(p => p.dealerId === ledgerDealer.id).map(p => {
      const acc = data.accounts.find(a => a.id === p.accountId);
      return { kind: "payment", id: p.id, raw: p, type: "Payment (" + (acc ? acc.name : p.method) + ")", date: p.date, ref: p.note || p.bankRef || "-", debit: 0, credit: Number(p.amount) || 0 };
    });
    const all = [...purch, ...pays].sort((a, b) => (a.date || "").localeCompare(b.date || ""));
    let running = 0;
    return all.map(r => { running += r.debit - r.credit; return { ...r, running }; });
  }, [data, ledgerDealer]);

  return (
    <div>
      <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h2 className="text-lg font-semibold text-slate-800"><Bi en="Dealer / Supplier Ledger" ur="ڈیلر کھاتہ" /></h2>
        {canAdd && <button onClick={openAdd} className="bg-[var(--accent-600)] hover:bg-[var(--accent-700)] text-white text-sm font-medium px-4 py-2 rounded-lg">+ Add Dealer / نیا ڈیلر</button>}

          </div>
        </Modal>
      )}
      {deleting && (
        <Modal title="Delete Purchase Invoice?" onClose={() => setDeleting(null)}>
          <p className="text-sm text-slate-600">Delete invoice <b>{deleting.invoiceNumber}</b>? This will also remove its {deleting.items.length} linked stock item(s) from Inventory. This cannot be undone.</p>
          <ConfirmBar onCancel={() => setDeleting(null)} onConfirm={doDeleteInvoice} />
        </Modal>
      )}
      {viewing && (
        <Modal title={"Invoice " + viewing.invoiceNumber} onClose={() => setViewing(null)} wide>
          <div className="text-sm space-y-1 mb-3">
            <div>Dealer: <b>{data.dealers.find(d => d.id === viewing.dealerId)?.name || "-"}</b></div>
            <div>Date: {fmtDate(viewing.date)}</div>
            <div>Total: {fmtMoney(viewing.totalAmount)} | Cash: {fmtMoney(viewing.cashPaid)} | Online: {fmtMoney(viewing.onlinePaid)}</div>
          </div>
          <div className="border border-slate-200 rounded-lg overflow-x-auto">
            <table className="w-full text-xs">
              <thead className="bg-slate-50 text-slate-500 uppercase"><tr><th className="text-left px-2 py-1">Item</th><th className="text-left px-2 py-1">IMEI 1</th><th className="text-left px-2 py-1">Status</th></tr></thead>
              <tbody>{data.inventory.filter(i => viewing.items.includes(i.id)).map(i => (<tr key={i.id} className="border-t border-slate-100"><td className="px-2 py-1">{i.itemName}</td><td className="px-2 py-1 font-mono">{i.imei1 || "-"}</td><td className="px-2 py-1"><StatusBadge status={i.status} /></td></tr>))}</tbody>
            </table>
          </div>
        </Modal>
      )}
    </div>
  );
}

/* ============================ CUSTOM ITEMS / CATEGORIES TAB ============================ */
function blankPreset() { return { name: "", category: "Mobile", brand: "", model: "", ram: "", storage: "", color: "", purchasePrice: "", retailPrice: "", minPrice: "" }; }
function CustomItemsTab({ data, setData, role, can }) {
  const canAdd = can("add"), canEdit = can("edit"), canDelete = can("delete");
  const [newCategory, setNewCategory] = useState("");
  const [preset, setPreset] = useState(blankPreset());
  const [editingPreset, setEditingPreset] = useState(null);
  const [deletingPreset, setDeletingPreset] = useState(null);
  const [deletingCategory, setDeletingCategory] = useState(null);

  function addCategory() {
    const name = newCategory.trim();
    if (!name) { alert("Enter a category name"); return; }
    if (CATEGORIES.includes(name) || (data.customCategories || []).includes(name)) { alert("This category already exists."); return; }
    setData({ ...data, customCategories: [...(data.customCategories || []), name] });
    setNewCategory("");
  }
  function removeCategory(name) { setData({ ...data, customCategories: (data.customCategories || []).filter(c => c !== name) }); setDeletingCategory(null); }
  function openAddPreset() { setPreset(blankPreset()); setEditingPreset(null); }
  function openEditPreset(p) { setPreset(p); setEditingPreset(p.id); }
  function savePreset() {
    if (!preset.name.trim()) { alert("Preset name is required"); return; }
    if (editingPreset) setData({ ...data, customItemPresets: (data.customItemPresets || []).map(p => p.id === editingPreset ? { ...preset, id: editingPreset } : p) });
    else setData({ ...data, customItemPresets: [...(data.customItemPresets || []), { ...preset, id: uid("preset") }] });
    setPreset(blankPreset()); setEditingPreset(null);
  }
  function doDeletePreset() { setData({ ...data, customItemPresets: (data.customItemPresets || []).filter(p => p.id !== deletingPreset.id) }); setDeletingPreset(null); }

  return (
    <div>
      <h3 className="text-sm font-semibold text-slate-700 mb-1">Custom Items & Categories <span className="urdu text-slate-400 text-xs">/ اپنی مرضی کے آئٹمز</span></h3>
      <p className="text-xs text-slate-500 mb-4">Add your own product categories and reusable item presets/templates for anything not already built into the system. These become available immediately across Inventory and Purchases.</p>

      <div className="bg-white rounded-xl border border-slate-200 p-4 mb-6">
        <h3 className="text-sm font-semibold text-slate-700 mb-3">Custom Categories <span className="urdu text-slate-400 text-xs">/ اپنی قسمیں</span></h3>
        {canAdd && (
          <div className="flex flex-wrap gap-2 mb-3">
            <TextInput value={newCategory} onChange={e => setNewCategory(e.target.value)} placeholder="e.g. Washing Machine, Kitchen Appliance..." className="max-w-xs" />
            <button onClick={addCategory} className="bg-[var(--accent-600)] hover:bg-[var(--accent-700)] text-white text-sm font-medium px-4 py-2 rounded-lg">+ Add Category</button>
          </div>
        )}
        <div className="flex flex-wrap gap-2">
          {CATEGORIES.map(c => (<span key={c} className="text-xs bg-slate-100 text-slate-500 px-2.5 py-1 rounded-full">{c} <span className="text-slate-400">(built-in)</span></span>))}
          {(data.customCategories || []).map(c => (
            <span key={c} className="text-xs bg-[var(--accent-50)] text-[var(--accent-700)] px-2.5 py-1 rounded-full flex items-center gap-1.5">
              {c}
              {canDelete && <button onClick={() => setDeletingCategory(c)} title="Remove" className="text-[var(--accent-400)] hover:text-rose-600 font-bold">&times;</button>}
            </span>
          ))}
          {(data.customCategories || []).length === 0 && <span className="text-xs text-slate-400">No custom categories added yet.</span>}
        </div>
      </div>

      <div className="bg-white rounded-xl border border-slate-200 p-4">
        <h3 className="text-sm font-semibold text-slate-700 mb-3">Custom Item Presets / Product Templates</h3>
        {(canAdd || canEdit) && (
          <div className="bg-slate-50 rounded-lg p-3 mb-4">
            <div className="grid grid-cols-1 md:grid-cols-3 gap-x-4">
              <Field label="Preset Name" ur="نام" required><TextInput value={preset.name} onChange={e => setPreset({ ...preset, name: e.target.value })} placeholder="e.g. Dawlance Washing Machine 8kg" /></Field>
              <Field label="Category" ur="قسم"><Select value={preset.category} onChange={e => setPreset({ ...preset, category: e.target.value })} options={allCategories(data)} /></Field>
              <Field label="Brand" ur="برانڈ"><TextInput value={preset.brand} onChange={e => setPreset({ ...preset, brand: e.target.value })} /></Field>
              <Field label="Model" ur="ماڈل"><TextInput value={preset.model} onChange={e => setPreset({ ...preset, model: e.target.value })} /></Field>
              <Field label="RAM / Storage (if applicable)" ur="ریم / اسٹوریج"><div className="flex gap-2"><TextInput value={preset.ram} onChange={e => setPreset({ ...preset, ram: e.target.value })} placeholder="RAM" /><TextInput value={preset.storage} onChange={e => setPreset({ ...preset, storage: e.target.value })} placeholder="Storage" /></div></Field>
              <Field label="Color" ur="رنگ"><TextInput value={preset.color} onChange={e => setPreset({ ...preset, color: e.target.value })} /></Field>
              <Field label="Default Purchase Price" ur="خرید قیمت"><TextInput type="number" value={preset.purchasePrice} onChange={e => setPreset({ ...preset, purchasePrice: e.target.value })} /></Field>
              <Field label="Default Retail Price" ur="فروخت قیمت"><TextInput type="number" value={preset.retailPrice} onChange={e => setPreset({ ...preset, retailPrice: e.target.value })} /></Field>
              <Field label="Default Minimum Price" ur="کم از کم قیمت"><TextInput type="number" value={preset.minPrice} onChange={e => setPreset({ ...preset, minPrice: e.target.value })} /></Field>
            </div>
            <div className="flex gap-2 mt-2">
              {(editingPreset ? canEdit : canAdd) && <button onClick={savePreset} className="bg-slate-700 hover:bg-slate-800 text-white text-sm px-3 py-1.5 rounded-lg">{editingPreset ? "Update Preset" : "+ Add Preset"}</button>}
              {editingPreset && <button onClick={openAddPreset} className="px-3 py-1.5 text-sm rounded-lg border border-slate-300 text-slate-600">Cancel Edit</button>}
            </div>
          </div>
        )}
        <div className="border border-slate-200 rounded-lg overflow-x-auto">
          <table className="w-full text-sm">
            <thead className="bg-slate-50 text-slate-500 uppercase text-xs"><tr><th className="text-left px-3 py-2">Preset</th><th className="text-left px-3 py-2">Category</th><th className="text-left px-3 py-2">Brand/Model</th><th className="text-left px-3 py-2">Retail Price</th><th className="text-left px-3 py-2">Actions</th></tr></thead>
            <tbody>
              {(data.customItemPresets || []).map(p => (
                <tr key={p.id} className="border-t border-slate-100 hover:bg-slate-50">
                  <td className="px-3 py-2 font-medium text-slate-800">{p.name}</td>
                  <td className="px-3 py-2">{p.category}</td>
                  <td className="px-3 py-2">{p.brand} {p.model}</td>
                  <td className="px-3 py-2">{fmtMoney(p.retailPrice)}</td>
                  <td className="px-3 py-2">
                    <div className="flex gap-2">
                      {canEdit && <button onClick={() => openEditPreset(p)} title="Edit" className="text-slate-500 hover:text-[var(--accent-600)]">&#9998;</button>}
                      {canDelete && <button onClick={() => setDeletingPreset(p)} title="Delete" className="text-slate-500 hover:text-rose-600">&#128465;</button>}
                    </div>
                  </td>
                </tr>
              ))}
              {(data.customItemPresets || []).length === 0 && <tr><td colSpan="5" className="text-center text-slate-400 py-8">No custom item presets yet. Add one above to quick-fill items in Inventory/Purchases.</td></tr>}
            </tbody>
          </table>
        </div>
      </div>

      {deletingCategory && (
        <Modal title="Delete Category?" onClose={() => setDeletingCategory(null)}>
          <p className="text-sm text-slate-600">Remove custom category <b>{deletingCategory}</b>? Existing items already using it will keep showing it, but it will no longer appear in dropdowns.</p>
          <ConfirmBar onCancel={() => setDeletingCategory(null)} onConfirm={() => removeCategory(deletingCategory)} />
        </Modal>
      )}
      {deletingPreset && (
        <Modal title="Delete Preset?" onClose={() => setDeletingPreset(null)}>
          <p className="text-sm text-slate-600">Delete preset <b>{deletingPreset.name}</b>? This cannot be undone.</p>
          <ConfirmBar onCancel={() => setDeletingPreset(null)} onConfirm={doDeletePreset} />
        </Modal>
      )}
    </div>
  );
}

/* ============================ INSTALLMENT PANEL (shared) ============================ */
function InstallmentPanel({ data, setData, sale, biz, currentUserName, can }) {
  const canAdd = can ? can("add") : true, canEdit = can ? can("edit") : true, canDelete = can ? can("delete") : true;
  const items = saleItemsSummary(sale, data);
  const customer = data.customers.find(c => c.id === sale.customerId) || (sale.customerPhone ? { name: sale.customerName, phone: sale.customerPhone } : null);
  const credit = saleCredit(sale);
  const next = nextDueInfo(sale);
  const paidMonths = (sale.installmentPayments || []).filter(p => p.type === "payment" && p.month).map(p => p.month);
  const remainingMonths = (sale.installmentPlan || []).filter(pl => !paidMonths.includes(pl.month));

  const [showPay, setShowPay] = useState(false);
  const [payMonth, setPayMonth] = useState(remainingMonths[0] ? String(remainingMonths[0].month) : "");
  const [payAmount, setPayAmount] = useState(remainingMonths[0] ? String(remainingMonths[0].amount) : "");
  const [payReceipt, setPayReceipt] = useState("");
  const [payDate, setPayDate] = useState(todayISO());
  const [payAccount, setPayAccount] = useState((data.accounts[0] && data.accounts[0].id) || "");
  const [payRef, setPayRef] = useState("");
  const [payPhoto, setPayPhoto] = useState("");
  const [showDiscount, setShowDiscount] = useState(false);
  const [discAmount, setDiscAmount] = useState("");
  const [discNote, setDiscNote] = useState("");
  const [editingPaymentId, setEditingPaymentId] = useState(null);
  const [deletingPayment, setDeletingPayment] = useState(null);
  const [viewingPhoto, setViewingPhoto] = useState("");
  const [showImageReceipt, setShowImageReceipt] = useState(false);
  const [showImageReminder, setShowImageReminder] = useState(false);
  const pdfNodeRef = useRef(null);

  function submitPayment() {
    if (!payAmount || Number(payAmount) <= 0) { alert("Enter valid amount"); return; }
    if (editingPaymentId) {
      setData({ ...data, sales: data.sales.map(s => s.id === sale.id ? { ...s, installmentPayments: s.installmentPayments.map(p => p.id === editingPaymentId ? { ...p, month: payMonth ? Number(payMonth) : null, amount: Number(payAmount), manualReceiptNumber: payReceipt, date: payDate, accountId: payAccount, bankRef: payRef, photo: payPhoto } : p) } : s) });
    } else {
      const entry = { id: uid("ip"), type: "payment", month: payMonth ? Number(payMonth) : null, amount: Number(payAmount), manualReceiptNumber: payReceipt, date: payDate, accountId: payAccount, bankRef: payRef, photo: payPhoto, collectedBy: currentUserName };
      setData({ ...data, sales: data.sales.map(s => s.id === sale.id ? { ...s, installmentPayments: [...(s.installmentPayments || []), entry] } : s) });
    }
    setShowPay(false); setEditingPaymentId(null); setPayAmount(""); setPayReceipt(""); setPayRef(""); setPayPhoto("");
  }
  function submitDiscount() {
    if (!discAmount || Number(discAmount) <= 0) { alert("Enter valid amount"); return; }
    const entry = { id: uid("disc"), type: "discount", amount: Number(discAmount), note: discNote, date: todayISO(), collectedBy: currentUserName };
    setData({ ...data, sales: data.sales.map(s => s.id === sale.id ? { ...s, installmentPayments: [...(s.installmentPayments || []), entry] } : s) });
    setShowDiscount(false); setDiscAmount(""); setDiscNote("");
  }
  function startEditPayment(p) {
    setEditingPaymentId(p.id); setPayMonth(p.month ? String(p.month) : ""); setPayAmount(String(p.amount)); setPayReceipt(p.manualReceiptNumber || ""); setPayDate(p.date || todayISO()); setPayAccount(p.accountId || (data.accounts[0] && data.accounts[0].id) || ""); setPayRef(p.bankRef || ""); setPayPhoto(p.photo || ""); setShowPay(true); setShowDiscount(false);
  }
  function doDeletePayment() {
    setData({ ...data, sales: data.sales.map(s => s.id === sale.id ? { ...s, installmentPayments: s.installmentPayments.filter(p => p.id !== deletingPayment.id) } : s) });
    setDeletingPayment(null);
  }
  const waReceiptLink = customer && customer.phone ? waLink(customer.phone, buildReceiptMessage(biz, sale, items, customer)) : null;
  const dueInfo = next ? { next, overdue: new Date(next.dueDate) < new Date(todayISO()) } : null;
  const waReminderLink = customer && customer.phone ? waLink(customer.phone, buildReminderMessage(biz, sale, items, customer, dueInfo)) : null;

  return (
    <div className="bg-slate-50 border border-slate-200 rounded-lg p-3 mt-2 text-sm">
      <div className="flex flex-wrap gap-4 mb-2">
        <div>Remaining: <b className={credit.remaining > 0 ? "text-amber-600" : "text-emerald-600"}>{fmtMoney(credit.remaining)}</b></div>
        {next && <div>Next Due: <b>{fmtDate(next.dueDate)}</b> (Installment {next.month}, {fmtMoney(next.amount)})</div>}
        {credit.discountGiven > 0 && <div>Discount Given: {fmtMoney(credit.discountGiven)}</div>}
      </div>

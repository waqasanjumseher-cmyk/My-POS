      </div>
      <div className="bg-white rounded-xl border border-slate-200 overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="bg-slate-50 text-slate-500 uppercase text-xs"><tr><th className="text-left px-3 py-2">Date</th><th className="text-left px-3 py-2">Dealer</th><th className="text-left px-3 py-2">Invoice #</th><th className="text-left px-3 py-2">Total</th><th className="text-left px-3 py-2">Paid</th><th className="text-left px-3 py-2">Remaining</th><th className="text-left px-3 py-2">Items</th><th className="text-left px-3 py-2">Actions</th></tr></thead>
          <tbody>
            {[...data.purchases].sort((a, b) => (b.date || "").localeCompare(a.date || "")).map(p => {
              const paid = (Number(p.cashPaid) || 0) + (Number(p.onlinePaid) || 0);
              const rem = (Number(p.totalAmount) || 0) - paid;
              return (
                <tr key={p.id} className="border-t border-slate-100 hover:bg-slate-50">
                  <td className="px-3 py-2">{fmtDate(p.date)}</td><td className="px-3 py-2">{data.dealers.find(d => d.id === p.dealerId)?.name || "-"}</td><td className="px-3 py-2">{p.invoiceNumber}</td>
                  <td className="px-3 py-2">{fmtMoney(p.totalAmount)}</td><td className="px-3 py-2">{fmtMoney(paid)}</td>
                  <td className={"px-3 py-2 font-medium " + (rem > 0 ? "text-rose-600" : "text-emerald-600")}>{fmtMoney(rem)}</td>
                  <td className="px-3 py-2">{p.items.length}</td>
                  <td className="px-3 py-2">
                    <div className="flex gap-2">
                      <button onClick={() => setViewing(p)} title="View" className="text-slate-500 hover:text-[var(--accent-600)]">&#128065;</button>
                      {canEdit && <button onClick={() => openEditInvoice(p)} title="Edit" className="text-slate-500 hover:text-[var(--accent-600)]">&#9998;</button>}
                      {canDelete && <button onClick={() => setDeleting(p)} title="Delete" className="text-slate-500 hover:text-rose-600">&#128465;</button>}
                    </div>
                  </td>
                </tr>
              );
            })}
            {data.purchases.length === 0 && <tr><td colSpan="8" className="text-center text-slate-400 py-8">No purchase invoices yet</td></tr>}
          </tbody>
        </table>
      </div>
      {showForm && (
        <Modal title={editingInvoice ? "Edit Purchase Invoice" : "New Purchase Invoice"} ur="بل" onClose={() => { setShowForm(false); resetForm(); }} wide>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-x-4">
            <Field label="Dealer" ur="ڈیلر" required><Select value={dealerId} onChange={e => setDealerId(e.target.value)} options={[{ value: "", label: "-- Select --" }, ...data.dealers.map(d => ({ value: d.id, label: d.name }))]} /></Field>
            <Field label="Dealer Bill / Invoice Number" ur="بل نمبر" required><TextInput value={invoiceNumber} onChange={e => setInvoiceNumber(e.target.value)} /></Field>
            <Field label="Date" ur="تاریخ"><TextInput type="date" value={date} onChange={e => setDate(e.target.value)} /></Field>
            <Field label="Total Bill Amount" ur="کل رقم" required>
              <TextInput type="number" value={totalAmount} onChange={e => { setTotalAmount(e.target.value); setTotalAutoSynced(false); }} />

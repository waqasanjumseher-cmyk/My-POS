   preset list (or doesn't fit one) define its own business name, its own category list, and which
   of the 4 accessory keys (if any) apply — saved to CUSTOM_OTHER_PROFILE_KEY and read by
   allCategories()/getBusinessAccessoryOptions() the same way every preset business type is. */
function CustomOtherBusinessEditor() {
  const [profile, setProfile] = useState(loadOtherBusinessProfile);
  const [newCat, setNewCat] = useState("");
  function persist(next) { setProfile(next); saveJSON(CUSTOM_OTHER_PROFILE_KEY, next); }
  function addCategory() {
    const name = newCat.trim();
    if (!name || profile.categories.includes(name)) return;
    persist({ ...profile, categories: [...profile.categories, name] });
    setNewCat("");
  }
  function removeCategory(cat) { persist({ ...profile, categories: profile.categories.filter(c => c !== cat) }); }
  function toggleAccessory(key, label, checked) {
    const next = checked ? [...profile.accessories, { key, label }] : profile.accessories.filter(a => a.key !== key);
    persist({ ...profile, accessories: next });
  }
  const ACCESSORY_CHOICES = [{ key: "box", defaultLabel: "Box / Packaging" }, { key: "charger", defaultLabel: "Charger" }, { key: "cable", defaultLabel: "Cable" }, { key: "warranty", defaultLabel: "Warranty Card" }];

  return (
    <div className="rounded-lg border-2 border-dashed border-[var(--accent-300,var(--accent-200))] p-4 space-y-4">
      <h4 className="text-xs font-semibold text-slate-600 uppercase tracking-wide">Customize Your Business <span className="text-slate-400 normal-case font-normal">— for a trade not listed above</span></h4>

      <div>
        <label className="text-xs text-slate-500 block mb-1">Business Name (shown in the dropdown)</label>
        <input type="text" value={profile.label} onChange={e => persist({ ...profile, label: e.target.value })} className="w-full sm:w-80 border border-slate-300 rounded-lg px-3 py-2 text-sm" placeholder="e.g. Stationery Shop" />
      </div>

      <div>
        <label className="text-xs text-slate-500 block mb-1">Your Categories</label>
        <div className="flex flex-wrap gap-1.5 mb-2">
          {profile.categories.map(cat => (
            <span key={cat} className="flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
              {cat}
              <button onClick={() => removeCategory(cat)} className="text-slate-400 hover:text-rose-500" title="Remove">&#10005;</button>
            </span>
          ))}
        </div>
        <div className="flex gap-2">
          <input type="text" value={newCat} onChange={e => setNewCat(e.target.value)} onKeyDown={e => e.key === "Enter" && addCategory()} placeholder="Add a category, e.g. Notebooks" className="flex-1 border border-slate-300 rounded-lg px-3 py-1.5 text-sm" />
          <button onClick={addCategory} className="text-xs px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-800 text-white">Add</button>
        </div>
      </div>

      <div>
        <label className="text-xs text-slate-500 block mb-2">Accessories that apply to your products (leave all unchecked if none)</label>
        <div className="flex flex-wrap gap-4">
          {ACCESSORY_CHOICES.map(a => {
            const active = profile.accessories.find(x => x.key === a.key);
            return (
              <label key={a.key} className="flex items-center gap-2 text-sm text-slate-600">
                <input type="checkbox" checked={!!active} onChange={e => toggleAccessory(a.key, a.defaultLabel, e.target.checked)} className="w-4 h-4 accent-[var(--accent-600)]" />
                {a.defaultLabel}
              </label>
            );
          })}
        </div>
      </div>
    </div>
  );
}


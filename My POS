function blankUserForm() { return { username: "", password: "", name: "", email: "", role: "Sales Officer", permissions: defaultPermsForRole("Sales Officer") }; }
/* Toggles one CRUD action for one module inside a permissions object (used by both the Add/Edit
   User form and the standalone Permission Matrix). Checking "Add", "Edit", or "Delete" implicitly
   turns "View" on too (you can't add/edit/delete a module you can't see); unchecking "View" turns
   the other three off (nothing else makes sense without view access). */
function togglePermAction(perms, moduleId, action, checked) {
  const cur = perms[moduleId] || blankCrud(false);
  let next = { ...cur, [action]: checked };
  if (action === "view" && !checked) next = blankCrud(false);
  else if (action !== "view" && checked) next.view = true;
  return { ...perms, [moduleId]: next };
}

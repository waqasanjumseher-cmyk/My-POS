/* ============================ CUSTOMERS TAB ============================ */
function CustomersTab({ data, setData, role, biz, currentUserName, can }) {
  const canAdd = can("add"), canEdit = can("edit"), canDelete = can("delete");
  const [query, setQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [sort, setSort] = useState("name:asc");
  const [showForm, setShowForm] = useState(false);
  const [editing, setEditing] = useState(null);
  const [customer, setCustomer] = useState(blankCustomer());
  const [ledgerCustomer, setLedgerCustomer] = useState(null);
  const [deleting, setDeleting] = useState(null);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    let rows = data.customers.filter(c => !q || [c.name, c.phone, c.cnic].some(v => (v || "").toLowerCase().includes(q)));
    const withLedger = rows.map(c => ({ ...c, __outstanding: customerLedgerSummary(data, c.id).totalOutstanding }));
    const statusFiltered = statusFilter === "all" ? withLedger : withLedger.filter(c => statusFilter === "outstanding" ? c.__outstanding > 0 : c.__outstanding <= 0);
    return sortRows(statusFiltered, sort, { name: c => c.name || "", outstanding: c => c.__outstanding });
  }, [data.customers, data.sales, query, statusFilter, sort]);

  const customerDirty = useDirty(customer, showForm);
  function openAdd() { setCustomer(blankCustomer()); setEditing(null); setShowForm(true); }
  function openEdit(c) { setCustomer(c); setEditing(c.id); setShowForm(true); }
  function submit() {
    if (!customer.name.trim()) { alert("Customer name required"); return; }
    if (editing) setData({ ...data, customers: data.customers.map(c => c.id === editing ? { ...customer, id: editing } : c) });
    else setData({ ...data, customers: [...data.customers, { ...customer, id: uid("cust") }] });
    setShowForm(false);
  }
  function doDelete() { setData({ ...data, customers: data.customers.filter(c => c.id !== deleting.id) }); setDeleting(null); }

  const custSales = ledgerCustomer ? data.sales.filter(s => s.customerId === ledgerCustomer.id) : [];
  const totals = useMemo(() => {
    return custSales.reduce((acc, s) => {
      const credit = saleCredit(s);
      acc.purchased += Number(s.salePrice) || 0; acc.discount += (Number(s.discount) || 0) + credit.discountGiven - (Number(s.discount) || 0);
      acc.paid += credit.totalCredited; acc.remaining += Math.max(0, credit.remaining);
      return acc;
    }, { purchased: 0, discount: 0, paid: 0, remaining: 0 });
  }, [custSales]);

  const [ledgerQuery, setLedgerQuery] = useState("");
  const [ledgerFrom, setLedgerFrom] = useState("");
  const [ledgerTo, setLedgerTo] = useState("");
  const [ledgerStatus, setLedgerStatus] = useState("all");
  const [ledgerSort, setLedgerSort] = useState("date:desc");
  useEffect(() => { setLedgerQuery(""); setLedgerFrom(""); setLedgerTo(""); setLedgerStatus("all"); setLedgerSort("date:desc"); }, [ledgerCustomer]);
  const custSalesFiltered = useMemo(() => {
    const q = ledgerQuery.trim().toLowerCase();
    let rows = custSales.filter(s => {
      if (!inRange(s.date, ledgerFrom, ledgerTo)) return false;
      const remaining = saleCredit(s).remaining;
      if (ledgerStatus === "paid" && remaining > 0) return false;
      if (ledgerStatus === "pending" && remaining <= 0) return false;
      if (!q) return true;
      return [s.invoiceId, s.manualReceiptNumber, saleItemsLabel(s, data)].some(v => (v || "").toLowerCase().includes(q));
    });
    return sortRows(rows, ledgerSort, { date: s => s.date || "", amount: s => Number(s.salePrice) || 0 });
  }, [custSales, ledgerQuery, ledgerFrom, ledgerTo, ledgerStatus, ledgerSort, data]);

  return (
    <div>

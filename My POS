    return sortRows(rows, sort, { date: s => s.date || "", name: s => s.customerName || "", amount: s => Number(s.salePrice) || 0, remaining: s => saleCredit(s).remaining });
  }, [data.sales, query, data.inventory, dateFrom, dateTo, statusFilter, sort]);


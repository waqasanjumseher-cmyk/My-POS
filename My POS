/* ============================ PURCHASES TAB ============================ */
function PurchasesTab({ data, setData, role, can }) {
  const canAdd = can("add"), canEdit = can("edit"), canDelete = can("delete");
  const [showForm, setShowForm] = useState(false);
  const [editingInvoice, setEditingInvoice] = useState(null);
  const [dealerId, setDealerId] = useState("");
  const [invoiceNumber, setInvoiceNumber] = useState("");
  const [totalAmount, setTotalAmount] = useState("");
  const [totalAutoSynced, setTotalAutoSynced] = useState(true);
  const [cashPaid, setCashPaid] = useState("");
  const [onlinePaid, setOnlinePaid] = useState("");
  const [date, setDate] = useState(todayISO());
  const [pendingItems, setPendingItems] = useState([]);
  const [draftItem, setDraftItem] = useState(blankItem());
  const [viewing, setViewing] = useState(null);
  const [deleting, setDeleting] = useState(null);
  const remaining = (Number(totalAmount) || 0) - (Number(cashPaid) || 0) - (Number(onlinePaid) || 0);
  // Grand total of the "cart" — the sum of every queued item's price × quantity. Kept auto-synced
  // into Total Bill Amount by default so it never has to be added up by hand; typing a different
  // value in that field (e.g. to add shipping/adjustments from the dealer's bill) switches to
  // manual mode until "Recalculate from items" is clicked.
  const itemsTotal = pendingItems.reduce((sum, i) => sum + (Number(i.purchasePrice) || 0) * (Number(i.quantity) || 1), 0);
  useEffect(() => { if (totalAutoSynced) setTotalAmount(itemsTotal ? String(itemsTotal) : ""); }, [itemsTotal, totalAutoSynced]);

  function addDraftItem() {
    if (!draftItem.itemName.trim()) { alert("Item name required"); return; }
    const cfg = categoryConfig(draftItem.category);
    // Consolidated Entry: a category that doesn't require a unique ID (tiles, medicines,
    // accessories, etc.) queues as ONE row carrying quantity: N — not N separate rows — so a
    // purchase of 100 tiles becomes a single stock lot, same as the standalone Inventory form.
    // Categories that DO require a unique ID still queue one row per unit, each with its own
    // IMEI/Serial to fill in, quantity fixed at 1.
    if (cfg.idRequired) {
      const { quantity, ...rest } = draftItem;
      setPendingItems([...pendingItems, { ...rest, quantity: 1, tempId: uid("tmp") }]);
    } else {
      const qty = Math.max(1, Math.floor(Number(draftItem.quantity) || 1));
      setPendingItems([...pendingItems, { ...draftItem, quantity: qty, tempId: uid("tmp") }]);
    }
    setDraftItem(blankItem());
  }
  function removeDraftItem(tempId) { setPendingItems(pendingItems.filter(i => i.tempId !== tempId)); }
  function resetForm() { setDealerId(""); setInvoiceNumber(""); setTotalAmount(""); setTotalAutoSynced(true); setCashPaid(""); setOnlinePaid(""); setDate(todayISO()); setPendingItems([]); setDraftItem(blankItem()); setEditingInvoice(null); }
  function openEditInvoice(p) {
    setEditingInvoice(p.id); setDealerId(p.dealerId); setInvoiceNumber(p.invoiceNumber); setTotalAmount(String(p.totalAmount)); setTotalAutoSynced(false);
    setCashPaid(String(p.cashPaid || 0)); setOnlinePaid(String(p.onlinePaid || 0)); setDate(p.date); setPendingItems([]); setShowForm(true);
  }
  function submitInvoice() {
    if (!dealerId) { alert("Select a dealer"); return; }
    if (!invoiceNumber.trim()) { alert("Enter dealer bill/invoice number"); return; }
    if (!totalAmount) { alert("Enter total bill amount"); return; }
    if (editingInvoice) {
      const newItems = pendingItems.map(({ tempId, ...rest }) => ({ ...rest, id: uid("item"), dealerId, dateAdded: date, status: rest.status || "Available" }));
      setData({
        ...data,
        purchases: data.purchases.map(p => p.id === editingInvoice ? { ...p, dealerId, invoiceNumber, totalAmount: Number(totalAmount), cashPaid: Number(cashPaid) || 0, onlinePaid: Number(onlinePaid) || 0, date, items: [...p.items, ...newItems.map(i => i.id)] } : p),
        inventory: [...data.inventory, ...newItems],
      });
    } else {
      const newItems = pendingItems.map(({ tempId, ...rest }) => ({ ...rest, id: uid("item"), dealerId, dateAdded: date, status: rest.status || "Available" }));
      const purchase = { id: uid("pur"), dealerId, invoiceNumber, totalAmount: Number(totalAmount), cashPaid: Number(cashPaid) || 0, onlinePaid: Number(onlinePaid) || 0, date, items: newItems.map(i => i.id) };
      setData({ ...data, purchases: [...data.purchases, purchase], inventory: [...data.inventory, ...newItems] });
    }
    resetForm(); setShowForm(false);
  }
  function doDeleteInvoice() {
    setData({ ...data, purchases: data.purchases.filter(p => p.id !== deleting.id), inventory: data.inventory.filter(i => !deleting.items.includes(i.id)) });
    setDeleting(null);
  }

  return (
    <div>

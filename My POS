  function handleImport(e) {
    const file = e.target.files[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const parsed = JSON.parse(reader.result);
        const incoming = parsed.data || parsed;
        if (!confirm("This will overwrite the current business's data with the imported backup (including Inventory, Customers, Installment Ledgers, and Dealer data). Continue?")) return;
        setData(normalizeData(incoming));
        alert("Data restored successfully.");
      } catch (err) { alert("Invalid backup file: " + err.message); }
    };
    reader.readAsText(file);
    e.target.value = "";
  }
  /* Single-file, multi-sheet Excel import: takes ONE .xlsx workbook (e.g. the file produced by
     "Export Full Backup (Excel, multi-sheet)", or any workbook using the same sheet names) and
     imports every sheet it recognizes in one pass, instead of requiring a separate file picker
     per table. Uses the exact same match-by-IMEI/Serial/phone/name upsert rules as the individual
     importers below, so it's safe to run repeatedly. Sheets with relational/internal-ID data
     (Purchases, Sales, SalaryPayments, Expenses, Partners) aren't included here — those still use
     the single-table importers further down, or the full JSON restore for an exact 1:1 restore.
  */
  async function handleFullExcelImport(e) {
    const file = e.target.files[0]; if (!file) return;
    const ext = file.name.split(".").pop().toLowerCase();
    if (ext !== "xlsx" && ext !== "xls") { alert("Please choose a single .xlsx or .xls workbook (with multiple sheets) for this option. For a single CSV/JSON table, use the individual importers below instead."); e.target.value = ""; return; }
    try {
      const buf = await file.arrayBuffer();
      const wb = XLSX.read(buf, { type: "array" });
      const findSheet = (label) => wb.SheetNames.find(n => n.toLowerCase() === label.toLowerCase()) || wb.SheetNames.find(n => n.toLowerCase().startsWith(label.toLowerCase().slice(0, 4)));
      const sheetRows = (label) => {
        const name = findSheet(label);
        if (!name) return null;
        const rows = XLSX.utils.sheet_to_json(wb.Sheets[name], { defval: "" }).filter(r => !(Object.keys(r).length === 1 && "info" in r));
        return rows;
      };

      const recognized = [
        ["Inventory", "inventory"], ["Dealers", "dealers"], ["Customers", "customers"],
        ["Accounts", "accounts"], ["CustomCategories", "customCategories"], ["CustomItemPresets", "customItemPresets"],
      ];
      const found = recognized.filter(([label]) => sheetRows(label) !== null);
      if (found.length === 0) { alert("No recognizable sheets found in this workbook. Expected one or more of: Inventory, Dealers, Customers, Accounts, CustomCategories, CustomItemPresets."); e.target.value = ""; return; }
      if (!confirm("Found " + found.length + " matching sheet(s): " + found.map(f => f[0]).join(", ") + ".\nRecords matched by IMEI/Serial/phone/name will be UPDATED with the new values; everything else will be ADDED. Continue?")) { e.target.value = ""; return; }

      let next = { ...data };
      const summary = [];

      const invRows = sheetRows("Inventory");
      if (invRows && invRows.length) {
        let updated = 0, added = 0;
        let inventory = [...next.inventory];
        invRows.forEach(r => {
          const matchIdx = inventory.findIndex(i => (r.imei1 && i.imei1 === r.imei1) || (r.serialNumber && i.serialNumber === r.serialNumber));
          const rec = {
            itemName: r.itemName || "", brand: r.brand || "", model: r.model || "", category: r.category || "Mobile",
            imei1: r.imei1 || "", imei2: r.imei2 || "", serialNumber: r.serialNumber || "", specs: r.specs || "", ram: r.ram || "", storage: r.storage || "", color: r.color || "",
            condition: r.condition || "New", quantity: Math.max(1, Math.floor(Number(r.quantity) || 1)),
            accessories: typeof r.accessories === "string" ? Object.fromEntries(["box", "charger", "cable", "warranty"].map(k => [k, (r.accessories || "").split("|").includes(k)])) : { box: false, charger: false, cable: false, warranty: false },
            purchasePrice: r.purchasePrice || "", retailPrice: r.retailPrice || "", minPrice: r.minPrice || "", dealerId: r.dealerId || "", status: r.status || "Available",
          };
          if (matchIdx >= 0) { inventory[matchIdx] = { ...inventory[matchIdx], ...rec }; updated++; }
          else { inventory.push({ ...rec, id: uid("item"), dateAdded: r.dateAdded || todayISO() }); added++; }
        });
        next.inventory = inventory;
        summary.push("Inventory: " + added + " added, " + updated + " updated");
      }

      const dealerRows = sheetRows("Dealers");
      if (dealerRows && dealerRows.length) {
        let updated = 0, added = 0;
        let dealers = [...next.dealers];
        dealerRows.forEach(r => {
          const matchIdx = dealers.findIndex(d => r.name && d.name === r.name);
          const rec = { name: r.name || "", contactPerson: r.contactPerson || "", phone: r.phone || "", city: r.city || "" };
          if (matchIdx >= 0) { dealers[matchIdx] = { ...dealers[matchIdx], ...rec }; updated++; }
          else { dealers.push({ ...rec, id: uid("dealer") }); added++; }
        });
        next.dealers = dealers;
        summary.push("Dealers: " + added + " added, " + updated + " updated");
      }

      const custRows = sheetRows("Customers");
      if (custRows && custRows.length) {
        let updated = 0, added = 0;
        let customers = [...next.customers];
        custRows.forEach(r => {
          const matchIdx = customers.findIndex(c => r.phone && c.phone === r.phone);
          const rec = { name: r.name || "", phone: r.phone || "", cnic: r.cnic || "", address: r.address || "", guarantorName: r.guarantorName || "", guarantorPhone: r.guarantorPhone || "" };
          if (matchIdx >= 0) { customers[matchIdx] = { ...customers[matchIdx], ...rec }; updated++; }
          else { customers.push({ ...rec, id: uid("cust"), photo: "", cnicFront: "", cnicBack: "", guarantorProof: "" }); added++; }
        });
        next.customers = customers;
        summary.push("Customers: " + added + " added, " + updated + " updated");
      }

      const acctRows = sheetRows("Accounts");
      if (acctRows && acctRows.length) {
        let updated = 0, added = 0;
        let accounts = [...next.accounts];
        acctRows.forEach(r => {
          const matchIdx = accounts.findIndex(a => r.name && a.name === r.name);
          const rec = { name: r.name || "", type: ACCOUNT_TYPES.includes(r.type) ? r.type : "Cash", openingBalance: r.openingBalance || 0 };
          if (matchIdx >= 0) { accounts[matchIdx] = { ...accounts[matchIdx], ...rec }; updated++; }
          else { accounts.push({ ...rec, id: uid("acct") }); added++; }
        });
        next.accounts = accounts;
        summary.push("Accounts: " + added + " added, " + updated + " updated");
      }

      const catRows = sheetRows("CustomCategories");
      if (catRows && catRows.length) {
        let added = 0;
        let customCategories = [...(next.customCategories || [])];
        catRows.forEach(r => {
          const name = String(r.category || r.name || "").trim();
          if (!name) return;
          if (CATEGORIES.includes(name) || customCategories.includes(name)) return;
          customCategories.push(name); added++;
        });
        next.customCategories = customCategories;
        summary.push("Custom Categories: " + added + " added");
      }

      const presetRows = sheetRows("CustomItemPresets");
      if (presetRows && presetRows.length) {
        let updated = 0, added = 0;
        let customItemPresets = [...(next.customItemPresets || [])];
        presetRows.forEach(r => {
          if (!r.name) return;
          const matchIdx = customItemPresets.findIndex(p => p.name === r.name);
          const rec = {
            name: r.name || "", category: r.category || "Mobile", brand: r.brand || "", model: r.model || "",
            ram: r.ram || "", storage: r.storage || "", color: r.color || "",
            purchasePrice: r.purchasePrice || "", retailPrice: r.retailPrice || "", minPrice: r.minPrice || "",
          };
          if (matchIdx >= 0) { customItemPresets[matchIdx] = { ...customItemPresets[matchIdx], ...rec }; updated++; }
          else { customItemPresets.push({ ...rec, id: uid("preset") }); added++; }
        });
        next.customItemPresets = customItemPresets;
        summary.push("Custom Item Presets: " + added + " added, " + updated + " updated");
      }

      setData(next);
      alert("Multi-sheet import complete:\n" + summary.join("\n"));
    } catch (err) { alert("Import failed: " + err.message); }
    e.target.value = "";
  }
  async function handleTableImport(e, target) {
    const file = e.target.files[0]; if (!file) return;
    const ext = file.name.split(".").pop().toLowerCase();
    try {
      let rows = [];
      if (ext === "json") {
        const text = await file.text();
        const parsed = JSON.parse(text);
        rows = Array.isArray(parsed) ? parsed : (parsed[target] || (parsed.data && parsed.data[target]) || []);
      } else if (ext === "csv") {
        rows = parseCSV(await file.text());
      } else if (ext === "xlsx" || ext === "xls") {
        const buf = await file.arrayBuffer();
        const wb = XLSX.read(buf, { type: "array" });
        const sheetName = wb.SheetNames.find(n => n.toLowerCase().startsWith(target.slice(0, 4))) || wb.SheetNames[0];
        rows = XLSX.utils.sheet_to_json(wb.Sheets[sheetName], { defval: "" });
      } else { alert("Unsupported file type. Please use .csv, .xlsx, or .json"); return; }
      if (!rows || rows.length === 0) { alert("No rows found in the file."); return; }
      if (!confirm("Import " + rows.length + " " + target + " record(s)? Records matched by IMEI/Serial/phone/name will be UPDATED with the new values; new records will be ADDED.")) return;

      if (target === "inventory") {
        let updated = 0, added = 0;
        let inventory = [...data.inventory];
        rows.forEach(r => {
          const matchIdx = inventory.findIndex(i => (r.imei1 && i.imei1 === r.imei1) || (r.serialNumber && i.serialNumber === r.serialNumber));
          const rec = {
            itemName: r.itemName || "", brand: r.brand || "", model: r.model || "", category: r.category || "Mobile",
            imei1: r.imei1 || "", imei2: r.imei2 || "", serialNumber: r.serialNumber || "", specs: r.specs || "", ram: r.ram || "", storage: r.storage || "", color: r.color || "",
            condition: r.condition || "New", quantity: Math.max(1, Math.floor(Number(r.quantity) || 1)),
            accessories: typeof r.accessories === "string" ? Object.fromEntries(["box", "charger", "cable", "warranty"].map(k => [k, (r.accessories || "").split("|").includes(k)])) : { box: false, charger: false, cable: false, warranty: false },
            purchasePrice: r.purchasePrice || "", retailPrice: r.retailPrice || "", minPrice: r.minPrice || "", dealerId: r.dealerId || "", status: r.status || "Available",
          };
          if (matchIdx >= 0) { inventory[matchIdx] = { ...inventory[matchIdx], ...rec }; updated++; }
          else { inventory.push({ ...rec, id: uid("item"), dateAdded: r.dateAdded || todayISO() }); added++; }
        });
        setData({ ...data, inventory });
        alert(added + " item(s) added, " + updated + " item(s) updated.");
      } else if (target === "customers") {
        let updated = 0, added = 0;
        let customers = [...data.customers];
        rows.forEach(r => {
          const matchIdx = customers.findIndex(c => r.phone && c.phone === r.phone);
          const rec = { name: r.name || "", phone: r.phone || "", cnic: r.cnic || "", address: r.address || "", guarantorName: r.guarantorName || "", guarantorPhone: r.guarantorPhone || "" };
          if (matchIdx >= 0) { customers[matchIdx] = { ...customers[matchIdx], ...rec }; updated++; }
          else { customers.push({ ...rec, id: uid("cust"), photo: "", cnicFront: "", cnicBack: "", guarantorProof: "" }); added++; }
        });
        setData({ ...data, customers });
        alert(added + " customer(s) added, " + updated + " customer(s) updated.");
      } else if (target === "dealers") {
        let updated = 0, added = 0;
        let dealers = [...data.dealers];
        rows.forEach(r => {
          const matchIdx = dealers.findIndex(d => r.name && d.name === r.name);
          const rec = { name: r.name || "", contactPerson: r.contactPerson || "", phone: r.phone || "", city: r.city || "" };
          if (matchIdx >= 0) { dealers[matchIdx] = { ...dealers[matchIdx], ...rec }; updated++; }
          else { dealers.push({ ...rec, id: uid("dealer") }); added++; }
        });
        setData({ ...data, dealers });
        alert(added + " dealer(s)/supplier(s) added, " + updated + " updated.");
      } else if (target === "accounts") {
        // Accounts (Cash/Bank/Wallet ledger heads). Matched by account name; opening balance is
        // updated in place. Running balances themselves are always derived from transactions
        // (sales/payments/expenses), never overwritten directly, to keep the ledger consistent.
        let updated = 0, added = 0;
        let accounts = [...data.accounts];
        rows.forEach(r => {
          const matchIdx = accounts.findIndex(a => r.name && a.name === r.name);
          const rec = { name: r.name || "", type: ACCOUNT_TYPES.includes(r.type) ? r.type : "Cash", openingBalance: r.openingBalance || 0 };
          if (matchIdx >= 0) { accounts[matchIdx] = { ...accounts[matchIdx], ...rec }; updated++; }
          else { accounts.push({ ...rec, id: uid("acct") }); added++; }
        });
        setData({ ...data, accounts });
        alert(added + " account(s) added, " + updated + " updated.");
      } else if (target === "dealerLedger") {
        // Dealer ledger payments (money paid TO a dealer against outstanding purchases).
        // Dealer matched by name; each row becomes one new payment entry (ledger transactions are
        // additive/historical, so rows are always appended rather than merged).
        let added = 0, skipped = 0;
        let dealerPayments = [...data.dealerPayments];
        rows.forEach(r => {
          const dealer = data.dealers.find(d => d.name === r.dealerName);
          if (!dealer || !r.amount) { skipped++; return; }
          const account = data.accounts.find(a => a.name === r.accountName) || data.accounts[0];
          dealerPayments.push({ id: uid("dpay"), dealerId: dealer.id, amount: Number(r.amount) || 0, accountId: account ? account.id : "", date: r.date || todayISO(), note: r.note || "" });
          added++;
        });
        setData({ ...data, dealerPayments });
        alert(added + " ledger payment(s) added" + (skipped ? ", " + skipped + " row(s) skipped (unknown dealer or missing amount)." : "."));
      } else if (target === "sales") {
        // Sales records. Matched by invoiceId — existing sales are left untouched (sales affect
        // stock status and ledgers, so only NEW invoices are created from import; edit existing
        // sales from the Sales tab itself). Item matched by IMEI 1 or Serial Number, customer by
        // phone. Rows that can't resolve an item are skipped rather than guessed at.
        let added = 0, skipped = 0;
        let sales = [...data.sales];
        let inventory = [...data.inventory];
        let invoiceCounter = data.invoiceCounter || 0;
        rows.forEach(r => {
          if (r.invoiceId && sales.find(s => s.invoiceId === r.invoiceId)) { skipped++; return; }
          const item = inventory.find(i => (r.itemImeiOrSerial && (i.imei1 === r.itemImeiOrSerial || i.serialNumber === r.itemImeiOrSerial)));
          if (!item) { skipped++; return; }
          const customer = data.customers.find(c => c.phone === r.customerPhone);
          const account = data.accounts.find(a => a.name === r.accountName) || data.accounts[0];
          const salePrice = Number(r.salePrice) || Number(item.retailPrice) || 0;
          invoiceCounter++;
          sales.push({
            id: uid("sale"), invoiceId: r.invoiceId || padInvoice(invoiceCounter), itemId: item.id, quantity: Number(r.quantity) || 1,
            customerId: customer ? customer.id : "", customerName: customer ? customer.name : (r.customerName || ""), customerPhone: r.customerPhone || (customer ? customer.phone : ""),
            manualReceiptNumber: r.manualReceiptNumber || "", retailPrice: item.retailPrice, discount: Number(r.discount) || 0, salePrice,
            paymentType: r.paymentType === "Installment" ? "Installment" : "Full", accountId: account ? account.id : "", bankRef: r.bankRef || "",
            date: r.date || todayISO(), soldBy: r.soldBy || "Import", paidAmount: r.paymentType === "Installment" ? (Number(r.paidAmount) || 0) : salePrice,
            installmentPlan: [], installmentPayments: [], receiptScan: "",
          });
          inventory = inventory.map(i => i.id === item.id ? { ...i, status: "Sold" } : i);
          added++;
        });
        setData({ ...data, sales, inventory, invoiceCounter });
        alert(added + " sale(s) added" + (skipped ? ", " + skipped + " row(s) skipped (duplicate invoice # or item not found by IMEI/Serial)." : ".") + " Installment plans for imported installment sales should be set up from the Sales tab.");
      } else if (target === "installments") {
        // Installment / recovery payments against EXISTING sales. Matched by invoiceId; each row
        // is appended as a new payment (never merged), matching how payments are recorded manually.
        let added = 0, skipped = 0;
        let sales = [...data.sales];
        rows.forEach(r => {
          const idx = sales.findIndex(s => s.invoiceId === r.invoiceId);
          if (idx < 0 || !r.amount) { skipped++; return; }
          const account = data.accounts.find(a => a.name === r.accountName) || data.accounts[0];
          const entry = { id: uid("ip"), type: "payment", month: r.month ? Number(r.month) : null, amount: Number(r.amount) || 0, manualReceiptNumber: r.manualReceiptNumber || "", date: r.date || todayISO(), accountId: account ? account.id : "", bankRef: r.bankRef || "", collectedBy: r.collectedBy || "Import" };
          sales[idx] = { ...sales[idx], installmentPayments: [...(sales[idx].installmentPayments || []), entry] };
          added++;
        });
        setData({ ...data, sales });
        alert(added + " installment payment(s) added" + (skipped ? ", " + skipped + " row(s) skipped (invoice # not found or missing amount)." : "."));
      }
    } catch (err) { alert("Import failed: " + err.message); }
    e.target.value = "";
  }
  const REPORTS = [

  const [downloadingAll, setDownloadingAll] = useState(false);
  // Triggers every report's download one after another with a short gap between each — browsers
  // routinely block several simultaneous downloads started from one click, so this paces them out
  // instead of firing all of them in the same tick.
  function downloadAllReports(format) {
    setDownloadingAll(true);
    REPORTS.forEach((report, i) => {
      setTimeout(() => {
        if (format === "pdf") runReportPDF(report); else runReportExcel(report);
        if (i === REPORTS.length - 1) setDownloadingAll(false);
      }, i * 600);
    });
  }


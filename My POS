/* Maps a signed-in Google account's email to an existing system user (by the same `email` field
   used for OTP password recovery) so that user's already-configured role & CRUD permissions are
   what apply — Google Sign-In authenticates WHO they are, the local user record still decides
   WHAT they're allowed to do. An Admin links an account by setting that person's email in
   Settings -> Manage Users; there is no auto-provisioning of new users via Google. */
function findUserByEmail(users, email) {
  if (!email) return null;
  const e = email.trim().toLowerCase();
  return users.find(u => u.email && u.email.trim().toLowerCase() === e) || null;
}

/* ---------- financial calcs ---------- */
function accountBalance(data, accountId) {
  const acc = data.accounts.find(a => a.id === accountId);
  let bal = acc ? Number(acc.openingBalance) || 0 : 0;
  data.sales.forEach(s => {
    if (s.accountId === accountId) bal += Number(s.paidAmount) || 0;
    (s.installmentPayments || []).forEach(p => { if (p.type !== "discount" && p.accountId === accountId) bal += Number(p.amount) || 0; });
  });
  data.dealerPayments.forEach(p => { if (p.accountId === accountId) bal -= Number(p.amount) || 0; });
  (data.expenses || []).forEach(e => { if (e.accountId === accountId) bal -= Number(e.amount) || 0; });
  (data.salaryPayments || []).forEach(p => { if (p.accountId === accountId) bal -= Number(p.amount) || 0; });
  (data.partnerTransactions || []).forEach(t => { if (t.type === "drawing" && t.accountId === accountId) bal -= Number(t.amount) || 0; });
  return bal;
}
function saleCredit(sale) {
  const paymentsTotal = (sale.installmentPayments || []).reduce((s, p) => s + (Number(p.amount) || 0), 0);
  const totalCredited = (Number(sale.paidAmount) || 0) + paymentsTotal;
  const remaining = (Number(sale.salePrice) || 0) - totalCredited;
  const discountGiven = (sale.installmentPayments || []).filter(p => p.type === "discount").reduce((s, p) => s + (Number(p.amount) || 0), 0) + (Number(sale.discount) || 0);
  return { totalCredited, remaining, discountGiven };
}
function nextDueInfo(sale) {
  if (!sale.installmentPlan || sale.installmentPlan.length === 0) return null;
  const paidMonths = (sale.installmentPayments || []).filter(p => p.type === "payment" && p.month).map(p => p.month);
  return sale.installmentPlan.find(pl => !paidMonths.includes(pl.month)) || null;
}
/* ---------- Multi-item cart helpers ----------
   A sale can hold several different item "lines" (cart rows) — one per product/model — each with
   its own quantity (bulk accessories) or a single serialized unit (Mobile/Laptop/etc). sale.items
   holds these lines going forward. Sales saved before this feature only had a single
   itemId/itemIds/quantity/retailPrice/discount directly on the sale — saleLines() normalizes both
   shapes into the same array so every other part of the app can treat every sale as a cart. */
function saleLines(sale) {
  if (sale.items && sale.items.length) return sale.items;
  if (!sale.itemId) return [];
  const ids = sale.itemIds && sale.itemIds.length ? sale.itemIds : [sale.itemId];
  const qty = Number(sale.quantity) || ids.length || 1;
  return [{ itemId: sale.itemId, itemIds: ids, quantity: qty, unitPrice: qty ? (Number(sale.retailPrice) || 0) / qty : 0, lineRetail: Number(sale.retailPrice) || 0 }];
}
function saleAllItemIds(sale) {
  const out = [];
  saleLines(sale).forEach(l => { (l.itemIds && l.itemIds.length ? l.itemIds : (l.itemId ? [l.itemId] : [])).forEach(id => out.push(id)); });
  return out;
}
/* Applies (direction -1, a sale happening) or reverses (direction +1, undoing a sale being edited)
   the stock effect of a set of cart/sale lines against the inventory array, returning a new array.
   Two physical stock models coexist here on purpose:
   - Bulk, single-row-with-quantity (current model — see Purchases/Inventory "Consolidated Entry"):
     one inventory row, `quantity` goes up or down by the line's quantity. Status always stays
     "Available"; running out just means quantity reaches 0 (still filtered out of pickers by
     isStockAvailable() below), it does not need a "Sold" status the way a serialized unit does.
   - Serialized, or legacy bulk sales saved before this model existed (many 1-unit rows, each
     individually flagged Sold/Available) — unchanged, exactly as this app has always worked.
   A line is treated as the new bulk model only when it's explicitly flagged `bulk: true` AND
   references exactly one inventory id — that combination can only come from code written after
   this refactor, so older saved sales (no `bulk` flag; bulk lines had N ids, one per unit) always
   fall through to the original per-id status toggle, which remains correct for them. */
function applySaleStockEffect(inventory, lines, direction) {
  let inv = inventory;
  lines.forEach(l => {
    const ids = l.itemIds && l.itemIds.length ? l.itemIds : (l.itemId ? [l.itemId] : []);
    if (!ids.length) return;
    if (l.bulk === true && ids.length === 1) {
      const qty = Number(l.quantity) || 1;
      inv = inv.map(i => i.id === ids[0] ? { ...i, quantity: Math.max(0, (Number(i.quantity) || 0) + direction * qty), status: "Available" } : i);
    } else {
      inv = inv.map(i => ids.includes(i.id) ? { ...i, status: direction > 0 ? "Available" : "Sold" } : i);
    }
  });
  return inv;
}
/* A row counts as sellable stock when it's flagged Available AND, for a non-serialized (bulk)
   category, still has quantity left. Serialized rows (idRequired category) are all-or-nothing —
   the row existing as "Available" at all means that one unit is in stock. */
function isStockAvailable(item) {
  if (item.status !== "Available") return false;
  const cfg = categoryConfig(item.category);
  if (cfg.idRequired) return true;
  return (Number(item.quantity) || 1) > 0;
}
/* Resolves each cart line to its actual inventory item (for name/specs) — used by receipts and views. */
function saleItemsSummary(sale, data) {
  return saleLines(sale).map(l => ({ ...l, item: data.inventory.find(i => i.id === l.itemId) || null }));
}
function lineTotal(l) { return l.lineRetail != null ? Number(l.lineRetail) || 0 : (Number(l.unitPrice) || 0) * (Number(l.quantity) || 1); }
/* Short one-line summary of a sale's cart for table rows: "iPhone 13 x2 +1 more" etc. */
function saleItemsLabel(sale, data) {
  const lines = saleItemsSummary(sale, data);
  if (lines.length === 0) return "-";
  const first = lines[0].item ? lines[0].item.itemName : "(deleted item)";
  const qtySuffix = lines[0].quantity > 1 ? " x" + lines[0].quantity : "";
  if (lines.length === 1) return first + qtySuffix;
  return first + qtySuffix + " +" + (lines.length - 1) + " more";
}
function reminderList(data) {
  const rows = [];
  data.sales.filter(s => s.paymentType === "Installment").forEach(s => {
    const credit = saleCredit(s);
    if (credit.remaining <= 0) return;
    const next = nextDueInfo(s);
    if (!next) return;
    const diffDays = Math.round((new Date(next.dueDate) - new Date(todayISO())) / 86400000);
    if (diffDays <= 7) rows.push({ sale: s, next, diffDays, overdue: diffDays < 0, credit });
  });
  return rows.sort((a, b) => a.diffDays - b.diffDays);
}
function calcProfitLoss(data) {
  const revenue = data.sales.reduce((s, x) => s + (Number(x.salePrice) || 0), 0);
  const soldItemIds = data.sales.flatMap(s => saleAllItemIds(s));
  const cogs = data.inventory.filter(i => soldItemIds.includes(i.id)).reduce((s, i) => s + (Number(i.purchasePrice) || 0), 0);
  const grossProfit = revenue - cogs;
  const totalExpenses = (data.expenses || []).reduce((s, e) => s + (Number(e.amount) || 0), 0);
  const totalSalaries = (data.salaryPayments || []).reduce((s, p) => s + (Number(p.amount) || 0), 0);
  const netProfit = grossProfit - totalExpenses - totalSalaries;
  return { revenue, cogs, grossProfit, totalExpenses, totalSalaries, netProfit };
}
function inRange(dateStr, from, to) { if (!dateStr) return false; return (!from || dateStr >= from) && (!to || dateStr <= to); }
function presetRange(preset) {
  const today = todayISO();
  if (preset === "today") return { from: today, to: today };
  if (preset === "week") { const d = new Date(); const day = d.getDay(); const start = new Date(d); start.setDate(d.getDate() - day); return { from: start.toISOString().slice(0, 10), to: today }; }
  if (preset === "month") { const d = new Date(); const start = new Date(d.getFullYear(), d.getMonth(), 1); return { from: start.toISOString().slice(0, 10), to: today }; }
  if (preset === "year") { const d = new Date(); const start = new Date(d.getFullYear(), 0, 1); return { from: start.toISOString().slice(0, 10), to: today }; }
  return { from: "", to: "" };
}
function rangeFinancials(data, from, to) {
  const salesInRange = data.sales.filter(s => inRange(s.date, from, to));
  const revenue = salesInRange.reduce((s, x) => s + (Number(x.salePrice) || 0), 0);
  const soldItemIds = salesInRange.flatMap(s => saleAllItemIds(s));
  const cogs = data.inventory.filter(i => soldItemIds.includes(i.id)).reduce((s, i) => s + (Number(i.purchasePrice) || 0), 0);
  const purchasesInRange = data.purchases.filter(p => inRange(p.date, from, to)).reduce((s, p) => s + (Number(p.totalAmount) || 0), 0);
  const expensesInRange = (data.expenses || []).filter(e => inRange(e.date, from, to)).reduce((s, e) => s + (Number(e.amount) || 0), 0);
  const salariesInRange = (data.salaryPayments || []).filter(p => inRange(p.date, from, to)).reduce((s, p) => s + (Number(p.amount) || 0), 0);
  let recoveries = 0;
  data.sales.forEach(s => (s.installmentPayments || []).forEach(p => { if (p.type === "payment" && inRange(p.date, from, to)) recoveries += Number(p.amount) || 0; }));
  const netProfit = (revenue - cogs) - expensesInRange - salariesInRange;
  return { salesCount: salesInRange.length, revenue, cogs, purchasesInRange, expensesInRange, salariesInRange, recoveries, netProfit };
}
function partnerBalance(data, partnerId) {
  const partner = data.partners.find(p => p.id === partnerId);
  if (!partner) return { investment: 0, allocatedProfit: 0, drawings: 0, netBalance: 0 };
  const pl = calcProfitLoss(data);
  const allocatedProfit = pl.netProfit * (Number(partner.percent) || 0) / 100;
  const drawings = (data.partnerTransactions || []).filter(t => t.partnerId === partnerId && t.type === "drawing").reduce((s, t) => s + (Number(t.amount) || 0), 0);
  const investment = Number(partner.investment) || 0;
  return { investment, allocatedProfit, drawings, netBalance: investment + allocatedProfit - drawings };
}


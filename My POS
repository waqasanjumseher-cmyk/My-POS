/* Converts a data-URL image and/or PNG Blob to a shareable File and, where the browser supports
   the Web Share API with files (most Android/Chrome — this is exactly how WhatsApp accepts a
   pre-attached image), opens the native share sheet with WhatsApp as one of the options. Falls
   back to a plain download + a wa.me text link when file-sharing isn't supported (e.g. desktop
   browsers), since there is no cross-browser way to pre-attach an image into WhatsApp Web/Desktop
   from a webpage. */
async function shareOrDownloadImage(blob, filename, shareText) {
  try {
    const file = new File([blob], filename, { type: "image/png" });
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({ files: [file], title: filename, text: shareText || "" });
      return "shared";
    }
  } catch (e) { if (e.name === "AbortError") return "cancelled"; console.warn("Share failed, falling back to download:", e); }
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a"); a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
  return "downloaded";
}
function WhatsAppReceiptModal({ biz, sale, items, customer, data, onClose }) {
  const nodeRef = useRef(null);
  const [busy, setBusy] = useState(false);
  const [status, setStatus] = useState("");
  async function renderCanvas() {
    return await html2canvas(nodeRef.current, { scale: 2, backgroundColor: "#ffffff", useCORS: true, logging: false });
  }
  async function handleDownload() {
    setBusy(true); setStatus("");
    try {
      const canvas = await renderCanvas();
      canvas.toBlob((blob) => {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob); a.download = "Receipt_" + (sale.invoiceId || "sale") + ".png";
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setBusy(false); setStatus("Image downloaded.");
      }, "image/png", 1.0);
    } catch (e) { setBusy(false); setStatus("Failed to generate image: " + e.message); }
  }
  async function handleShare() {
    setBusy(true); setStatus("");
    try {
      const canvas = await renderCanvas();
      canvas.toBlob(async (blob) => {
        const result = await shareOrDownloadImage(blob, "Receipt_" + (sale.invoiceId || "sale") + ".png", "Receipt from " + (biz.header || biz.name));
        setBusy(false);
        if (result === "downloaded") {
          setStatus("Image downloaded — attach it in WhatsApp manually (opening chat now).");
          if (customer && customer.phone) window.open(waLink(customer.phone, "Please find your receipt attached. \u2013 " + (biz.header || biz.name)), "_blank");
        } else if (result === "shared") setStatus("Shared successfully.");
      }, "image/png", 1.0);
    } catch (e) { setBusy(false); setStatus("Failed to generate image: " + e.message); }
  }
  return (
    <Modal title="WhatsApp Image Receipt" ur="تصویری رسید" onClose={onClose} wide>
      <div className="mb-3 flex flex-wrap gap-2">
        <button disabled={busy} onClick={handleShare} className="bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white text-xs font-medium px-4 py-2 rounded-lg">{busy ? "Generating..." : "Share via WhatsApp"}</button>
        <button disabled={busy} onClick={handleDownload} className="bg-slate-800 hover:bg-slate-900 disabled:opacity-50 text-white text-xs font-medium px-4 py-2 rounded-lg">Download PNG</button>
        <button onClick={() => printReceiptNode(nodeRef.current, "Receipt " + (sale.invoiceId || ""))} className="bg-slate-600 hover:bg-slate-700 text-white text-xs font-medium px-4 py-2 rounded-lg">Print / Save PDF</button>
      </div>
      {status && <div className="text-xs text-slate-500 mb-3">{status}</div>}
      <div className="overflow-x-auto border border-slate-200 rounded-lg bg-slate-100 p-4">
        <ReceiptDesign biz={biz} sale={sale} items={items} customer={customer} data={data} innerRef={nodeRef} />
      </div>
    </Modal>
  );
}

function SettingsTab({ businesses, setBusinesses, currentBiz, setCurrentBizId, users, setUsers, currentUser, cloudUser, onCloudLogout, cloudStatus, isOnline, onSyncNow, data, setData, uiPrefs, setUiPrefs, customTheme, setCustomTheme }) {
  const [form, setForm] = useState(currentBiz);
  const [newBizName, setNewBizName] = useState("");
  useEffect(() => { setForm(currentBiz); }, [currentBiz.id]);

  const [showUserForm, setShowUserForm] = useState(false);
  const [editingUser, setEditingUser] = useState(null);
  const [userForm, setUserForm] = useState(blankUserForm());
  const [deletingUser, setDeletingUser] = useState(null);
  const [resettingUser, setResettingUser] = useState(null);
  const [newPassword, setNewPassword] = useState("");
  const [showReceiptPreview, setShowReceiptPreview] = useState(false);
  const [activeSection, setActiveSection] = useState(null);

  function openAddUser() { setUserForm(blankUserForm()); setEditingUser(null); setShowUserForm(true); }
  function openEditUser(u) { setUserForm({ username: u.username, password: "", name: u.name, email: u.email || "", role: u.role, permissions: u.permissions || defaultPermsForRole(u.role) }); setEditingUser(u.id); setShowUserForm(true); }
  function submitUser() {
    if (!userForm.username.trim() || !userForm.name.trim()) { alert("Username and name are required"); return; }
    if (!editingUser && !userForm.password) { alert("Password is required for new users"); return; }
    const dup = users.find(u => u.username.trim().toLowerCase() === userForm.username.trim().toLowerCase() && u.id !== editingUser);
    if (dup) { alert("That username is already taken."); return; }
    if (userForm.email.trim()) {
      const dupEmail = users.find(u => u.email && u.email.trim().toLowerCase() === userForm.email.trim().toLowerCase() && u.id !== editingUser);
      if (dupEmail) { alert("That email is already registered to another user."); return; }
    }
    if (editingUser) setUsers(users.map(u => u.id === editingUser ? { ...u, username: userForm.username, name: userForm.name, email: userForm.email.trim(), role: userForm.role, permissions: userForm.permissions } : u));
    else setUsers([...users, { id: uid("user"), username: userForm.username, password: userForm.password, name: userForm.name, email: userForm.email.trim(), role: userForm.role, permissions: userForm.permissions, status: "Active" }]);
    setShowUserForm(false);
  }
  function approveUser(u) { setUsers(users.map(x => x.id === u.id ? { ...x, status: "Active" } : x)); }
  function rejectPendingUser(u) { if (confirm("Reject and delete this registration request from " + u.name + "?")) setUsers(users.filter(x => x.id !== u.id)); }
  function togglePermission(userId, tabId, action) {
    setUsers(users.map(u => {
      if (u.id !== userId) return u;
      const perms = normalizePerms(u.permissions, u.role);
      const cur = perms[tabId][action];
      return { ...u, permissions: togglePermAction(perms, tabId, action, !cur) };
    }));
  }
  function doDeleteUser() {
    if (deletingUser.id === currentUser.id) { alert("You cannot delete your own account while logged in."); setDeletingUser(null); return; }
    const remainingAdmins = users.filter(u => u.role === "Admin" && u.id !== deletingUser.id);
    if (deletingUser.role === "Admin" && remainingAdmins.length === 0) { alert("At least one Admin user must remain."); setDeletingUser(null); return; }
    setUsers(users.filter(u => u.id !== deletingUser.id)); setDeletingUser(null);
  }
  function submitResetPassword() {
    if (!newPassword) { alert("Enter a new password"); return; }
    setUsers(users.map(u => u.id === resettingUser.id ? { ...u, password: newPassword } : u));
    setResettingUser(null); setNewPassword("");
  }

  function save() { setBusinesses(businesses.map(b => b.id === currentBiz.id ? { ...form } : b)); alert("Business profile saved."); }
  /* Customize Display: toggles saved immediately, same pattern as the receipt-setting toggles
     below — no separate "Save" click needed. "settings" is intentionally excluded so a user can
     never hide the very screen that lets them undo this. */
  function toggleTabVisible(id, checked) { setUiPrefs({ ...uiPrefs, tabs: { ...uiPrefs.tabs, [id]: checked } }); }
  function toggleCardVisible(id, checked) { setUiPrefs({ ...uiPrefs, dashboard: { ...uiPrefs.dashboard, [id]: checked } }); }
  function setAccentTheme(key) { setUiPrefs({ ...uiPrefs, theme: key }); }
  function setDefaultTab(id) { setUiPrefs({ ...uiPrefs, defaultTab: id }); }
  function toggleCompactSidebar(checked) { setUiPrefs({ ...uiPrefs, compactSidebar: checked }); }
  function toggleHideUrdu(checked) { setUiPrefs({ ...uiPrefs, hideUrdu: checked }); }
  function resetDisplayPrefs() { setUiPrefs(defaultUiPrefs()); }
  /* Receipt Settings toggles save immediately (no separate "Save" click needed) — they only
     touch the `receiptSettings` field on the business record, so they never clobber any other
     unsaved edits sitting in `form` (name/address/etc., which still need the button above). */
  const receiptSettings = getReceiptSettings(form);
  function updateReceiptSetting(key, value) {
    const nextSettings = { ...receiptSettings, [key]: value };
    setForm({ ...form, receiptSettings: nextSettings });
    setBusinesses(businesses.map(b => b.id === currentBiz.id ? { ...b, receiptSettings: nextSettings } : b));
  }
  function addBusiness() {
    if (!newBizName.trim()) return;
    const b = { id: uid("biz"), name: newBizName, address: "", phone: "", header: newBizName };
    setBusinesses([...businesses, b]); setCurrentBizId(b.id); setNewBizName("");
  }
  function deleteBusiness(id) {
    if (businesses.length <= 1) { alert("At least one business must remain."); return; }
    if (!confirm("Delete this business and all its data? This cannot be undone.")) return;
    localStorage.removeItem(DATA_KEY(id));
    const remaining = businesses.filter(b => b.id !== id);
    setBusinesses(remaining); setCurrentBizId(remaining[0].id);
  }

  return (
    <div className="max-w-6xl">
      <h2 className="text-lg font-semibold text-slate-800 mb-4"><Bi en="Business Settings" ur="کاروبار کی ترتیبات" /></h2>

      <div className="flex flex-col md:flex-row gap-6">
        <div className="md:w-64 flex-shrink-0 space-y-4">
          {SETTINGS_CATEGORIES.map(cat => (
            <div key={cat.id}>
              <div className="flex items-center gap-1.5 px-2 mb-1.5 text-[11px] font-semibold uppercase tracking-wide text-slate-400">
                <span>{cat.icon}</span>{cat.label}
              </div>
              <div className="space-y-0.5">
                {cat.sections.map(sid => {
                  const s = SETTINGS_SECTIONS.find(x => x.id === sid);
                  if (!s) return null;
                  const active = activeSection === s.id;

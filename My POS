        idField: hasId ? "serialNumber" : null,
        idLabel: hasId ? btCfg.idLabel : "",
        idRequired: !!btCfg.idRequired,
        showImei2: false, showRamStorage: false, showSpecs: false, specsLabel: "",
        extraFields: btCfg.extraFields || [],

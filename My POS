    }
    // A category not defined for this business type (e.g. the shop typed a custom one) — generic,
    // safe fallback: an optional reference number, no extra fields assumed.
    return { idField: "serialNumber", idLabel: "Serial / Reference No. (optional)", idRequired: false, showImei2: false, showRamStorage: false, showSpecs: false, specsLabel: "", extraFields: [] };
  }
  return { ...(CATEGORY_CONFIG[category] || CATEGORY_CONFIG["Other"]), extraFields: [] };
}

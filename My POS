/* ---------- Local receipt printing ---------- */
/* Prints/Saves-as-PDF from the ACTUAL rendered ReceiptDesign DOM node (its outerHTML), so the PDF
   is pixel-for-pixel the same beautifully styled, branded layout (gradient header, shop
   name/monogram, simplified payment history + totals) as the WhatsApp Image Receipt and WhatsApp
   Image Reminder — one design, reused everywhere instead of a separate plain-text PDF template. */
function printReceiptNode(node, docTitle) {
  if (!node) { alert("Receipt is still preparing — please try again in a moment."); return; }
  const win = window.open("", "_blank", "width=760,height=920");
  if (!win) { alert("Please allow pop-ups to print/save the receipt as PDF."); return; }
  win.document.write(
    "<html><head><title>" + docTitle + "</title>" +
    "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;600;700&display=swap\" rel=\"stylesheet\">" +
    "<style>*{box-sizing:border-box;} body{margin:0;padding:20px;background:#f1f5f9;display:flex;justify-content:center;font-family:Arial,Helvetica,sans-serif;} @media print{body{background:#fff;padding:0;}}</style>" +
    "</head><body>" + node.outerHTML + "<" + "script>window.onload=function(){setTimeout(function(){window.print();},600);}<" + "/script></body></html>"
  );
  win.document.close();
}

/* ============================ WHATSAPP IMAGE RECEIPT (html2canvas) ============================
   Renders a fully-styled, on-brand receipt as real DOM (ReceiptDesign) and rasterizes it into a
   PNG using html2canvas — so it can be downloaded or shared as an image straight into a WhatsApp
   chat, instead of relying on WhatsApp's own text-only wa.me links (which stay available too,
   unchanged, alongside this). */
function initials(name) {
  const words = String(name || "Shop").trim().split(/\s+/).filter(Boolean);
  if (words.length === 0) return "S";
  return (words[0][0] + (words[1] ? words[1][0] : "")).toUpperCase();
}
/* Rolls up everything this customer has ever bought, across all their sales, so the receipt can
   show a "complete customer ledger" rather than just this one invoice. */
function customerLedgerSummary(data, customerId) {
  const sales = data.sales.filter(s => s.customerId === customerId);
  let totalValue = 0, totalPaid = 0;
  sales.forEach(s => { const c = saleCredit(s); totalValue += Number(s.salePrice) || 0; totalPaid += c.totalCredited; });
  return { salesCount: sales.length, totalValue, totalPaid, totalOutstanding: totalValue - totalPaid };
}
/* ---------- Receipt Settings (Business Settings -> Receipt Settings tab) ----------
   Lets each business toggle which optional blocks appear on the WhatsApp Image Receipt:
   the full customer ledger, the payment history log, a complete item description (specs/
   brand/model/condition beyond the short name+IMEI line), and a full pending/received
   installment schedule. Stored per-business as `biz.receiptSettings`; defaults below keep
   the receipt looking exactly as before for any business that hasn't touched the toggles
   yet (ledger + payment history were already always shown; the fuller item description and
   installment schedule are new additions so they default OFF until turned on). */
const DEFAULT_RECEIPT_SETTINGS = {
  showCustomerLedger: true,
  showPaymentHistory: true,
  showItemDescription: false,
  showInstallmentSchedule: false,
};
function getReceiptSettings(biz) {
  return { ...DEFAULT_RECEIPT_SETTINGS, ...((biz && biz.receiptSettings) || {}) };
}

}
function normalizePhone(phone) {
  let p = String(phone || "").replace(/\D/g, "");
  if (!p) return "";
  if (p.startsWith("0")) p = "92" + p.slice(1);
  else if (!p.startsWith("92") && p.length === 10) p = "92" + p;
  return p;
}

                <table className="w-full text-xs">
                  <thead className="bg-slate-50 text-slate-500 uppercase"><tr><th className="text-left px-2 py-1">Item</th><th className="text-left px-2 py-1">Category</th><th className="text-left px-2 py-1">IMEI 1 / ID</th><th className="text-left px-2 py-1">Qty</th><th className="text-left px-2 py-1">Price (each)</th><th className="text-left px-2 py-1">Line Total</th><th></th></tr></thead>
                  <tbody>{pendingItems.map(i => (<tr key={i.tempId} className="border-t border-slate-100"><td className="px-2 py-1">{i.itemName}</td><td className="px-2 py-1 text-slate-500">{i.category}</td><td className="px-2 py-1 font-mono">{i.imei1 || i.serialNumber || "-"}</td><td className="px-2 py-1">{i.quantity || 1}</td><td className="px-2 py-1">{fmtMoney(i.purchasePrice)}</td><td className="px-2 py-1 font-medium">{fmtMoney((Number(i.purchasePrice) || 0) * (Number(i.quantity) || 1))}</td><td className="px-2 py-1 text-right"><button onClick={() => removeDraftItem(i.tempId)} className="text-rose-500">&#128465;</button></td></tr>))}</tbody>
                  <tfoot><tr className="border-t border-slate-200 font-semibold bg-slate-50"><td className="px-2 py-1.5" colSpan="5">{pendingItems.length} item(s) queued for this bill</td><td className="px-2 py-1.5">{fmtMoney(itemsTotal)}</td><td></td></tr></tfoot>

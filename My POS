                <button type="button" onClick={() => { setTotalAutoSynced(true); setTotalAmount(String(itemsTotal)); }} className="text-xs text-[var(--accent-600)] hover:underline mt-1">
                  Recalculate from items ({fmtMoney(itemsTotal)})
                </button>
              )}
              {totalAutoSynced && pendingItems.length > 0 && <div className="text-xs text-slate-400 mt-1">Auto-calculated from the {pendingItems.length} item(s) below.</div>}
            </Field>
            <Field label="Cash Paid" ur="نقد ادائیگی"><TextInput type="number" value={cashPaid} onChange={e => setCashPaid(e.target.value)} /></Field>
            <Field label="Online Paid" ur="آن لائن ادائیگی"><TextInput type="number" value={onlinePaid} onChange={e => setOnlinePaid(e.target.value)} /></Field>

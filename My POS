/* ============================ PARTNERS TAB ============================ */
function blankPartner() { return { name: "", phone: "", investment: "", percent: "" }; }
function PartnersTab({ data, setData, can }) {
  const canAdd = can("add"), canEdit = can("edit"), canDelete = can("delete");
  const [showForm, setShowForm] = useState(false);
  const [editing, setEditing] = useState(null);
  const [partner, setPartner] = useState(blankPartner());
  const [deleting, setDeleting] = useState(null);
  const [drawingPartner, setDrawingPartner] = useState(null);
  const [drawType, setDrawType] = useState("Cash");
  const [drawAmount, setDrawAmount] = useState("");
  const [drawAccount, setDrawAccount] = useState((data.accounts[0] && data.accounts[0].id) || "");
  const [drawItemId, setDrawItemId] = useState("");
  const [drawNote, setDrawNote] = useState("");

  const pl = useMemo(() => calcProfitLoss(data), [data]);
  const totalPercent = data.partners.reduce((s, p) => s + (Number(p.percent) || 0), 0);
  const availableItems = data.inventory.filter(isStockAvailable);

  function openAdd() { setPartner(blankPartner()); setEditing(null); setShowForm(true); }
  function openEdit(p) { setPartner(p); setEditing(p.id); setShowForm(true); }
  function submit() {
    if (!partner.name.trim()) { alert("Partner name required"); return; }
    if (editing) setData({ ...data, partners: data.partners.map(p => p.id === editing ? { ...partner, id: editing } : p) });
    else setData({ ...data, partners: [...data.partners, { ...partner, id: uid("partner") }] });
    setShowForm(false);
  }
  function doDelete() { setData({ ...data, partners: data.partners.filter(p => p.id !== deleting.id) }); setDeleting(null); }
  function submitDrawing() {
    if (!drawAmount || Number(drawAmount) <= 0) { if (drawType === "Cash") { alert("Enter valid amount"); return; } }
    const entry = { id: uid("draw"), partnerId: drawingPartner.id, type: "drawing", drawingType: drawType, amount: Number(drawAmount) || 0, accountId: drawType === "Cash" ? drawAccount : null, itemId: drawType === "Stock" ? drawItemId : null, note: drawNote, date: todayISO() };
    let newInventory = data.inventory;
    // A stock drawing always removes exactly ONE unit. For a bulk (quantity-based) row that means
    // decrementing quantity by 1 — never flipping the whole lot's status, which would incorrectly
    // pull an entire 100-tile batch out of stock for a single unit drawn. Serialized items (a whole
    // row = one physical unit) keep the original full-row status flip, unchanged.
    if (drawType === "Stock" && drawItemId) {
      const item = data.inventory.find(i => i.id === drawItemId);
      const cfg = item ? categoryConfig(item.category) : null;
      if (cfg && !cfg.idRequired) {
        newInventory = data.inventory.map(i => i.id === drawItemId ? { ...i, quantity: Math.max(0, (Number(i.quantity) || 1) - 1) } : i);
      } else {
        newInventory = data.inventory.map(i => i.id === drawItemId ? { ...i, status: "Partner Drawing" } : i);
      }
    }
    setData({ ...data, partnerTransactions: [...data.partnerTransactions, entry], inventory: newInventory });
    setDrawingPartner(null); setDrawAmount(""); setDrawItemId(""); setDrawNote("");
  }
  function onPickStockItem(id) {
    setDrawItemId(id);
    const it = data.inventory.find(i => i.id === id);
    if (it) setDrawAmount(String(it.purchasePrice || 0));
  }

  return (
    <div>
      <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h2 className="text-lg font-semibold text-slate-800"><Bi en="Partner Management & Profit/Loss" ur="پارٹنرشپ اور نفع کا حساب" /></h2>
        {canAdd && <button onClick={openAdd} className="bg-[var(--accent-600)] hover:bg-[var(--accent-700)] text-white text-sm font-medium px-4 py-2 rounded-lg">+ Add Partner</button>}
      </div>

      <div className="bg-white rounded-xl border border-slate-200 p-4 mb-4">
        <h3 className="text-sm font-semibold text-slate-700 mb-2">Net Profit Calculation / نفع کا حساب</h3>
        <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
          <Card label="Revenue" value={fmtMoney(pl.revenue)} />
          <Card label="COGS" value={fmtMoney(pl.cogs)} />

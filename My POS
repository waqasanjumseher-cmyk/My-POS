        {canAdd && <button onClick={openAdd} className="bg-[var(--accent-600)] hover:bg-[var(--accent-700)] text-white text-sm font-medium px-4 py-2 rounded-lg">+ Add Customer / نیا گاہک</button>}
      </div>
      <ListFilterBar
        search={query} onSearch={setQuery} searchPlaceholder="Search name, phone, CNIC..."
        statusOptions={[{ value: "all", label: "All Customers" }, { value: "outstanding", label: "Has Outstanding Balance" }, { value: "settled", label: "Fully Settled" }]}
        status={statusFilter} onStatus={setStatusFilter}
        sortOptions={[{ value: "name:asc", label: "Name: A-Z" }, { value: "name:desc", label: "Name: Z-A" }, { value: "outstanding:desc", label: "Outstanding: High to Low" }, { value: "outstanding:asc", label: "Outstanding: Low to High" }]}
        sort={sort} onSort={setSort}
      />
      <div className="bg-white rounded-xl border border-slate-200 overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="bg-slate-50 text-slate-500 uppercase text-xs"><tr><th className="text-left px-3 py-2">Name</th><th className="text-left px-3 py-2">Phone</th><th className="text-left px-3 py-2">CNIC</th><th className="text-left px-3 py-2">Guarantor</th><th className="text-left px-3 py-2">Outstanding</th><th className="text-left px-3 py-2">Actions</th></tr></thead>
          <tbody>
            {filtered.map(c => (
              <tr key={c.id} className="border-t border-slate-100 hover:bg-slate-50">
                <td className="px-3 py-2 font-medium text-slate-800">{c.name}</td><td className="px-3 py-2">{c.phone}</td><td className="px-3 py-2">{c.cnic}</td><td className="px-3 py-2">{c.guarantorName || "-"}</td>
                <td className={"px-3 py-2 font-medium " + (c.__outstanding > 0 ? "text-amber-600" : "text-emerald-600")}>{fmtMoney(c.__outstanding)}</td>
                <td className="px-3 py-2">
                  <div className="flex gap-2">
                    <button onClick={() => setLedgerCustomer(c)} title="Ledger" className="text-slate-500 hover:text-[var(--accent-600)]">&#128065;</button>
                    {canEdit && <button onClick={() => openEdit(c)} title="Edit" className="text-slate-500 hover:text-[var(--accent-600)]">&#9998;</button>}
                    {canDelete && <button onClick={() => setDeleting(c)} title="Delete" className="text-slate-500 hover:text-rose-600">&#128465;</button>}
                  </div>
                </td>
              </tr>
            ))}
            {filtered.length === 0 && <tr><td colSpan="6" className="text-center text-slate-400 py-8">No customers yet / کوئی گاہک نہیں</td></tr>}
          </tbody>
        </table>
      </div>

      {showForm && (
        <Modal title={editing ? "Edit Customer" : "Add Customer"} ur="گاہک" onClose={() => setShowForm(false)} isDirty={customerDirty}>
          <Field label="Customer Name" ur="نام" required><TextInput value={customer.name} onChange={e => setCustomer({ ...customer, name: e.target.value })} /></Field>
          <Field label="Phone" ur="فون نمبر"><TextInput value={customer.phone} onChange={e => setCustomer({ ...customer, phone: e.target.value })} /></Field>
          <Field label="CNIC" ur="شناختی کارڈ"><TextInput value={customer.cnic} onChange={e => setCustomer({ ...customer, cnic: e.target.value })} /></Field>
          <Field label="Address" ur="پتہ"><TextInput value={customer.address} onChange={e => setCustomer({ ...customer, address: e.target.value })} /></Field>
          <Field label="Guarantor Name" ur="ضامن کا نام"><TextInput value={customer.guarantorName} onChange={e => setCustomer({ ...customer, guarantorName: e.target.value })} /></Field>
          <Field label="Guarantor Phone" ur="ضامن کا فون"><TextInput value={customer.guarantorPhone} onChange={e => setCustomer({ ...customer, guarantorPhone: e.target.value })} /></Field>
          <ImageField label="Customer Photo" ur="تصویر" value={customer.photo} onChange={v => setCustomer({ ...customer, photo: v })} />
          <ImageField label="CNIC Front" ur="شناختی کارڈ سامنے" value={customer.cnicFront} onChange={v => setCustomer({ ...customer, cnicFront: v })} />
          <ImageField label="CNIC Back" ur="شناختی کارڈ پیچھے" value={customer.cnicBack} onChange={v => setCustomer({ ...customer, cnicBack: v })} />
          <ImageField label="Guarantor Proof / Document" ur="ضامن کی دستاویز" value={customer.guarantorProof} onChange={v => setCustomer({ ...customer, guarantorProof: v })} />
          <div className="flex justify-end gap-2 mt-4">
            <button onClick={() => setShowForm(false)} className="px-4 py-2 text-sm rounded-lg border border-slate-300 text-slate-600">Cancel</button>
            <button onClick={submit} className="px-4 py-2 text-sm rounded-lg bg-[var(--accent-600)] text-white hover:bg-[var(--accent-700)]">Save</button>
          </div>
        </Modal>
      )}
      {deleting && (
        <Modal title="Delete Customer?" onClose={() => setDeleting(null)}>
          <p className="text-sm text-slate-600">Delete <b>{deleting.name}</b>? Their sales history will remain but be unlinked.</p>
          <ConfirmBar onCancel={() => setDeleting(null)} onConfirm={doDelete} />
        </Modal>
      )}
      {ledgerCustomer && (
        <Modal title={"Customer Ledger: " + ledgerCustomer.name} ur="گاہک کھاتہ" onClose={() => setLedgerCustomer(null)} wide>
          <div className="text-sm mb-3 grid grid-cols-2 gap-2">
            <div><span className="text-slate-500">Phone:</span> {ledgerCustomer.phone || "-"}</div>
            <div><span className="text-slate-500">CNIC:</span> {ledgerCustomer.cnic || "-"}</div>
            <div><span className="text-slate-500">Address:</span> {ledgerCustomer.address || "-"}</div>
            <div><span className="text-slate-500">Guarantor:</span> {ledgerCustomer.guarantorName || "-"} {ledgerCustomer.guarantorPhone || ""}</div>
          </div>
          {(ledgerCustomer.photo || ledgerCustomer.cnicFront || ledgerCustomer.cnicBack || ledgerCustomer.guarantorProof) && (
            <div className="flex flex-wrap gap-3 mb-4">
              {ledgerCustomer.photo && <div><div className="text-xs text-slate-500 mb-1">Photo</div><img src={ledgerCustomer.photo} className="h-20 rounded-lg border border-slate-200 object-cover" /></div>}
              {ledgerCustomer.cnicFront && <div><div className="text-xs text-slate-500 mb-1">CNIC Front</div><img src={ledgerCustomer.cnicFront} className="h-20 rounded-lg border border-slate-200 object-cover" /></div>}
              {ledgerCustomer.cnicBack && <div><div className="text-xs text-slate-500 mb-1">CNIC Back</div><img src={ledgerCustomer.cnicBack} className="h-20 rounded-lg border border-slate-200 object-cover" /></div>}
              {ledgerCustomer.guarantorProof && <div><div className="text-xs text-slate-500 mb-1">Guarantor Proof</div><img src={ledgerCustomer.guarantorProof} className="h-20 rounded-lg border border-slate-200 object-cover" /></div>}
            </div>
          )}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-2 mb-4">
            <Card label="Total Purchased" value={fmtMoney(totals.purchased)} />
            <Card label="Discounts Given" value={fmtMoney(totals.discount)} />
            <Card label="Total Paid" value={fmtMoney(totals.paid)} accent="text-emerald-600" />
            <Card label="Net Remaining" value={fmtMoney(totals.remaining)} accent={totals.remaining > 0 ? "text-amber-600" : "text-emerald-600"} />
          </div>
          {custSales.length > 0 && (
            <ListFilterBar
              search={ledgerQuery} onSearch={setLedgerQuery} searchPlaceholder="Search invoice #, receipt #, item..."
              from={ledgerFrom} onFrom={setLedgerFrom} to={ledgerTo} onTo={setLedgerTo}
              statusOptions={[{ value: "all", label: "All Statuses" }, { value: "paid", label: "Fully Paid" }, { value: "pending", label: "Pending Balance" }]}
              status={ledgerStatus} onStatus={setLedgerStatus}
              sortOptions={[{ value: "date:desc", label: "Date: Newest First" }, { value: "date:asc", label: "Date: Oldest First" }, { value: "amount:desc", label: "Amount: High to Low" }, { value: "amount:asc", label: "Amount: Low to High" }]}
              sort={ledgerSort} onSort={setLedgerSort}
            />
          )}
          {custSales.length === 0 && <p className="text-sm text-slate-400">No purchases recorded for this customer yet.</p>}
          {custSales.length > 0 && custSalesFiltered.length === 0 && <p className="text-sm text-slate-400">No transactions match these filters.</p>}
          {custSalesFiltered.map(s => {
            return (
              <div key={s.id} className="border border-slate-200 rounded-lg p-3 mb-3">
                <div className="flex flex-wrap justify-between text-sm gap-2">
                  <div><b>{saleItemsLabel(s, data)}</b> <span className="text-xs text-slate-400">Invoice {s.invoiceId} {s.manualReceiptNumber ? "· Receipt " + s.manualReceiptNumber : ""}</span></div>
                  <div>{fmtDate(s.date)} — {fmtMoney(s.salePrice)} ({s.paymentType})</div>
                </div>
                {s.paymentType === "Installment" && <InstallmentPanel data={data} setData={setData} sale={s} biz={biz} currentUserName={currentUserName} can={can} />}
              </div>
            );
          })}
        </Modal>
      )}
    </div>
  );
}

/* ============================ RECOVERY TAB ============================ */
function RecoveryTab({ data, setData, biz, currentUserName, can }) {
  const pending = useMemo(() => data.sales.filter(s => s.paymentType === "Installment").map(s => {
    const credit = saleCredit(s);
    const next = nextDueInfo(s);
    let statusTag = "onTrack";
    if (next) {
      const diffDays = Math.round((new Date(next.dueDate) - new Date(todayISO())) / 86400000);
      statusTag = diffDays < 0 ? "overdue" : diffDays <= 7 ? "dueSoon" : "onTrack";
    }
    return { ...s, credit, next, statusTag };
  }).filter(s => s.credit.remaining > 0), [data]);
  const [query, setQuery] = useState("");
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [sort, setSort] = useState("due:asc");
  const [expanded, setExpanded] = useState(null);
  const [imageReminderFor, setImageReminderFor] = useState(null);
  const reminders = useMemo(() => reminderList(data), [data]);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    let rows = pending.filter(s => {
      if (!inRange(s.date, dateFrom, dateTo)) return false;
      if (statusFilter !== "all" && s.statusTag !== statusFilter) return false;
      if (!q) return true;
      const imeis = saleItemsSummary(s, data).map(l => l.item && l.item.imei1).filter(Boolean);
      return [s.customerName, s.customerPhone, s.invoiceId, s.manualReceiptNumber, ...imeis].some(v => (v || "").toLowerCase().includes(q));
    });
    return sortRows(rows, sort, {
      date: s => s.date || "", name: s => s.customerName || "", amount: s => Number(s.salePrice) || 0,
      remaining: s => s.credit.remaining, due: s => (s.next ? s.next.dueDate : "9999-99-99"),
    });
  }, [pending, query, dateFrom, dateTo, statusFilter, sort, data]);

  return (
    <div>
      <h2 className="text-lg font-semibold text-slate-800 mb-4"><Bi en="Installment Collections" ur="بقایا اقساط کی وصولی" /></h2>

      {reminders.length > 0 && (
        <div className="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4">
          <h3 className="text-sm font-semibold text-amber-800 mb-2">Payment Reminders (Due within 7 days or Overdue) / یاد دہانیاں</h3>
          <div className="space-y-2">
            {reminders.map(r => {
              const customer = data.customers.find(c => c.id === r.sale.customerId) || (r.sale.customerPhone ? { name: r.sale.customerName, phone: r.sale.customerPhone } : null);
              const items = saleItemsSummary(r.sale, data);
              const dueInfo = { next: r.next, overdue: r.overdue };
              const link = customer && customer.phone ? waLink(customer.phone, buildReminderMessage(biz, r.sale, items, customer, dueInfo)) : null;
              return (
                <div key={r.sale.id} className="flex flex-wrap items-center justify-between gap-2 bg-white rounded-lg px-3 py-2 text-sm">
                  <div>
                    <b>{r.sale.customerName}</b> — {saleItemsLabel(r.sale, data)} — Due {fmtDate(r.next.dueDate)} ({fmtMoney(r.next.amount)})
                    {r.overdue ? <span className="ml-2 text-xs bg-rose-100 text-rose-700 px-2 py-0.5 rounded-full">Overdue</span> : <span className="ml-2 text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">Upcoming</span>}
                  </div>
                  <div className="flex gap-2">
                    {loadFeatureToggles().enablePaymentReminders && link && <a href={link} target="_blank" rel="noreferrer" className="bg-amber-600 text-white text-xs px-3 py-1.5 rounded-lg no-underline">Send WhatsApp Reminder</a>}
                    {loadFeatureToggles().enablePaymentReminders && <button onClick={() => setImageReminderFor({ sale: r.sale, items, customer, dueInfo })} className="bg-amber-700 text-white text-xs px-3 py-1.5 rounded-lg">Image Reminder</button>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
      {imageReminderFor && (
        <WhatsAppReminderModal biz={biz} sale={imageReminderFor.sale} items={imageReminderFor.items} customer={imageReminderFor.customer} dueInfo={imageReminderFor.dueInfo} onClose={() => setImageReminderFor(null)} />
      )}

      <ListFilterBar
        search={query} onSearch={setQuery} searchPlaceholder="Search customer, phone, invoice #, receipt #, IMEI..."
        from={dateFrom} onFrom={setDateFrom} to={dateTo} onTo={setDateTo}
        statusOptions={[{ value: "all", label: "All Statuses" }, { value: "overdue", label: "Overdue" }, { value: "dueSoon", label: "Due Soon (7 days)" }, { value: "onTrack", label: "On Track" }]}
        status={statusFilter} onStatus={setStatusFilter}
        sortOptions={[{ value: "due:asc", label: "Due Date: Soonest First" }, { value: "date:desc", label: "Sale Date: Newest First" }, { value: "date:asc", label: "Sale Date: Oldest First" }, { value: "name:asc", label: "Customer: A-Z" }, { value: "remaining:desc", label: "Remaining: High to Low" }, { value: "amount:desc", label: "Sale Amount: High to Low" }]}
        sort={sort} onSort={setSort}
      />
      <div className="bg-white rounded-xl border border-slate-200 overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="bg-slate-50 text-slate-500 uppercase text-xs"><tr><th className="text-left px-3 py-2">Customer</th><th className="text-left px-3 py-2">Item</th><th className="text-left px-3 py-2">Sale Price</th><th className="text-left px-3 py-2">Paid</th><th className="text-left px-3 py-2">Remaining</th><th className="text-left px-3 py-2">Status</th><th className="text-left px-3 py-2"></th></tr></thead>
          <tbody>
            {filtered.map(s => {
              const badge = s.statusTag === "overdue" ? { text: "Overdue", cls: "bg-rose-100 text-rose-700" } : s.statusTag === "dueSoon" ? { text: "Due Soon", cls: "bg-amber-100 text-amber-700" } : { text: "On Track", cls: "bg-emerald-100 text-emerald-700" };
              return (
                <React.Fragment key={s.id}>
                  <tr className="border-t border-slate-100 hover:bg-slate-50 cursor-pointer" onClick={() => setExpanded(expanded === s.id ? null : s.id)}>
                    <td className="px-3 py-2">{s.customerName || "-"} <div className="text-xs text-slate-400">{s.customerPhone}</div></td>
                    <td className="px-3 py-2">{saleItemsLabel(s, data)}</td>
                    <td className="px-3 py-2">{fmtMoney(s.salePrice)}</td>
                    <td className="px-3 py-2">{fmtMoney(s.credit.totalCredited)}</td>
                    <td className="px-3 py-2 font-semibold text-amber-600">{fmtMoney(s.credit.remaining)}</td>
                    <td className="px-3 py-2"><span className={"text-xs font-medium px-2 py-0.5 rounded-full " + badge.cls}>{badge.text}</span></td>
                    <td className="px-3 py-2 text-[var(--accent-600)] text-xs">{expanded === s.id ? "Hide ▲" : "Manage ▼"}</td>
                  </tr>
                  {expanded === s.id && (
                    <tr><td colSpan="7" className="px-3 pb-3"><InstallmentPanel data={data} setData={setData} sale={s} biz={biz} currentUserName={currentUserName} can={can} /></td></tr>
                  )}
                </React.Fragment>
              );
            })}
            {filtered.length === 0 && <tr><td colSpan="7" className="text-center text-slate-400 py-8">No pending installments match these filters &#127881;</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}

/* ============================ ACCOUNTS TAB ============================ */
function blankAccount() { return { name: "", type: "Cash", openingBalance: "0" }; }
function AccountsTab({ data, setData, role, can }) {
  const canAdd = can("add"), canEdit = can("edit"), canDelete = can("delete");
  const [showForm, setShowForm] = useState(false);
  const [editing, setEditing] = useState(null);
  const [account, setAccount] = useState(blankAccount());
  const [ledgerAccount, setLedgerAccount] = useState(null);
  const [deleting, setDeleting] = useState(null);

  function openAdd() { setAccount(blankAccount()); setEditing(null); setShowForm(true); }
  function openEdit(a) { setAccount(a); setEditing(a.id); setShowForm(true); }
  function submit() {
    if (!account.name.trim()) { alert("Account name required"); return; }
    if (editing) setData({ ...data, accounts: data.accounts.map(a => a.id === editing ? { ...account, id: editing } : a) });
    else setData({ ...data, accounts: [...data.accounts, { ...account, id: uid("acct") }] });
    setShowForm(false);
  }
  function doDelete() {
    if (data.accounts.length <= 1) { alert("At least one account must remain."); return; }
    setData({ ...data, accounts: data.accounts.filter(a => a.id !== deleting.id) }); setDeleting(null);
  }
  const ledgerRows = useMemo(() => {
    if (!ledgerAccount) return [];
    const rows = [];
    data.sales.forEach(s => {
      if (s.accountId === ledgerAccount.id && s.paidAmount) rows.push({ date: s.date, desc: "Sale - " + (s.customerName || "Customer") + " (" + (s.invoiceId || "") + ")", inAmt: Number(s.paidAmount) || 0, outAmt: 0 });
      (s.installmentPayments || []).forEach(p => { if (p.type !== "discount" && p.accountId === ledgerAccount.id) rows.push({ date: p.date, desc: "Installment - " + (s.customerName || "Customer"), inAmt: Number(p.amount) || 0, outAmt: 0 }); });
    });
    data.dealerPayments.forEach(p => { if (p.accountId === ledgerAccount.id) rows.push({ date: p.date, desc: "Dealer Payment - " + (data.dealers.find(d => d.id === p.dealerId)?.name || ""), inAmt: 0, outAmt: Number(p.amount) || 0 }); });
    (data.expenses || []).forEach(e => { if (e.accountId === ledgerAccount.id) rows.push({ date: e.date, desc: "Expense - " + e.category, inAmt: 0, outAmt: Number(e.amount) || 0 }); });
    (data.salaryPayments || []).forEach(p => { if (p.accountId === ledgerAccount.id) rows.push({ date: p.date, desc: "Salary - " + (data.staff.find(st => st.id === p.staffId)?.name || ""), inAmt: 0, outAmt: Number(p.amount) || 0 }); });
    (data.partnerTransactions || []).forEach(t => { if (t.type === "drawing" && t.accountId === ledgerAccount.id) rows.push({ date: t.date, desc: "Partner Drawing - " + (data.partners.find(pt => pt.id === t.partnerId)?.name || ""), inAmt: 0, outAmt: Number(t.amount) || 0 }); });
    rows.sort((a, b) => (a.date || "").localeCompare(b.date || ""));
    let running = Number(ledgerAccount.openingBalance) || 0;
    return rows.map(r => { running += r.inAmt - r.outAmt; return { ...r, running }; });
  }, [data, ledgerAccount]);

  return (
    <div>
      <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h2 className="text-lg font-semibold text-slate-800"><Bi en="Accounts / Bank Ledger" ur="اکاؤنٹس" /></h2>
        {canAdd && <button onClick={openAdd} className="bg-[var(--accent-600)] hover:bg-[var(--accent-700)] text-white text-sm font-medium px-4 py-2 rounded-lg">+ Add Account</button>}
      </div>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
        {data.accounts.map(a => (
          <div key={a.id} className="bg-white rounded-xl border border-slate-200 p-4 cursor-pointer hover:shadow-md" onClick={() => setLedgerAccount(a)}>
            <div className="text-xs uppercase text-slate-500">{a.type}</div>
            <div className="font-semibold text-slate-800">{a.name}</div>
            <div className="text-xl font-bold text-[var(--accent-600)] mt-1">{fmtMoney(accountBalance(data, a.id))}</div>
            {(canEdit || canDelete) && <div className="flex gap-2 mt-2" onClick={e => e.stopPropagation()}>
              {canEdit && <button onClick={() => openEdit(a)} className="text-xs text-slate-500 hover:text-[var(--accent-600)]">Edit</button>}
              {canDelete && <button onClick={() => setDeleting(a)} className="text-xs text-slate-500 hover:text-rose-600">Delete</button>}
            </div>}
          </div>
        ))}
      </div>

      {showForm && (
        <Modal title={editing ? "Edit Account" : "Add Account"} ur="اکاؤنٹ" onClose={() => setShowForm(false)}>
          <Field label="Account Name" ur="نام" required><TextInput value={account.name} onChange={e => setAccount({ ...account, name: e.target.value })} placeholder="e.g. Meezan Bank, JazzCash" /></Field>
          <Field label="Type" ur="قسم"><Select value={account.type} onChange={e => setAccount({ ...account, type: e.target.value })} options={ACCOUNT_TYPES} /></Field>
          <Field label="Opening Balance" ur="ابتدائی رقم"><TextInput type="number" value={account.openingBalance} onChange={e => setAccount({ ...account, openingBalance: e.target.value })} /></Field>
          <div className="flex justify-end gap-2 mt-4">
            <button onClick={() => setShowForm(false)} className="px-4 py-2 text-sm rounded-lg border border-slate-300 text-slate-600">Cancel</button>
            <button onClick={submit} className="px-4 py-2 text-sm rounded-lg bg-[var(--accent-600)] text-white hover:bg-[var(--accent-700)]">Save</button>
          </div>
        </Modal>
      )}
      {deleting && (
        <Modal title="Delete Account?" onClose={() => setDeleting(null)}>
          <p className="text-sm text-slate-600">Delete <b>{deleting.name}</b>? Historical transactions referencing it will remain but show as unlinked.</p>
          <ConfirmBar onCancel={() => setDeleting(null)} onConfirm={doDelete} />

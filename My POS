          <thead className="bg-slate-50 text-slate-500 uppercase text-xs"><tr><th className="text-left px-3 py-2">Dealer</th><th className="text-left px-3 py-2">Contact</th><th className="text-left px-3 py-2">Phone</th><th className="text-left px-3 py-2">City</th><th className="text-left px-3 py-2">Balance Payable</th><th className="text-left px-3 py-2">Actions</th></tr></thead>

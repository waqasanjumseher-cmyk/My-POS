function sortRows(rows, sort, getters) {
  const [key, dir] = sort.split(":");
  const g = getters[key];
  if (!g) return rows;
  const out = [...rows].sort((a, b) => {
    const va = g(a), vb = g(b);
    if (typeof va === "string") return va.localeCompare(vb);
    return (Number(va) || 0) - (Number(vb) || 0);
  });
  if (dir === "desc") out.reverse();
  return out;
}

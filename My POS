/* Lets anyone using this app add their own Firebase project's keys, or turn cloud sync off, from
   Settings > Cloud Sync — see the FIREBASE_USER_CONFIG_KEY block near the top of this script.
   Saving/disabling triggers a full page reload so the app re-initializes cleanly from one source
   of truth rather than trying to hot-swap live Firebase SDK objects mid-session. */
function FirebaseConfigPanel() {
  const existing = loadFirebaseUserConfig();
  const seedConfig = existing ? existing.config : FIREBASE_BUILTIN_CONFIG;
  const [enabled, setEnabled] = useState(existing ? !!existing.enabled : CLOUD_ENABLED);
  const [form, setForm] = useState({
    apiKey: seedConfig.apiKey || "", authDomain: seedConfig.authDomain || "", projectId: seedConfig.projectId || "",
    storageBucket: seedConfig.storageBucket || "", messagingSenderId: seedConfig.messagingSenderId || "", appId: seedConfig.appId || "",
  });
  const [expanded, setExpanded] = useState(!CLOUD_ENABLED);
  function set(key, val) { setForm({ ...form, [key]: val }); }
  function handleSave() {
    if (enabled && (!form.apiKey.trim() || !form.projectId.trim())) { alert("API Key and Project ID are required to enable cloud sync."); return; }
    if (!confirm("Save these Firebase settings? The page will reload to apply them.")) return;
    saveFirebaseUserConfig({ enabled, config: form });
    window.location.reload();
  }
  function handleUseDefault() {
    if (!confirm("Remove your custom Firebase settings and go back to this app's built-in default? Page will reload.")) return;
    localStorage.removeItem(FIREBASE_USER_CONFIG_KEY);
    window.location.reload();
  }
  function handleDisable() {
    if (!confirm("Turn off cloud sync? The app will run fully offline/local until you re-enable it here. Page will reload.")) return;
    saveFirebaseUserConfig({ enabled: false, config: form });
    window.location.reload();
  }
  return (
    <div className="border-t border-slate-200 pt-4 mt-4">
      <button onClick={() => setExpanded(e => !e)} className="text-xs font-medium text-[var(--accent-600)] hover:underline mb-3">
        {expanded ? "Hide Firebase Settings" : "\u2699\uFE0F Add / Change Firebase Keys"}
      </button>
      {expanded && (
        <div className="space-y-3">
          <ToggleSwitch label="Enable Cloud Sync with these keys" ur="کلاؤڈ سنک فعال کریں" checked={enabled} onChange={setEnabled} />
          <p className="text-[11px] text-slate-400">
            Create a free project at{" "}
            <a href="https://console.firebase.google.com" target="_blank" rel="noopener noreferrer" className="text-[var(--accent-600)] underline">console.firebase.google.com</a>,
            add a Web App, and paste its config values below. Anyone using this app can plug in their own project this way — these keys are saved only in this browser's LocalStorage; this app never sends them anywhere else.
          </p>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <Field label="API Key"><TextInput value={form.apiKey} onChange={e => set("apiKey", e.target.value)} /></Field>
            <Field label="Project ID"><TextInput value={form.projectId} onChange={e => set("projectId", e.target.value)} /></Field>
            <Field label="Auth Domain"><TextInput value={form.authDomain} onChange={e => set("authDomain", e.target.value)} placeholder="yourproject.firebaseapp.com" /></Field>
            <Field label="Storage Bucket"><TextInput value={form.storageBucket} onChange={e => set("storageBucket", e.target.value)} placeholder="yourproject.firebasestorage.app" /></Field>
            <Field label="Messaging Sender ID"><TextInput value={form.messagingSenderId} onChange={e => set("messagingSenderId", e.target.value)} /></Field>
            <Field label="App ID"><TextInput value={form.appId} onChange={e => set("appId", e.target.value)} /></Field>
          </div>
          <div className="flex flex-wrap gap-2 pt-1">
            <button onClick={handleSave} className="bg-[var(--accent-600)] hover:bg-[var(--accent-700)] text-white text-xs font-medium px-4 py-2 rounded-lg">Save &amp; Reload</button>
            {CLOUD_ENABLED && <button onClick={handleDisable} className="text-xs px-3 py-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50">Disable Cloud Sync</button>}
            {existing && <button onClick={handleUseDefault} className="text-xs px-3 py-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50">Reset to App Default</button>}
          </div>
        </div>
      )}
    </div>
  );
}


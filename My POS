/* ============================ FORGOT PASSWORD (OTP) ============================ */
function ForgotPasswordPanel({ users, onResetPassword, onBack }) {
  const [step, setStep] = useState("request"); // request | verify | reset | done
  const [identifier, setIdentifier] = useState("");
  const [matchedUser, setMatchedUser] = useState(null);
  const [otpInput, setOtpInput] = useState("");
  const [newPw, setNewPw] = useState("");
  const [confirmPw, setConfirmPw] = useState("");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);
  const [emailFailed, setEmailFailed] = useState(false);
  // Fallback OTP display: whenever the live EmailJS dispatch fails (or EmailJS isn't configured
  // yet, e.g. during testing), we never leave the user stuck waiting on an email that isn't
  // coming — the same code that was just generated is shown safely on-screen instead.
  const [fallbackOtp, setFallbackOtp] = useState("");
  const [copied, setCopied] = useState(false);

  async function issueOtp(user) {
    const otp = generateOtp();
    storeOtp(user.id, otp);
    setCopied(false);
    const sent = await sendOtpEmail(user.email, user.name, otp);
    setEmailFailed(!sent);
    setFallbackOtp(sent ? "" : otp);
  }
  function copyFallbackOtp() {
    try { navigator.clipboard.writeText(fallbackOtp); setCopied(true); setTimeout(() => setCopied(false), 1500); } catch (e) {}
  }
  async function requestOtp(e) {
    e.preventDefault(); setError("");
    const idr = identifier.trim().toLowerCase();
    const user = users.find(u => (u.email && u.email.trim().toLowerCase() === idr) || u.username.trim().toLowerCase() === idr);
    if (!user) { setError("No account found with that email or username."); return; }
    if (!user.email) { setError("This account has no registered email on file. Ask an Admin to add one in Settings \u2192 Manage Users, or to reset your password directly."); return; }
    setBusy(true);
    await issueOtp(user);
    setBusy(false);
    setMatchedUser(user);
    setStep("verify");
  }
  async function resend() {
    setError(""); setBusy(true);
    await issueOtp(matchedUser);
    setBusy(false);
  }
  function verify(e) {
    e.preventDefault();
    const err = verifyOtp(matchedUser.id, otpInput);
    if (err) { setError(err); return; }
    setError(""); setStep("reset");
  }
  function submitReset(e) {
    e.preventDefault();
    if (newPw.length < 4) { setError("Password should be at least 4 characters."); return; }
    if (newPw !== confirmPw) { setError("Passwords do not match."); return; }
    onResetPassword(matchedUser.id, newPw);
    clearOtp();
    setStep("done");
  }

  if (step === "done") {
    return (
      <div className="text-center">
        <div className="w-14 h-14 mx-auto mb-3 rounded-2xl bg-[linear-gradient(135deg,#10b981,#0d9488)] shadow-lg flex items-center justify-center text-2xl">&#9989;</div>
        <div className="text-sm text-slate-700 mb-4">Password reset successfully. You can now log in with your new password.</div>
        <button onClick={onBack} className="w-full bg-[linear-gradient(135deg,#4f46e5,#7c3aed)] hover:brightness-110 active:scale-[0.98] shadow-md shadow-[var(--accent-500)]/25 transition text-white text-sm font-medium px-4 py-2.5 rounded-xl">Back to Login</button>
      </div>
    );
  }
  if (step === "reset") {
    return (
      <form onSubmit={submitReset}>
        <div className="text-sm font-semibold text-slate-800 mb-3">Set a New Password</div>
        <Field label="New Password" required><TextInput type="password" value={newPw} onChange={e => setNewPw(e.target.value)} autoFocus /></Field>
        <Field label="Confirm Password" required><TextInput type="password" value={confirmPw} onChange={e => setConfirmPw(e.target.value)} /></Field>
        {error && <div className="text-xs text-rose-500 mb-3">{error}</div>}
        <button type="submit" className="w-full bg-[linear-gradient(135deg,#4f46e5,#7c3aed)] hover:brightness-110 active:scale-[0.98] shadow-md shadow-[var(--accent-500)]/25 transition text-white text-sm font-medium px-4 py-2.5 rounded-xl">Set New Password</button>
      </form>
    );
  }
  if (step === "verify") {
    return (
      <form onSubmit={verify}>
        <div className="text-sm font-semibold text-slate-800 mb-1">Enter Verification Code</div>
        <div className="text-xs text-slate-500 mb-3">A 6-digit code was sent to {matchedUser.email}. It expires in 10 minutes.</div>
        {emailFailed && (
          fallbackOtp ? (
            <div className="relative overflow-hidden rounded-2xl mb-4 p-4 shadow-lg ring-1 ring-black/5 bg-[linear-gradient(135deg,#4f46e5,#7c3aed_50%,#db2777)]">
              <div className="pointer-events-none absolute -top-8 -right-8 w-28 h-28 rounded-full bg-white/10 blur-2xl"></div>
              <div className="pointer-events-none absolute -bottom-10 -left-6 w-24 h-24 rounded-full bg-white/10 blur-2xl"></div>
              <div className="relative flex items-start gap-2.5">
                <div className="text-xl leading-none mt-0.5">&#9889;</div>
                <div className="min-w-0 flex-1">
                  <div className="text-white text-xs font-semibold mb-0.5">Email couldn't be confirmed — here's your code</div>
                  <div className="text-white/80 text-[11px] mb-2.5">Live email delivery didn't go through (or isn't set up yet), so as a safety net your code is shown right here — no need to wait on an inbox.</div>
                  <div className="flex items-center gap-2">
                    <div className="flex-1 bg-white/95 rounded-xl px-3 py-2 text-center">
                      <span className="text-2xl font-mono font-bold tracking-[0.4em] text-slate-800">{fallbackOtp}</span>
                    </div>
                    <button type="button" onClick={copyFallbackOtp} className="shrink-0 bg-white/20 hover:bg-white/30 active:scale-95 text-white text-xs font-medium px-3 py-2.5 rounded-xl transition">{copied ? "Copied!" : "Copy"}</button>
                  </div>
                  <button type="button" onClick={() => setOtpInput(fallbackOtp)} className="mt-2 text-[11px] text-white/90 hover:text-white underline underline-offset-2">Auto-fill this code below</button>
                </div>
              </div>
            </div>
          ) : (
            <div className="text-xs bg-rose-50 text-rose-700 border border-rose-200 rounded-lg px-3 py-2 mb-3">We couldn't confirm the email sent just now. Please check the inbox (and spam folder) for {matchedUser.email}, or tap Resend below.</div>
          )
        )}
        <Field label="6-Digit Code" required>
          <input
            type="text"
            inputMode="numeric"
            autoComplete="one-time-code"
            pattern="[0-9]*"
            value={otpInput}
            onChange={e => setOtpInput(e.target.value.replace(/\D/g, "").slice(0, 6))}
            maxLength={6}
            autoFocus
            placeholder="000000"
            className="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-2xl font-mono tracking-[0.5em] text-center focus:outline-none focus:ring-2 focus:ring-[var(--accent-400)] focus:border-[var(--accent-400)] bg-white"
          />
        </Field>
        {error && <div className="text-xs text-rose-500 mb-3">{error}</div>}
        <button
          type="submit"
          disabled={otpInput.length !== 6}
          className={"w-full text-sm font-medium px-4 py-2.5 rounded-xl transition " + (otpInput.length === 6 ? "bg-[linear-gradient(135deg,#4f46e5,#7c3aed)] hover:brightness-110 active:scale-[0.98] shadow-md shadow-[var(--accent-500)]/25 text-white" : "bg-slate-200 text-slate-400 cursor-not-allowed")}
        >
          Verify Code
        </button>
        <div className="flex justify-between mt-3">
          <button type="button" onClick={onBack} className="text-xs text-slate-500 hover:underline">Back to Login</button>
          <button type="button" disabled={busy} onClick={resend} className="text-xs text-[var(--accent-600)] hover:underline disabled:opacity-60">{busy ? "Sending..." : "Resend code"}</button>
        </div>
      </form>
    );
  }
  return (
    <form onSubmit={requestOtp}>
      <div className="text-sm font-semibold text-slate-800 mb-1">Forgot Password</div>
      <div className="text-xs text-slate-500 mb-3">Enter your registered email (or username) and we'll send a verification code to reset your password.</div>
      <Field label="Email or Username" required><TextInput value={identifier} onChange={e => setIdentifier(e.target.value)} autoFocus /></Field>
      {error && <div className="text-xs text-rose-500 mb-3">{error}</div>}
      <button type="submit" disabled={busy} className="w-full bg-[linear-gradient(135deg,#4f46e5,#7c3aed)] hover:brightness-110 active:scale-[0.98] disabled:opacity-60 shadow-md shadow-[var(--accent-500)]/25 transition text-white text-sm font-medium px-4 py-2.5 rounded-xl">{busy ? "Sending..." : "Send Code"}</button>
      <button type="button" onClick={onBack} className="w-full text-xs text-slate-500 hover:underline mt-3">Back to Login</button>
    </form>
  );
}

/* ======================= FIRST-RUN WELCOME & SETUP WIZARD =======================
   Shown only once, the very first time the app link is opened on a fresh browser
   (before the very first Login screen is ever rendered). Guides the person through:
     1) Welcome — explains the system can be configured for any business type
     2) Business Details — Business Name, Owner Name, Contact, Address
     3) Authentication/Security — set a custom username & password to secure the shop
        file, or explicitly skip and open the app with no login required
   Completion (or explicit skip) is recorded in SETUP_WIZARD_KEY so it never appears
   again on this browser. Purely additive: it edits the same `businesses`/`users`
   state App() already manages, via the setters passed in. */
function SetupWizard({ biz, setBusinesses, users, setUsers, onComplete }) {
  const [step, setStep] = useState(1); // 1 welcome | 2 business details | 3 authentication/security | 4 business type
  const STEP_COUNT = 4;

  /* ---- step 2: business details ---- */
  const [businessName, setBusinessName] = useState(biz && biz.name !== "Main Mobile Shop" ? biz.name : (biz ? biz.name : ""));
  const [ownerName, setOwnerName] = useState((biz && biz.ownerName) || "");
  const [contact, setContact] = useState((biz && biz.phone) || "");
  const [address, setAddress] = useState((biz && biz.address) || "");
  const [currencyCode, setCurrencyCode] = useState(() => loadCurrency().code);
  const [detailsError, setDetailsError] = useState("");

  function saveBusinessDetails() {
    if (!businessName.trim()) { setDetailsError("Please enter your business name."); return; }
    setDetailsError("");
    setBusinesses(prev => prev.map(b => b.id === biz.id ? {
      ...b,
      name: businessName.trim(),
      header: businessName.trim(),
      ownerName: ownerName.trim(),
      phone: contact.trim(),
      address: address.trim(),
    } : b));
    saveJSON(CURRENCY_KEY, CURRENCY_PRESETS.find(c => c.code === currencyCode) || CURRENCY_PRESETS[0]);
    setStep(3);
  }

  /* ---- step 3: Authentication/Security ----
     The person can either set their own username & password (stored on the admin account,
     replacing the admin/admin123 default and enforced on the login screen going forward), or
     tap "Continue without Password" to skip authentication entirely — the app will then open
     directly, with no login screen, until Login is turned back on later from Settings ->
     Advanced Customization -> Feature Toggles -> Require Login (Authentication). */
  const adminUser = users.find(u => u.username === "admin") || users[0];
  const [customUsername, setCustomUsername] = useState(adminUser && adminUser.username !== "admin" ? adminUser.username : "");
  const [customPassword, setCustomPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [securityError, setSecurityError] = useState("");

  function activateWithCredentials() {
    const uname = customUsername.trim();
    if (!uname) { setSecurityError("Enter a username, or use \u201cContinue without Password\u201d below to skip authentication."); return; }
    if (customPassword.length < 6) { setSecurityError("Password must be at least 6 characters."); return; }
    if (customPassword !== confirmPassword) { setSecurityError("Passwords don't match."); return; }
    if (users.some(u => u.id !== adminUser.id && u.username.trim().toLowerCase() === uname.toLowerCase())) { setSecurityError("That username is already taken by another account."); return; }
    setSecurityError("");
    // Save the credentials on the admin account and make sure login enforcement is on.
    setUsers(prev => prev.map(u => u.id === adminUser.id ? { ...u, username: uname, password: customPassword } : u));
    saveJSON(FEATURE_TOGGLES_KEY, { ...loadFeatureToggles(), enableAuthentication: true });
    setStep(4);
  }
  function skipAuthentication() {
    // No credentials saved — disable the login requirement entirely so the app opens straight
    // to the dashboard from now on. The admin account (and its default admin/admin123 password,
    // unless changed here) is left untouched, ready to use the moment Login is re-enabled later.
    saveJSON(FEATURE_TOGGLES_KEY, { ...loadFeatureToggles(), enableAuthentication: false });
    setStep(4);
  }

  /* ---- step 4 (final): Business Type ----
     Saves to the SAME isolated LocalStorage key (CUSTOM_BUSINESS_TYPE_KEY) that Inventory, Sales,
     Purchases, and Advanced Customization already read on every render (see categoryConfig() /
     allCategories() / getBusinessAccessoryOptions() near the top of this script) — so the moment
     this step is saved and the wizard closes, the very next screen the person sees (the Dashboard)
     already reflects the right categories, ID fields (IMEI/Serial/none), and extra fields
     (expiry date, batch number, size/dimensions, etc.) for their trade. Nothing else needs to
     change or reload for this to take effect; it's the same mechanism the "Business Type" quick
     switcher on the Inventory page and Business Presets in Settings already use. Can always be
     changed again later from either of those places — this step just sets the starting point. */
  const BUSINESS_TYPE_ICONS = {
    mobile_shop: "\u{1F4F1}", pharmacy: "\u{1F48A}", crockery: "\u{1F37D}\uFE0F", grocery: "\u{1F6D2}",
    general_store: "\u{1F3EA}", tiles_ceramics: "\u{1F9F1}", ceiling_paneling: "\u{1F3E0}", hotel: "\u{1F3E8}",
    fast_food: "\u{1F354}", other: "\u{1F9E9}",
  };
  const [businessType, setBusinessTypeStep] = useState(() => loadJSON(CUSTOM_BUSINESS_TYPE_KEY, "mobile_shop"));
  function finishWithBusinessType() {
    saveJSON(CUSTOM_BUSINESS_TYPE_KEY, businessType);
    finish();
  }

  function finish() { saveJSON(SETUP_WIZARD_KEY, true); onComplete(); }

  const stepLabels = ["Welcome", "Business Details", "Authentication", "Business Type"];

  return (
    <div className="min-h-screen relative flex items-center justify-center p-4 overflow-hidden bg-[linear-gradient(160deg,#0f172a,#111827_55%,#0c1e1c)]">
      <div className="pointer-events-none absolute -top-24 -left-20 w-80 h-80 rounded-full bg-emerald-500/10 blur-3xl"></div>
      <div className="pointer-events-none absolute -bottom-28 -right-16 w-96 h-96 rounded-full bg-teal-400/10 blur-3xl"></div>
      <div className="pointer-events-none absolute top-1/4 right-1/3 w-64 h-64 rounded-full bg-cyan-500/5 blur-3xl"></div>
      <div className="pointer-events-none absolute inset-0 opacity-[0.04]" style={{ backgroundImage: "radial-gradient(#fff 1px, transparent 1px)", backgroundSize: "22px 22px" }}></div>

      <div className="relative w-full max-w-md">
        <div className="bg-white/[0.98] backdrop-blur rounded-3xl shadow-2xl ring-1 ring-black/5 w-full p-7">

          {/* progress indicator */}
          <div className="flex items-center gap-2 mb-6">
            {stepLabels.map((label, i) => {
              const n = i + 1;
              const active = n === step, done = n < step;
              return (
                <div key={label} className="flex-1 flex items-center gap-2">
                  <div className={"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 " +
                    (done ? "bg-emerald-500 text-white" : active ? "bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] text-white" : "bg-slate-100 text-slate-400")}>
                    {done ? "\u2713" : n}
                  </div>
                  {n < STEP_COUNT && <div className={"h-0.5 flex-1 rounded " + (done ? "bg-emerald-500" : "bg-slate-100")}></div>}
                </div>
              );
            })}
          </div>
          <div className="text-center text-[11px] font-medium text-slate-400 tracking-wide uppercase mb-5">Step {step} of {STEP_COUNT} &middot; {stepLabels[step - 1]}</div>

          {/* ---- Step 1: Welcome ---- */}
          {step === 1 && (
            <div className="text-center">
              <div className="w-16 h-16 rounded-full mx-auto mb-4 shadow-md ring-4 ring-emerald-50 bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] text-white flex items-center justify-center text-2xl">
                &#128075;
              </div>
              <h1 className="text-2xl font-extrabold text-slate-800 tracking-tight mb-2">Welcome to Shop ERP</h1>
              <p className="text-sm text-slate-500 leading-relaxed mb-6">
                Let's get your workspace ready. This system isn't locked to one kind of shop &mdash;
                it can be configured for <span className="font-semibold text-slate-700">any business type</span>,
                whether you run a mobile shop, a pharmacy, a hardware store, or something else entirely.
                This quick setup takes less than a minute.
              </p>
              <button type="button" onClick={() => setStep(2)} className="w-full bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] hover:brightness-110 active:scale-[0.98] text-white text-sm font-semibold px-4 py-3 rounded-xl shadow-lg shadow-teal-900/20 transition">
                Next &rarr;
              </button>
            </div>
          )}

          {/* ---- Step 2: Business Details ---- */}
          {step === 2 && (
            <div>
              <h2 className="text-lg font-bold text-slate-800 mb-1">Tell us about your business</h2>
              <p className="text-xs text-slate-500 mb-5">This appears on receipts, invoices, and throughout the app. You can always change it later in Settings.</p>
              <Field label="Business Name" required><TextInput value={businessName} onChange={e => setBusinessName(e.target.value)} placeholder="e.g. Al-Falah Mobile Shop" autoFocus className="rounded-xl py-2.5" /></Field>
              <Field label="Owner Name"><TextInput value={ownerName} onChange={e => setOwnerName(e.target.value)} placeholder="e.g. Ahmed Khan" className="rounded-xl py-2.5" /></Field>
              <Field label="Contact"><TextInput value={contact} onChange={e => setContact(e.target.value)} placeholder="Phone number" className="rounded-xl py-2.5" /></Field>
              <Field label="Address"><TextInput value={address} onChange={e => setAddress(e.target.value)} placeholder="Shop address" className="rounded-xl py-2.5" /></Field>
              <Field label="Currency"><Select value={currencyCode} onChange={e => setCurrencyCode(e.target.value)} options={CURRENCY_PRESETS.map(c => ({ value: c.code, label: c.code + " (" + c.symbol + ")" }))} className="rounded-xl py-2.5" /></Field>
              {detailsError && <div className="text-xs text-rose-500 mb-3">{detailsError}</div>}
              <div className="flex gap-2 mt-2">
                <button type="button" onClick={() => setStep(1)} className="flex-1 bg-slate-100 hover:bg-slate-200 active:scale-[0.98] text-slate-600 text-sm font-semibold px-4 py-3 rounded-xl transition">&larr; Back</button>
                <button type="button" onClick={saveBusinessDetails} className="flex-[2] bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] hover:brightness-110 active:scale-[0.98] text-white text-sm font-semibold px-4 py-3 rounded-xl shadow-lg shadow-teal-900/20 transition">Next &rarr;</button>
              </div>
            </div>
          )}

          {/* ---- Step 3: Authentication / Security ---- */}
          {step === 3 && (
            <div>
              <h2 className="text-lg font-bold text-slate-800 mb-1">Secure your shop file</h2>
              <p className="text-xs text-slate-500 mb-5">
                Set your own username &amp; password to require a login every time this app opens, or skip
                this step to open the app directly with no login &mdash; you can turn login on or off anytime
                later from Settings.
              </p>

              <Field label="Username"><TextInput value={customUsername} onChange={e => setCustomUsername(e.target.value)} placeholder="e.g. shopowner" className="rounded-xl py-2.5" autoFocus /></Field>
              <Field label="Password"><TextInput type="password" value={customPassword} onChange={e => setCustomPassword(e.target.value)} placeholder="Min 6 characters" className="rounded-xl py-2.5" /></Field>
              <Field label="Confirm Password"><TextInput type="password" value={confirmPassword} onChange={e => setConfirmPassword(e.target.value)} className="rounded-xl py-2.5" /></Field>
              {securityError && <div className="text-xs text-rose-500 mb-3">{securityError}</div>}

              <div className="flex gap-2 mt-2">
                <button type="button" onClick={() => setStep(2)} className="flex-1 bg-slate-100 hover:bg-slate-200 active:scale-[0.98] text-slate-600 text-sm font-semibold px-4 py-3 rounded-xl transition">&larr; Back</button>
                <button type="button" onClick={activateWithCredentials} className="flex-[2] bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] hover:brightness-110 active:scale-[0.98] text-white text-sm font-semibold px-4 py-3 rounded-xl shadow-lg shadow-teal-900/20 transition">Activate &amp; Next &rarr;</button>
              </div>

              <div className="flex items-center gap-3 my-4"><div className="flex-1 h-px bg-slate-200"></div><div className="text-[11px] text-slate-400 font-medium">OR</div><div className="flex-1 h-px bg-slate-200"></div></div>

              <button type="button" onClick={skipAuthentication} className="w-full bg-white hover:bg-slate-50 active:scale-[0.98] text-slate-600 text-sm font-medium px-4 py-2.5 rounded-xl border border-slate-200 transition">
                Continue without Password
              </button>
              <p className="text-[11px] text-slate-400 text-center mt-2">Anyone with access to this device will be able to open the shop without signing in. You can require a login again anytime in Settings &rarr; Advanced Customization &rarr; Feature Toggles.</p>
            </div>
          )}

          {/* ---- Step 4: Business Type (final step) ---- */}
          {step === 4 && (
            <div>
              <h2 className="text-lg font-bold text-slate-800 mb-1">What kind of business is this?</h2>
              <p className="text-xs text-slate-500 mb-5">
                This adjusts Inventory categories, item fields (like IMEI, expiry date, or size/dimensions),
                and a few Dashboard defaults to match your trade. You can change this anytime later from
                Settings &rarr; Advanced Customization, or from the switcher on the Inventory page.
              </p>
              <div className="grid grid-cols-2 gap-2 mb-5 max-h-72 overflow-y-auto pr-1">
                {Object.values(CUSTOM_BUSINESS_TYPES).map(bt => (
                  <button key={bt.id} type="button" onClick={() => setBusinessTypeStep(bt.id)}
                    className={"flex flex-col items-center justify-center gap-1.5 text-center px-3 py-4 rounded-xl border-2 transition " +
                      (businessType === bt.id ? "border-teal-500 bg-teal-50 shadow-sm" : "border-slate-150 bg-slate-50 hover:bg-slate-100 border-slate-100")}>
                    <span className="text-2xl">{BUSINESS_TYPE_ICONS[bt.id] || "\u{1F3EA}"}</span>
                    <span className={"text-xs font-medium leading-tight " + (businessType === bt.id ? "text-teal-700" : "text-slate-600")}>{bt.label}</span>
                  </button>
                ))}
              </div>
              <div className="flex gap-2 mt-2">
                <button type="button" onClick={() => setStep(3)} className="flex-1 bg-slate-100 hover:bg-slate-200 active:scale-[0.98] text-slate-600 text-sm font-semibold px-4 py-3 rounded-xl transition">&larr; Back</button>
                <button type="button" onClick={finishWithBusinessType} className="flex-[2] bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] hover:brightness-110 active:scale-[0.98] text-white text-sm font-semibold px-4 py-3 rounded-xl shadow-lg shadow-teal-900/20 transition">Finish Setup</button>
              </div>
              <p className="text-[11px] text-slate-400 text-center mt-3">Not sure, or your trade isn't listed? Pick "Other / General Business" &mdash; you can name it and customize its categories afterward in Settings.</p>
            </div>
          )}
        </div>
        <div className="text-center text-white/50 text-[11px] mt-4">Shop ERP &middot; Offline-First, Cloud-Synced</div>
      </div>
    </div>
  );
}

function LoginScreen({ users, setUsers, onLogin, onResetPassword, biz, cloudUser, cloudReady }) {
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const featureToggles = loadFeatureToggles();
  const [mode, setMode] = useState("login"); // login | forgot | register
  const isDefaultAdmin = users.length === 1 && users[0].username === "admin" && users[0].password === "admin123";

  /* Self-registration: anyone can request an account, but it starts life as "Pending" and can't
     sign in until an Admin approves it from Settings -> Manage Users. Defaults to the least-
     privileged role so a pending/newly-approved account never has more access than an Admin
     explicitly grants afterward. */
  const [regName, setRegName] = useState(""); const [regEmail, setRegEmail] = useState("");
  const [regPass, setRegPass] = useState(""); const [regConfirm, setRegConfirm] = useState("");
  const [regError, setRegError] = useState(""); const [regBusy, setRegBusy] = useState(false);
  const [regDone, setRegDone] = useState(false);
  async function submitRegister(e) {
    e.preventDefault(); setRegError("");
    const name = regName.trim(), email = regEmail.trim().toLowerCase();
    if (!name) { setRegError("Enter your full name."); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setRegError("Enter a valid email address."); return; }
    if (regPass.length < 6) { setRegError("Password must be at least 6 characters."); return; }
    if (regPass !== regConfirm) { setRegError("Passwords don't match."); return; }
    if (users.some(u => u.email && u.email.trim().toLowerCase() === email)) { setRegError("An account with this email already exists."); return; }
    if (users.some(u => u.username.trim().toLowerCase() === email)) { setRegError("An account with this email already exists."); return; }
    setRegBusy(true);
    if (CLOUD_ENABLED) {
      // Authenticates them with Firebase right away so (a) they can later sign in via Cloud/Google
      // with this same email+password once approved, and (b) this device is now allowed to write
      // the shared roster doc, which is what lets the Admin see this registration on another device.
      try { await cloudSignUp(email, regPass); }
      catch (err) {
        if (err && err.code === "auth/email-already-in-use") { try { await cloudSignIn(email, regPass); } catch (e2) { /* fall through — still register locally below */ } }
      }
    }
    const newUser = { id: uid("user"), username: email, password: regPass, name, email, role: "Sales Officer", permissions: defaultPermsForRole("Sales Officer"), status: featureToggles.enableAdminApproval ? "Pending" : "Active" };
    setUsers([...users, newUser]);
    setRegBusy(false); setRegDone(true);
  }

  /* Cloud (Firebase Auth) sign-in is a fully separate, optional path — it exists so an Admin can
     also sign in on other devices with the same email/password and (once cloud sync is wired to
     that account) see the same data. It never blocks or replaces local login. */
  const [cloudMode, setCloudMode] = useState(false);
  const [cEmail, setCEmail] = useState(""); const [cPass, setCPass] = useState("");
  const [cError, setCError] = useState(""); const [cBusy, setCBusy] = useState(false);
  const [cIsSignup, setCIsSignup] = useState(false);

  /* Sign in with Google: one click, no separate username/password step. The signed-in Google
     account's email is matched against the `email` field on an existing system user (inquiry
     officer, sales officer, manager, admin — whichever an Admin has linked in Settings -> Manage
     Users) and that user's already-configured View/Add/Edit/Delete permissions are applied
     immediately, exactly as if they had typed their username/password. */
  const [gBusy, setGBusy] = useState(false); const [gError, setGError] = useState("");
  async function handleGoogleSignIn() {
    setGError(""); setGBusy(true);
    try {
      const result = await cloudSignInWithGoogle();
      const googleEmail = result.user && result.user.email;
      const matched = findUserByEmail(users, googleEmail);
      if (!matched) {
        setGError("This Google account (" + googleEmail + ") isn't linked to any system user yet. Ask an Admin to add it in Settings \u2192 Manage Users (Email field), then try again.");
        cloudSignOut().catch(() => {}); // don't leave a dangling cloud session with no mapped role
      } else if (matched.status === "Pending") {
        setGError("Your account is awaiting Admin approval. You'll be able to sign in as soon as it's approved.");
      } else {
        onLogin(matched); // applies matched.role / matched.permissions immediately
      }
    } catch (err) {
      if (err && err.code !== "auth/popup-closed-by-user") setGError(err.message || "Google sign-in failed.");
    }
    setGBusy(false);
  }

  function submit(e) {
    e.preventDefault();
    const u = findUser(users, username, password);
    if (!u) { setError("Invalid username or password. / غلط یوزر نیم یا پاسورڈ"); return; }
    if (u.status === "Pending") { setError("Your account is awaiting Admin approval. You'll be able to sign in as soon as it's approved."); return; }
    setError(""); onLogin(u);
  }
  async function submitCloud(e) {
    e.preventDefault(); setCError(""); setCBusy(true);
    try {
      if (cIsSignup) await cloudSignUp(cEmail, cPass); else await cloudSignIn(cEmail, cPass);
      // onAuthStateChanged in App() picks up the session; local role login is still required
      // once, right after, to map this device/session to a shop role.
    } catch (err) { setCError(err.message || "Sign-in failed."); }
    setCBusy(false);
  }

  return (
    <div className="min-h-screen relative flex items-center justify-center p-4 overflow-hidden bg-[linear-gradient(160deg,#0f172a,#111827_55%,#0c1e1c)]">
      {/* Decorative background glow — purely cosmetic, no effect on layout/logic */}
      <div className="pointer-events-none absolute -top-24 -left-20 w-80 h-80 rounded-full bg-emerald-500/10 blur-3xl"></div>
      <div className="pointer-events-none absolute -bottom-28 -right-16 w-96 h-96 rounded-full bg-teal-400/10 blur-3xl"></div>
      <div className="pointer-events-none absolute top-1/4 right-1/3 w-64 h-64 rounded-full bg-cyan-500/5 blur-3xl"></div>
      <div className="pointer-events-none absolute inset-0 opacity-[0.04]" style={{ backgroundImage: "radial-gradient(#fff 1px, transparent 1px)", backgroundSize: "22px 22px" }}></div>

      <div className="relative w-full max-w-sm">
        <div className="bg-white/[0.98] backdrop-blur rounded-3xl shadow-2xl ring-1 ring-black/5 w-full p-7">
          <div className="text-center mb-7">
            {biz && biz.logo ? (
              <img src={biz.logo} className="w-16 h-16 rounded-full object-cover mx-auto mb-3 shadow-md ring-4 ring-emerald-50" />
            ) : (
              <div className="w-16 h-16 rounded-full mx-auto mb-3 shadow-md ring-4 ring-emerald-50 bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] text-white flex items-center justify-center font-bold text-xl">
                {initials(biz ? (biz.header || biz.name) : "SE")}
              </div>
            )}
            <div className="font-extrabold text-2xl text-slate-800 tracking-tight">{biz ? (biz.header || biz.name) : "Shop ERP"}</div>
            <div className="text-xs text-slate-400 urdu mt-1">لاگ ان کریں</div>
          </div>

          {mode === "forgot" && featureToggles.enableForgotPassword ? (
            <ForgotPasswordPanel users={users} onResetPassword={onResetPassword} onBack={() => setMode("login")} />
          ) : mode === "register" && featureToggles.enableSelfRegistration ? (
            regDone ? (
              <div className="text-center py-4">
                <div className="w-14 h-14 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl mx-auto mb-3">&#10003;</div>
                <div className="text-sm font-semibold text-slate-800 mb-1">Registration successful!</div>
                <div className="text-sm text-slate-500 mb-5">{featureToggles.enableAdminApproval ? "Please wait for Admin approval." : "You can now log in."}</div>
                <button type="button" onClick={() => { setMode("login"); setRegDone(false); setRegName(""); setRegEmail(""); setRegPass(""); setRegConfirm(""); }} className="text-sm text-teal-700 hover:underline font-medium">Back to Login</button>
              </div>
            ) : (
              <form onSubmit={submitRegister}>
                <Field label="Full Name" ur="پورا نام" required><TextInput value={regName} onChange={e => setRegName(e.target.value)} autoFocus className="rounded-xl py-2.5" /></Field>
                <Field label="Email" ur="ای میل" required><TextInput type="email" value={regEmail} onChange={e => setRegEmail(e.target.value)} className="rounded-xl py-2.5" /></Field>
                <Field label="Password" ur="پاسورڈ" required><TextInput type="password" value={regPass} onChange={e => setRegPass(e.target.value)} placeholder="Min 6 characters" className="rounded-xl py-2.5" /></Field>
                <Field label="Confirm Password" ur="پاسورڈ کی تصدیق" required><TextInput type="password" value={regConfirm} onChange={e => setRegConfirm(e.target.value)} className="rounded-xl py-2.5" /></Field>
                {regError && <div className="text-xs text-rose-500 mb-3">{regError}</div>}
                <button type="submit" disabled={regBusy} className="w-full bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] hover:brightness-110 active:scale-[0.98] text-white text-sm font-semibold px-4 py-3 rounded-xl shadow-lg shadow-teal-900/20 transition disabled:opacity-50">{regBusy ? "Submitting\u2026" : "Create Account"}</button>
                <div className="text-center mt-3"><button type="button" onClick={() => setMode("login")} className="text-xs text-teal-700 hover:underline">Already have an account? Log in</button></div>
              </form>
            )
          ) : (
            <form onSubmit={submit}>
              {CLOUD_ENABLED && featureToggles.enableGoogleLogin && (
                <div className="mb-4">
                  <button type="button" disabled={gBusy} onClick={handleGoogleSignIn} className="w-full flex items-center justify-center gap-2.5 bg-white hover:bg-slate-50 active:scale-[0.98] text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl border border-slate-200 shadow-sm transition disabled:opacity-50">
                    <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34 5.5 29.3 3.5 24 3.5 12.7 3.5 3.5 12.7 3.5 24S12.7 44.5 24 44.5 44.5 35.3 44.5 24c0-1.2-.1-2.4-.3-3.5z" /><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.4 18.9 12.5 24 12.5c3.1 0 5.8 1.1 8 3l6-6C34 5.5 29.3 3.5 24 3.5c-7.7 0-14.3 4.4-17.7 10.8z" /><path fill="#4CAF50" d="M24 44.5c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.4-4.5 2.2-7.2 2.2-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.6 39.9 16.2 44.5 24 44.5z" /><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.2-4.1 5.6l6.2 5.2C41 35.6 44.5 30.3 44.5 24c0-1.2-.1-2.4-.9-3.5z" /></svg>
                    {gBusy ? "Signing in\u2026" : "Sign in with Google"}
                  </button>
                  {gError && <div className="text-xs text-rose-500 mt-2">{gError}</div>}
                  <div className="flex items-center gap-3 my-4"><div className="flex-1 h-px bg-slate-200"></div><div className="text-[11px] text-slate-400 font-medium">OR</div><div className="flex-1 h-px bg-slate-200"></div></div>
                </div>
              )}
              <Field label="Username" ur="یوزر نیم" required><TextInput value={username} onChange={e => setUsername(e.target.value)} autoFocus className="rounded-xl py-2.5" /></Field>
              <Field label="Password" ur="پاسورڈ" required><TextInput type="password" value={password} onChange={e => setPassword(e.target.value)} className="rounded-xl py-2.5" /></Field>
              {error && <div className="text-xs text-rose-500 mb-3">{error}</div>}
              <button type="submit" className="w-full bg-[linear-gradient(135deg,#0f766e,#0d9488,#0891b2)] hover:brightness-110 active:scale-[0.98] text-white text-sm font-semibold px-4 py-3 rounded-xl shadow-lg shadow-teal-900/20 transition">Login / لاگ ان</button>
              {(featureToggles.enableForgotPassword || featureToggles.enableSelfRegistration) && (
                <div className="flex items-center justify-center gap-3 mt-3 text-xs">
                  {featureToggles.enableForgotPassword && <button type="button" onClick={() => setMode("forgot")} className="text-teal-700 hover:underline">Forgot password?</button>}
                  {featureToggles.enableForgotPassword && featureToggles.enableSelfRegistration && <span className="text-slate-300">|</span>}
                  {featureToggles.enableSelfRegistration && <button type="button" onClick={() => setMode("register")} className="text-teal-700 hover:underline font-medium">Sign Up / Register</button>}
                </div>
              )}
              {isDefaultAdmin && <div className="text-xs text-slate-400 mt-4 text-center bg-slate-50 rounded-xl px-3 py-2">Default login: <b>admin</b> / <b>admin123</b><br />Please change this password after logging in (Settings &rarr; Manage Users).</div>}

              {CLOUD_ENABLED && (
                <div className="mt-5 pt-4 border-t border-slate-200">
                  <button type="button" onClick={() => setCloudMode(!cloudMode)} className="text-xs text-teal-700 hover:underline">
                    {cloudMode ? "Hide cloud sign-in" : (cloudUser ? "Cloud account: " + cloudUser.email + " (connected)" : "Sign in with Cloud Account (multi-device sync)")}
                  </button>
                  {cloudMode && (
                    <div className="mt-3 space-y-2">
                      {cloudUser ? (
                        <div className="text-xs text-emerald-600">Connected as {cloudUser.email}. Your local role login above still selects your permissions on this device.</div>
                      ) : (
                        <>
                          <TextInput type="email" placeholder="Email" value={cEmail} onChange={e => setCEmail(e.target.value)} className="rounded-xl" />
                          <TextInput type="password" placeholder="Password (min 6 chars)" value={cPass} onChange={e => setCPass(e.target.value)} className="rounded-xl" />
                          {cError && <div className="text-xs text-rose-500">{cError}</div>}
                          <div className="flex gap-2">
                            <button type="button" disabled={cBusy} onClick={submitCloud} className="flex-1 bg-slate-800 hover:bg-slate-900 text-white text-xs font-medium px-3 py-2 rounded-xl disabled:opacity-50">{cIsSignup ? "Create Cloud Account" : "Sign In"}</button>
                          </div>
                          <button type="button" onClick={() => setCIsSignup(!cIsSignup)} className="text-[11px] text-slate-500 hover:underline">{cIsSignup ? "Already have a cloud account? Sign in" : "New here? Create a cloud account"}</button>
                        </>
                      )}
                    </div>
                  )}
                </div>
              )}
            </form>
          )}
        </div>
        <div className="text-center text-white/50 text-[11px] mt-4">Shop ERP &middot; Offline-First, Cloud-Synced</div>
      </div>
    </div>
  );
}

/* ============================ APP ============================ */
function App() {
  /* Captured BEFORE the businesses state below seeds BIZ_LIST_KEY for the first time, so this
     stays true only on the very first render of a truly fresh browser/profile — exactly the
     moment the Welcome & Setup Wizard should appear. Existing installs (BIZ_LIST_KEY already
     present) never see it, even though they also won't have SETUP_WIZARD_KEY set. */
  const [isFreshInstall] = useState(() => !loadJSON(BIZ_LIST_KEY, null));
  const [wizardCompleted, setWizardCompleted] = useState(() => loadJSON(SETUP_WIZARD_KEY, false));
  const [businesses, setBusinesses] = useState(() => {
    const list = loadJSON(BIZ_LIST_KEY, null);
    if (list && list.length) return list;
    const def = [{ id: uid("biz"), name: "Main Mobile Shop", address: "", phone: "", header: "Main Mobile Shop" }];
    saveJSON(BIZ_LIST_KEY, def);
    // First run on this browser — seed a few sample stock items so the shop isn't empty.
    saveJSON(DATA_KEY(def[0].id), normalizeData({ ...emptyBusinessData(), inventory: sampleInventory() }));
    return def;
  });
  const session = loadJSON(SESSION_KEY, {});
  const [currentBizId, setCurrentBizId] = useState(session.bizId && businesses.find(b => b.id === session.bizId) ? session.bizId : businesses[0].id);
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const currentBiz = businesses.find(b => b.id === currentBizId) || businesses[0];
  const [data, setData] = useState(() => normalizeData(loadJSON(DATA_KEY(currentBizId), emptyBusinessData())));

  /* ---- authentication ---- */
  const [users, setUsers] = useState(() => loadUsers());
  const [currentUser, setCurrentUser] = useState(() => {
    const uid_ = loadJSON(USER_SESSION_KEY, null);
    if (!uid_) return null;
    const list = loadJSON(USERS_KEY, []);
    return list.find(u => u.id === uid_) || null;
  });
  const currentUserId = currentUser ? currentUser.id : null;

  /* ---- customizable display: which sidebar tabs / dashboard cards / theme / defaults this
     PERSON has chosen — keyed by their login, not the device or business, so everyone sharing a
     business (and possibly a computer) gets their own personal layout. Resets to the defaults
     whenever nobody is logged in (the pre-login screen always looks the same for everyone). ---- */
  const [uiPrefs, setUiPrefs] = useState(() => loadUiPrefs(currentUserId));
  useEffect(() => { setUiPrefs(loadUiPrefs(currentUserId)); }, [currentUserId]);
  useEffect(() => { if (currentUserId) saveJSON(UI_PREFS_KEY(currentUserId), uiPrefs); }, [uiPrefs, currentUserId]);
  useEffect(() => { applyAccentTheme(uiPrefs.theme); }, [uiPrefs.theme]);

  /* ---- Advanced Customization (Dark Mode / Font Size / widget layout): deliberately NOT part of
     uiPrefs — its own isolated, device-level LocalStorage key (CUSTOM_THEME_KEY), never synced to
     Firebase, never keyed by user login. See the ADVANCED CUSTOMIZATION MODULE comment above. ---- */
  const [customTheme, setCustomTheme] = useState(() => loadJSON(CUSTOM_THEME_KEY, { darkMode: false, fontSize: "medium", layout: null }));
  useEffect(() => { saveJSON(CUSTOM_THEME_KEY, customTheme); applyCustomDarkMode(customTheme.darkMode); applyCustomFontSize(customTheme.fontSize); }, [customTheme]);

  /* Feature Toggles' Hotkeys (see CustomFeatureTogglesSection, Business Settings -> Advanced
     Customization -> Feature Toggles). Reads the isolated toggle fresh on every keypress rather
     than caching it in state, so flipping the switch in Settings takes effect immediately without
     needing an extra effect dependency here. Only navigates real, already-existing tabs / calls
     the browser's own print — no assumptions about buttons or ids that don't exist in this app. */
  useEffect(() => {
    function onKeyDown(e) {
      if (!loadFeatureToggles().enableHotkeys) return;
      if (e.key === "F2") { e.preventDefault(); setActiveTab("sales"); }
      else if (e.key === "F4") { e.preventDefault(); setActiveTab("recovery"); }
      else if (e.key === "F9") { e.preventDefault(); window.print(); }
    }
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, []);

  /* Lands on this person's chosen default tab (falling back to their first visible tab) —
     computed once at mount so a page refresh while already logged in opens straight to it. A
     fresh login (handleLogin, below) sets it explicitly too, since a brand-new session mounts
     with currentUser already null. */
  const [activeTab, setActiveTab] = useState(() => {
    if (!currentUser) return "dashboard";
    const allowed = effectiveTabIds(currentUser).filter(id => id === "settings" || uiPrefs.tabs[id] !== false);
    return (allowed.includes(uiPrefs.defaultTab) ? uiPrefs.defaultTab : allowed[0]) || "dashboard";
  });

  const role = currentUser ? currentUser.role : null;
  /* Per-module CRUD check, bound to whoever is logged in right now. Pass this down to any tab
     as `can={(action) => canDo("moduleId", action)}` so the tab only needs `can("add")` etc. */
  function canDo(moduleId, action) { return can(currentUser, moduleId, action); }
  function handleLogin(u) {
    saveJSON(USER_SESSION_KEY, u.id);
    setCurrentUser(u);
    recordAuditLog("Login", "Signed in", u.name || u.username);
    // Jump straight to this person's chosen landing tab rather than waiting for the uiPrefs
    // effect (above) to catch up on the next render.
    const prefs = loadUiPrefs(u.id);
    const allowed = effectiveTabIds(u).filter(id => id === "settings" || prefs.tabs[id] !== false);
    setActiveTab((allowed.includes(prefs.defaultTab) ? prefs.defaultTab : allowed[0]) || "dashboard");
  }
  function handleSelfResetPassword(userId, newPassword) { setUsers(prev => prev.map(u => u.id === userId ? { ...u, password: newPassword } : u)); }
  function handleLogout() { recordAuditLog("Logout", "Signed out", currentUser && (currentUser.name || currentUser.username)); localStorage.removeItem(USER_SESSION_KEY); setCurrentUser(null); if (CLOUD_ENABLED && cloudUser) cloudSignOut().catch(() => {}); }

  /* ---- "Continue without Password" (Setup Wizard) / Require Login toggle (Settings ->
     Advanced Customization -> Feature Toggles) ----
     Read fresh on every render (same pattern as the hotkeys toggle above) so flipping it in
     Settings takes effect immediately. When it's off, nobody needs to sign in: this effect
     silently signs the shop owner (the Admin account, or the first account if none is marked
     Admin) into the session the moment there's no one logged in, so LoginScreen is skipped
     entirely and the app opens straight to the dashboard. Turning the toggle back on doesn't
     sign anyone out immediately — it just means the *next* time nobody is logged in (e.g. after
     Logout, or on another device/browser), a real username & password will be required again. */
  const authEnabled = loadFeatureToggles().enableAuthentication !== false;
  useEffect(() => {
    if (authEnabled || currentUser || !users.length) return;
    const owner = users.find(u => u.role === "Admin") || users[0];
    handleLogin(owner);
  }, [authEnabled, currentUser, users]);

  useEffect(() => { saveJSON(USERS_KEY, users); if (CLOUD_ENABLED && cloudUser) cloudPushUsers(users); }, [users]);
  useEffect(() => {
    if (!currentUser) return;
    const fresh = users.find(u => u.id === currentUser.id);
    if (!fresh) { handleLogout(); } else if (fresh.role !== currentUser.role || fresh.name !== currentUser.name || JSON.stringify(fresh.permissions) !== JSON.stringify(currentUser.permissions)) { setCurrentUser(fresh); }
  }, [users]);

  useEffect(() => { saveJSON(BIZ_LIST_KEY, businesses); }, [businesses]);
  useEffect(() => { saveJSON(SESSION_KEY, { bizId: currentBizId }); }, [currentBizId]);
  useEffect(() => { setData(normalizeData(loadJSON(DATA_KEY(currentBizId), emptyBusinessData()))); }, [currentBizId]);
  useEffect(() => { saveJSON(DATA_KEY(currentBizId), data); }, [data, currentBizId]);
  useEffect(() => { if (!currentUser) return; const allowed = effectiveTabIds(currentUser).filter(id => id === "settings" || uiPrefs.tabs[id] !== false); if (!allowed.includes(activeTab)) setActiveTab((allowed.includes(uiPrefs.defaultTab) ? uiPrefs.defaultTab : allowed[0]) || "dashboard"); }, [currentUser, uiPrefs]);

  /* ---- online/offline indicator (purely informational — the app works fully offline) ---- */
  const [isOnline, setIsOnline] = useState(navigator.onLine);
  useEffect(() => {
    const on = () => setIsOnline(true), off = () => setIsOnline(false);
    window.addEventListener("online", on); window.addEventListener("offline", off);
    return () => { window.removeEventListener("online", on); window.removeEventListener("offline", off); };
  }, []);

  /* ---- Firebase Auth session (cloud login is optional/additional — local login always works) ---- */
  const [cloudUser, setCloudUser] = useState(null);
  const [cloudReady, setCloudReady] = useState(!CLOUD_ENABLED);
  useEffect(() => {
    if (!CLOUD_ENABLED) return;
    const unsub = fbAuth.onAuthStateChanged((u) => { setCloudUser(u); setCloudReady(true); });
    return () => unsub();
  }, []);
  // Mirrors the active business's `data` blob to/from Firestore in the background. Works while
  // offline (Firestore queues writes locally via the persistence cache enabled above) and catches
  // up automatically the moment the connection returns — no extra code needed for that part.
  const cloudStatus = useCloudSync(currentBizId, data, setData, cloudUser);
  function handleCloudLogout() { if (CLOUD_ENABLED && cloudUser) cloudSignOut().catch(() => {}); }
  function handleSyncNow() { cloudSyncNow(currentBizId, data, cloudUser); }
  /* Pull the shared login roster from the cloud whenever a Firebase Auth session appears (right
     after registering, after Cloud/Google sign-in, or silently on reload if one was already
     persisted) — this is how a newly-approved user's device learns their status changed, and how
     an Admin's device learns about new pending registrations made elsewhere. Firestore access to
     this doc requires being signed in (see FIRESTORE_RULES_REFERENCE), so there's nothing to pull
     until a cloud session exists; local login/roster management keeps working exactly as before
     in the meantime. */
  useEffect(() => {
    if (!CLOUD_ENABLED || !cloudUser) return;
    cloudPullUsers().then(remote => { if (remote) setUsers(prev => mergeUsersFromCloud(prev, remote)); });
  }, [cloudUser]);

  const allowedIds = effectiveTabIds(currentUser);
  const allowedTabs = TABS.filter(t => allowedIds.includes(t.id) && (t.id === "settings" || uiPrefs.tabs[t.id] !== false));
  function renderTab() {
    switch (activeTab) {
      case "dashboard": return <Dashboard data={data} role={role} visible={uiPrefs.dashboard} />;
      case "inventory": return <InventoryTab data={data} setData={setData} role={role} dealers={data.dealers} can={a => canDo("inventory", a)} />;
      case "dealers": return <DealersTab data={data} setData={setData} role={role} can={a => canDo("dealers", a)} />;
      case "purchases": return <PurchasesTab data={data} setData={setData} role={role} can={a => canDo("purchases", a)} />;
      case "settings": return <SettingsTab businesses={businesses} setBusinesses={setBusinesses} currentBiz={currentBiz} setCurrentBizId={setCurrentBizId} users={users} setUsers={setUsers} currentUser={currentUser} cloudUser={cloudUser} onCloudLogout={handleCloudLogout} cloudStatus={cloudStatus} isOnline={isOnline} onSyncNow={handleSyncNow} data={data} setData={setData} uiPrefs={uiPrefs} setUiPrefs={setUiPrefs} customTheme={customTheme} setCustomTheme={setCustomTheme} />;
      case "sales": return <SalesTab data={data} setData={setData} role={role} currentUserName={currentUser.name} biz={currentBiz} can={a => canDo("sales", a)} />;
      case "customers": return <CustomersTab data={data} setData={setData} role={role} biz={currentBiz} currentUserName={currentUser.name} can={a => canDo("customers", a)} />;
      case "recovery": return <RecoveryTab data={data} setData={setData} biz={currentBiz} currentUserName={currentUser.name} can={a => canDo("recovery", a)} />;
      case "accounts": return <AccountsTab data={data} setData={setData} role={role} can={a => canDo("accounts", a)} />;
      case "staff": return <StaffTab data={data} setData={setData} role={role} can={a => canDo("staff", a)} />;
      case "expenses": return <ExpensesTab data={data} setData={setData} can={a => canDo("expenses", a)} />;
      case "partners": return <PartnersTab data={data} setData={setData} can={a => canDo("partners", a)} />;
      case "exportdata": return <ExportTab data={data} currentBiz={currentBiz} setData={setData} />;
      default: return null;
    }
  }

  /* First-run Welcome & Setup Wizard — takes over the entire screen (before the Login screen)
     the very first time the app link is opened on this browser, then never appears again. */
  if (isFreshInstall && !wizardCompleted) {
    return <SetupWizard biz={currentBiz} setBusinesses={setBusinesses} users={users} setUsers={setUsers} onComplete={() => setWizardCompleted(true)} />;
  }

  if (!currentUser) {
    // Authentication is off (skipped in the Setup Wizard, or turned off later in Settings) — the
    // effect above signs the owner in automatically; this only renders for the brief instant
    // before that happens, so the login form itself is never shown.
    if (!authEnabled) return <div className="min-h-screen flex items-center justify-center bg-slate-50 text-slate-400 text-sm">Loading&hellip;</div>;
    return <LoginScreen users={users} setUsers={setUsers} onLogin={handleLogin} onResetPassword={handleSelfResetPassword} biz={currentBiz} cloudUser={cloudUser} cloudReady={cloudReady} />;
  }

  const compact = !!uiPrefs.compactSidebar;
  return (
    <div className={"min-h-screen flex " + (uiPrefs.hideUrdu ? "hide-urdu" : "")}>
      <div className={"fixed md:static z-40 md:z-0 top-0 left-0 h-full bg-slate-900 text-slate-200 flex flex-col transition-all " + (compact ? "w-20" : "w-64") + " " + (sidebarOpen ? "translate-x-0" : "-translate-x-full md:translate-x-0")}>
        <div className={"px-5 py-4 border-b border-slate-700 flex items-center gap-3 " + (compact ? "justify-center px-2" : "")}>
          <div className="w-10 h-10 rounded-full bg-white text-[var(--accent-700)] flex items-center justify-center font-bold text-sm flex-shrink-0 overflow-hidden">
            {currentBiz.logo ? <img src={currentBiz.logo} className="w-full h-full object-cover" /> : initials(currentBiz.header || currentBiz.name)}
          </div>
          {!compact && (
          <div className="min-w-0">
            <div className="font-bold text-white text-lg leading-tight truncate">{currentBiz.header || currentBiz.name}</div>
            <div className="text-xs text-slate-400 urdu">اسٹور مینجمنٹ سسٹم</div>
          </div>
          )}
        </div>
        <nav className="flex-1 overflow-y-auto py-3">
          {allowedTabs.map(t => (
            <button key={t.id} title={compact ? t.en : undefined} onClick={() => { setActiveTab(t.id); setSidebarOpen(false); }} className={"w-full flex items-center gap-3 text-sm hover:bg-slate-800 " + (compact ? "justify-center px-2 py-2.5" : "text-left px-5 py-2.5") + " " + (activeTab === t.id ? "bg-slate-800 border-l-4 border-[var(--accent-500)] text-white" : "text-slate-300")}>
              <span>{t.icon}</span>{!compact && <span>{t.en} <span className="urdu text-slate-500 text-xs block">{t.ur}</span></span>}
            </button>
          ))}
        </nav>
        <div className={"px-5 py-3 border-t border-slate-700 text-xs text-slate-500 " + (compact ? "px-2 text-center" : "")}>
          {!compact && <>Shop ERP v3.0 &middot; Offline-First</>}
          <div className="mt-1"><SyncStatusBadge isOnline={isOnline} cloudStatus={cloudStatus} /></div>
        </div>
      </div>

      <div className="flex-1 flex flex-col min-w-0">
        <header className="bg-white border-b border-slate-200 px-4 py-3 flex flex-wrap items-center gap-3 justify-between">
          <div className="flex items-center gap-3">
            <button className="md:hidden text-slate-600" onClick={() => setSidebarOpen(!sidebarOpen)}>&#9776;</button>
            <div className="w-9 h-9 rounded-full bg-[var(--accent-600)] text-white flex items-center justify-center font-bold text-xs flex-shrink-0 overflow-hidden">
              {currentBiz.logo ? <img src={currentBiz.logo} className="w-full h-full object-cover" /> : initials(currentBiz.header || currentBiz.name)}
            </div>
            <div>
              <div className="text-sm font-semibold text-slate-800">{currentBiz.name}</div>
              <div className="text-xs text-slate-400">{currentBiz.address || "No address set"} {currentBiz.phone ? "\u00b7 " + currentBiz.phone : ""}</div>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <SyncStatusBadge isOnline={isOnline} cloudStatus={cloudStatus} compact />
            <Select value={currentBizId} onChange={e => setCurrentBizId(e.target.value)} options={businesses.map(b => ({ value: b.id, label: b.name }))} className="text-xs !py-1.5" />
            <div className="text-right leading-tight">
              <div className="text-xs font-semibold text-slate-700">{currentUser.name}</div>
              <div className="text-[10px] text-slate-400">{currentUser.role}</div>
            </div>
            <button onClick={handleLogout} className="text-xs px-3 py-1.5 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50">Logout</button>
          </div>
        </header>
        <main className="flex-1 p-4 md:p-6 overflow-y-auto">{renderTab()}</main>
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>

<!-- ============================ PWA: INSTALLABILITY + APP-SHELL OFFLINE CACHE ============================
     Kept as plain (non-Babel) script so it runs immediately, independent of React/Babel loading.
     Because this is a single portable .html file (no separate server), the manifest and service
     worker are generated in-browser as Blob URLs rather than shipped as separate files:
       - manifest: makes the page installable ("Add to Home Screen" / desktop install icon).
       - service worker: caches this page's own HTML on first load so it can be re-opened with
         zero network the next time (the app's data was already 100% local via localStorage/
         Firestore-offline-cache — this last piece caches the *code* itself too).
     For a fully spec-compliant installable PWA on all browsers/stores, host manifest.json and
     sw.js as real files alongside this one instead of via blob: URLs — that removes the couple of
     platform quirks blob-based manifests have (notably: iOS Safari and some Android WebViews
     don't honor a blob: manifest link, though the offline caching below still works there). -->
<script>
(function () {
  try {
    var manifest = {
      name: "Shop ERP - Business Suite",
      short_name: "Shop ERP",
      start_url: "./",
      display: "standalone",
      background_color: "#0f172a",
      theme_color: "#4f46e5",
      icons: [
        { src: "data:image/svg+xml," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="192" height="192"><rect width="192" height="192" rx="28" fill="%234f46e5"/><text x="96" y="128" font-size="110" text-anchor="middle" fill="white" font-family="Arial">$</text></svg>'), sizes: "192x192", type: "image/svg+xml" }
      ]
    };
    var manifestBlob = new Blob([JSON.stringify(manifest)], { type: "application/json" });
    var link = document.createElement("link");
    link.rel = "manifest";
    link.href = URL.createObjectURL(manifestBlob);
    document.head.appendChild(link);
  } catch (e) { console.warn("PWA manifest setup skipped:", e); }

  if ("serviceWorker" in navigator) {
    try {
      var swSource = [
        'const CACHE = "shop-erp-shell-v1";',
        'self.addEventListener("install", (e) => {',
        '  self.skipWaiting();',
        '  e.waitUntil(caches.open(CACHE).then((c) => c.add(self.registration.scope)));',
        '});',
        'self.addEventListener("activate", (e) => { self.clients.claim(); });',
        'self.addEventListener("fetch", (e) => {',
        '  if (e.request.method !== "GET") return;',
        '  e.respondWith(',
        '    fetch(e.request).then((res) => {',
        '      const copy = res.clone();',
        '      caches.open(CACHE).then((c) => c.put(e.request, copy)).catch(() => {});',
        '      return res;',
        '    }).catch(() => caches.match(e.request).then((cached) => cached || caches.match(self.registration.scope)))',
        '  );',
        '});'
      ].join("\n");
      var swBlob = new Blob([swSource], { type: "application/javascript" });
      var swUrl = URL.createObjectURL(swBlob);
      navigator.serviceWorker.register(swUrl).catch((e) => console.warn("Service worker registration skipped:", e.message));
    } catch (e) { console.warn("Service worker setup skipped:", e); }
  }
})();
</script>
</body>
</html>

function CustomThemeLayoutSection({ uiPrefs, setAccentTheme, customTheme, setCustomTheme }) {
  const [layout, setLayout] = useState(() => {
    const saved = loadJSON(CUSTOM_THEME_KEY, {}).layout;
    const seen = new Set(); const ids = new Set(CUSTOM_DEMO_WIDGETS.map(w => w.id));
    const merged = (Array.isArray(saved) ? saved : []).filter(e => ids.has(e.id)).map(e => { seen.add(e.id); return { id: e.id, span: [1,2,3].includes(e.span) ? e.span : 1 }; });
    CUSTOM_DEMO_WIDGETS.forEach(w => { if (!seen.has(w.id)) merged.push({ id: w.id, span: 1 }); });
    return merged;
  });
  function persistLayout(next) { setLayout(next); saveJSON(CUSTOM_THEME_KEY, { ...customTheme, layout: next }); }
  function move(i, dir) { const next = layout.slice(); const t = i + dir; if (t < 0 || t >= next.length) return; const tmp = next[i]; next[i] = next[t]; next[t] = tmp; persistLayout(next); }
  function setSpan(id, span) { persistLayout(layout.map(e => e.id === id ? { ...e, span } : e)); }
  const widgetById = {}; CUSTOM_DEMO_WIDGETS.forEach(w => { widgetById[w.id] = w; });
  const spanClass = { 1: "col-span-4 sm:col-span-1", 2: "col-span-4 sm:col-span-2", 3: "col-span-4" };

  return (
    <div className="space-y-5">
      <ToggleSwitch label="Dark mode (applies app-wide, right now)" ur="ڈارک موڈ" checked={!!customTheme.darkMode} onChange={v => setCustomTheme({ ...customTheme, darkMode: v })} />


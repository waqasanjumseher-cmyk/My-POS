            )}
          </div>
          <div className="flex justify-end gap-2 mt-4">
            <button onClick={() => { setShowForm(false); resetForm(); }} className="px-4 py-2 text-sm rounded-lg border border-slate-300 text-slate-600">Cancel</button>

          <div className="text-sm mb-4">Remaining Payable: <b className={remaining > 0 ? "text-rose-600" : "text-emerald-600"}>{fmtMoney(remaining)}</b></div>
          <div className="border-t border-slate-200 pt-4">
            <div className="flex items-center justify-between mb-2">
              <h4 className="text-sm font-semibold text-slate-700">Add Items to this Bill / اس بل کے آئٹمز</h4>
              <span className="text-xs text-slate-400">Add as many different items as this bill needs — each with its own category, price &amp; quantity.</span>
            </div>
            <div className="bg-slate-50 rounded-lg p-3 mb-3">
              <ItemFormFields item={draftItem} setItem={setDraftItem} dealers={data.dealers} categories={allCategories(data)} presets={data.customItemPresets} isNew />
